<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A guest JIT (FEX) needs a code buffer. Apple Silicon refuses plain
         read-write-execute to any process; MAP_JIT is the only alternative and
         it requires this entitlement. runtime/jit.c drives the per-thread
         write/execute switch from the resulting faults. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
