+        X11Rect head = [_screen head_containing_point:X11RectOrigin(_reparented ? [self construct_frame_from_winrect:r] : r)];
+
+        if (!_reparented) {
+            _xattr.x = head.x;
+            _xattr.y = head.y;
+            _xattr.width = head.width;
+            _xattr.height = head.height;
+            XMoveResizeWindow(x_dpy, _id, _xattr.x, _xattr.y,
+                              _xattr.width, _xattr.height);
+            return;
+        }
+        _needs_configure_notify = YES;
+        if (_frame_id) {
+            [self resize_frame:head];
+            [self fill_head_client:head];
+        } else {
+            _frame_height = head.height;
+        }
+        if (_needs_configure_notify) {
+            [self send_configure];
+            _needs_configure_notify = NO;
+        }
+        return;
+    }
