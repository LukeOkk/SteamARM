 - (void) resize_client:(X11Rect)r {
     X11Rect fr;
 
     TRACE ();
 
+    if (_fullscreen) {
+        /* SteamARM: a fullscreen window keeps its whole head. The client's
+         * own geometry does not shrink it: Counter-Strike 2 (SDL) asks for
+         * the display's 1920x1080, which the title bar's allowance in
+         * validate_window_size cut to 1920x1058, and the Dock then stayed
