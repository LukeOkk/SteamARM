+/* SteamARM: a fullscreen window's client fills its head-sized frame. The
+ * frame can already have the head's size (made again from the old one, or
+ * resized to it before the client asked), and report_frame_size then leaves
+ * the client as it was: 1920x1058 or 1280x720 inside a 1920x1080 frame. */
+- (void) fill_head_client:(X11Rect)head {
+    if (_shaded || !_reparented)
+        return;
+    if (_xattr.width == head.width && _xattr.height == head.height - _frame_title_height)
+        return;
+    _frame_height = head.height;
+    _xattr.width = head.width;
+    _xattr.height = head.height - _frame_title_height;
+    DISABLE_EVENTS(_id, 0);
+    XResizeWindow(x_dpy, _id, _xattr.width, _xattr.height);
+    ENABLE_EVENTS(_id, X_CLIENT_WINDOW_EVENTS);
+    [self send_configure];
+}
