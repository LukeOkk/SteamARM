+/* SteamARM: a Metal timestamp counter heap holds at most 4096 entries on
+ * Apple GPUs ("Requested Heap size is too large (requested 8192 max is
+ * 4096)", M4), and a pool of more queries failed with
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY: vkd3d-proton's query heaps for FINAL FANTASY
+ * VII REMAKE stopped the game at start. A pool now has as many heaps as it
+ * needs, query q in heap q / KK_TS_HEAP_MAX at q % KK_TS_HEAP_MAX. */
+#define KK_TS_HEAP_MAX 4096u
+
 struct kk_ts_state {
-   /* Metal 4 counter heap backing VK_QUERY_TYPE_TIMESTAMP pools. Timestamps are
-    * sampled into this heap and later resolved into `bo` (see kk_query_pool.c).
-    * NULL for non-timestamp pools. */
-   mtl_counter_heap *heap;
+   /* Metal 4 counter heaps backing VK_QUERY_TYPE_TIMESTAMP pools. Timestamps
+    * are sampled into these heaps and later resolved into `bo` (see
+    * kk_query_pool.c). NULL for non-timestamp pools. */
+   mtl_counter_heap **heaps;
+   uint32_t heap_count;
    struct util_dynarray stage_map;
 };
 
