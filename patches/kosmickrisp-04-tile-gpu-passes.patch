+/* SteamARM: honour the application's load and store operations.
+ *
+ * The driver loaded every attachment whose load operation was DONT_CARE and
+ * stored every attachment whatever its store operation. On a tile-based GPU
+ * each of those is a full copy between tile memory and the texture, per
+ * sample: a multisampled depth buffer nobody reads again was written out
+ * after every pass. The store action is now left open in the descriptor
+ * (MTL_STORE_ACTION_UNKNOWN) and chosen when the encoder ends: the
+ * application's, if that is the end of its render pass; STORE if the pass is
+ * only being restarted (a pipeline barrier, a state change, a suspended
+ * pass), and for an attachment the resolve pass that follows still reads.
+ * KK_APP_LOAD_STORE=0 restores the old behaviour.
+ */
+bool
+kk_use_app_load_store(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("KK_APP_LOAD_STORE");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+static enum mtl_store_action
+kk_end_store_action(const struct kk_attachment *att, bool final)
+{
+   /* Not the end of the pass, or the resolve pass still reads it. */
+   if (!final || att->resolve_mode != VK_RESOLVE_MODE_NONE)
+      return MTL_STORE_ACTION_STORE;
+   return att->store_op == VK_ATTACHMENT_STORE_OP_STORE
+             ? MTL_STORE_ACTION_STORE
+             : MTL_STORE_ACTION_DONT_CARE;
+}
+
+void
+kk_cmd_set_store_actions(struct kk_cmd_buffer *cmd)
+{
+   struct kk_rendering_state *render = &cmd->state.gfx.render;
+   mtl_render_encoder *enc = cmd->gfx.encoder;
+   bool final = (cmd->state.gfx.render_ending || cmd->state.gfx.pending_end) &&
+                !(render->flags & VK_RENDERING_SUSPENDING_BIT);
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(render->color_att); i++) {
+      const struct kk_attachment *att = &render->color_att[i];
+      if (!att->iview || render->color_map[i] == MESA_VK_ATTACHMENT_UNUSED)
+         continue;
+      mtl_render_set_color_store_action(enc, render->color_map[i],
+                                        kk_end_store_action(att, final));
+   }
+   if (render->depth_att.iview)
+      mtl_render_set_depth_store_action(
+         enc, kk_end_store_action(&render->depth_att, final));
+   if (render->stencil_att.iview)
+      mtl_render_set_stencil_store_action(
+         enc, kk_end_store_action(&render->stencil_att, final));
+}
+
+/* SteamARM: consecutive render passes on the same attachments share one
+ * Metal encoder.
+ *
+ * Every Metal render pass on a tile-based GPU loads its attachments into
+ * tile memory and stores them back, whole, per sample. A renderer that ends
+ * and begins a pass between groups of draws on the same targets -- free on
+ * an immediate-mode GPU -- pays for that each time: Source 2 issues about
+ * 200 passes a frame, and the GPU was at 99 % for 50 frames a second at
+ * 857x482 (Counter-Strike 2; MEASURED). So the end of a pass leaves its
+ * encoder open (pending_end), and a pass that begins next with the same
+ * attachments continues in it: a load operation of CLEAR becomes the clear
+ * draw the driver already uses for partial clears, and the store operations
+ * are those of the last pass. Compute or copy work, a pass on other
+ * attachments, a resolve, a timestamp, or the end of the command buffer end
+ * the encoder first. KK_MERGE_PASSES=0 turns it off.
+ */
+static bool
+kk_merge_passes(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("KK_MERGE_PASSES");
+      on = kk_use_app_load_store() && !(e && e[0] == '0');
+   }
+   return on;
+}
+
+static bool
+kk_same_attachment(const struct kk_attachment *att,
+                   const VkRenderingAttachmentInfo *info)
+{
+   VkImageView view = info ? info->imageView : VK_NULL_HANDLE;
+   if (view != kk_image_view_to_handle(att->iview))
+      return false;
+   return view == VK_NULL_HANDLE || info->resolveMode == VK_RESOLVE_MODE_NONE;
+}
+
+/* Can the pass `info` begins go on in the encoder of the pass just ended? */
+static bool
+kk_can_continue_render(struct kk_cmd_buffer *cmd, const VkRenderingInfo *info)
+{
+   const struct kk_rendering_state *render = &cmd->state.gfx.render;
+
+   if (!cmd->gfx.encoder || info->flags != 0 || render->flags != 0 ||
+       info->viewMask != render->view_mask ||
+       info->layerCount != render->layer_count ||
+       info->colorAttachmentCount != render->color_att_count ||
+       render->fsr_att.iview ||
+       vk_find_struct_const(info->pNext,
+                            RENDERING_FRAGMENT_SHADING_RATE_ATTACHMENT_INFO_KHR))
+      return false;
+
+   bool any = false;
+   for (uint32_t i = 0; i < info->colorAttachmentCount; i++) {
+      if (!kk_same_attachment(&render->color_att[i], &info->pColorAttachments[i]))
+         return false;
+      /* The pass before used the default attachment locations. */
+      if (render->color_att[i].iview && render->color_map[i] != i)
+         return false;
+      any |= render->color_att[i].iview != NULL;
+   }
+   if (!kk_same_attachment(&render->depth_att, info->pDepthAttachment) ||
+       !kk_same_attachment(&render->stencil_att, info->pStencilAttachment))
+      return false;
+   any |= render->depth_att.iview || render->stencil_att.iview;
+
+   return any;
+}
+
+/* The encoder of the application's render pass has ended. */
+void
+kk_cmd_render_ended(struct kk_cmd_buffer *cmd)
+{
+   mtl_release(cmd->state.gfx.render_pass_descriptor);
+   cmd->state.gfx.render_pass_descriptor = NULL;
+   cmd->state.gfx.pending_end = false;
+   memset(&cmd->state.gfx.render, 0, sizeof(cmd->state.gfx.render));
+}
