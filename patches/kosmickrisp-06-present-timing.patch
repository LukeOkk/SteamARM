+mtl_drawable_present_seq(void *drawable, uint32_t seq, int log)
+{
+   @autoreleasepool {
+      id<MTLDrawable> d = (id<MTLDrawable>)drawable;
+      if (log)
+         [d addPresentedHandler:^(id<MTLDrawable> shown) {
+            fprintf(stderr, "[kk] present %u: on the display at %.4f\n", seq,
+                    shown.presentedTime);
+         }];
+      [d present];
+   }
+}
+
+void
+mtl_command_queue_wait_for_drawable(mtl_command_queue *queue, void *drawable)
+{
+   @autoreleasepool {
+      id<MTL4CommandQueue> q = (id<MTL4CommandQueue>)queue;
+      id<MTLDrawable> d = (id<MTLDrawable>)drawable;
+      [q waitForDrawable:d];
+   }
+}
+
+void
 mtl_drawable_present(void *drawable)
 {
