+/* Main-thread display/window snapshots only. The DIX thread copies plain
+ * integers under a separate lock; it never calls AppKit or waits on main.
+ * _STEAMARM_VRR: version, CAContext, min/max interval (us), native fullscreen.
+ * A capability/request is not proof of the physical monitor's scanout mode. */
+static pthread_mutex_t refresh_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { uint32_t xid, v[5]; XQRemoteLayerState applied; } refresh_slots[64];
+
+int
+XQRemoteLayerRefreshInfo(const XQRemoteLayerState *state, uint32_t out[5])
+{
+    int found = 0;
+    pthread_mutex_lock(&refresh_lock);
+    for (unsigned i = 0; i < 64; i++)
+        if (refresh_slots[i].xid == state->xid && !memcmp(&refresh_slots[i].applied, state, sizeof(*state))) {
+            memcpy(out, refresh_slots[i].v, sizeof(refresh_slots[i].v));
+            found = 1;
+            break;
+        }
+    pthread_mutex_unlock(&refresh_lock);
+    return found;
+}
+
+static void
+rl_refresh_store(uint32_t xid, XQRemoteLayerWindow *w)
+{
+    uint32_t v[5] = {1, w ? w.host.contextId : 0, 0, 0, 0};
+    NSScreen *sc = w.screen;
+    if (w && w.isVisible && w.wanted && !w.mcHidden && !w.covered && sc) {
+        double lo = sc.minimumRefreshInterval, hi = sc.maximumRefreshInterval;
+        if (isfinite(lo) && isfinite(hi) && lo > 0 && hi >= lo && hi <= 1.0) {
+            v[2] = (uint32_t)llround(lo * 1000000.0);
+            v[3] = (uint32_t)llround(hi * 1000000.0);
+            /* Do not infer native fullscreen from a borderless rectangle.
+             * The current rootless overlay has a one-column outset to avoid
+             * WindowServer suppressing its remote layer. Keep that path. */
+            v[4] = (w.styleMask & NSWindowStyleMaskFullScreen) != 0;
+        }
+    }
+    pthread_mutex_lock(&refresh_lock);
+    unsigned slot = 64, empty = 64;
+    for (unsigned i = 0; i < 64; i++) {
+        if (refresh_slots[i].xid == xid) { slot = i; break; }
+        if (!refresh_slots[i].xid && empty == 64) empty = i;
+    }
+    if (slot == 64 && w) slot = empty;
+    if (slot < 64) {
+        refresh_slots[slot].xid = w ? xid : 0;
+        memcpy(refresh_slots[slot].v, v, sizeof(v));
+        if (w) refresh_slots[slot].applied = w.refreshState;
+        refresh_slots[slot].applied.reorder = 0;
+    }
+    pthread_mutex_unlock(&refresh_lock);
+}
+
+static void
+rl_refresh_all(void)
+{
+    for (NSNumber *key in overlays)
+        rl_refresh_store(key.unsignedIntValue, overlays[key]);
+}
 
