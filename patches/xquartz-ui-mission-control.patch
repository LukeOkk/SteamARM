+/* The part of w inside every ancestor up to (and including) the toplevel,
+ * in screen coordinates: a child window only shows inside its parents.
+ * False when nothing of it is. */
+static Bool
+rl_clip(WindowPtr w, int *x1, int *y1, int *x2, int *y2)
+{
+    WindowPtr p;
+
+    *x1 = w->drawable.x;
+    *y1 = w->drawable.y;
+    *x2 = *x1 + w->drawable.width;
+    *y2 = *y1 + w->drawable.height;
+    for (p = w->parent; p && p->parent; p = p->parent) {
+        int px1 = p->drawable.x, py1 = p->drawable.y;
+        int px2 = px1 + p->drawable.width, py2 = py1 + p->drawable.height;
+        if (*x1 < px1) *x1 = px1;
+        if (*y1 < py1) *y1 = py1;
+        if (*x2 > px2) *x2 = px2;
+        if (*y2 > py2) *y2 = py2;
+    }
+    return *x2 > *x1 && *y2 > *y1;
+}
