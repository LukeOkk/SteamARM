+/* Mission Control lays the overlays out as windows of their own, with the
+ * game's picture, but leaves the Xplugin frames where they are: the window
+ * server does not give them to it. Under a layer a frame's pixels are the X
+ * window's background, so a white window stood in the middle of Mission
+ * Control, and a window whose whole area is a descendant's layer
+ * (st->covered) was an empty one beside the picture (the user's
+ * screenshots, 2026-10-04). While Mission Control is open -- WindowManager's
+ * shield window, at the utility level and a display's size, is on screen --
+ * the frames under layers are made transparent and covered overlays ordered
+ * out (a transparent one still had its place in Mission Control).
+ * Ordering the overlay into its frame's window-server group, or making it
+ * transient, did not change how Mission Control showed them (MEASURED with
+ * the user). XQUARTZ_RL_MISSION_CONTROL=0: as before. */
+typedef int (*rl_cid_f)(void);
+typedef int (*rl_alpha_f)(int, uint32_t, float);
+static BOOL rl_mc_open;
+static NSMutableSet<NSNumber *> *rl_mc_frames;   /* made transparent */
+
+static void
+rl_frame_alpha(uint32_t frame, float alpha)
+{
+    static rl_cid_f cid;
+    static rl_alpha_f set_alpha;
+    static BOOL looked;
+    static unsigned told;
+    if (!looked) {
+        void *h = dlopen("/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight", RTLD_NOW);
+        cid = h ? (rl_cid_f)dlsym(h, "SLSMainConnectionID") : NULL;
+        set_alpha = h ? (rl_alpha_f)dlsym(h, "SLSSetWindowAlpha") : NULL;
+        looked = YES;
+    }
+    if (!cid || !set_alpha)
+        return;
+    int r = set_alpha(cid(), frame, alpha);
+    if (r && told++ < 10)
+        ErrorF("remote layer: frame %u alpha %.0f failed (%d)\n", frame, alpha, r);
+}
+
+static void
+rl_mc_hide(XQRemoteLayerWindow *w)
+{
+    if (!rl_mc_open || !w.isVisible || !w.nativeBelow)
+        return;
+    if (w.covered) {
+        [w orderOut:nil];
+        w.mcHidden = YES;
+        return;
+    }
+    NSNumber *f = @(w.nativeBelow);
+    if (![rl_mc_frames containsObject:f]) {
+        rl_frame_alpha(w.nativeBelow, 0.0f);
+        [rl_mc_frames addObject:f];
+    }
+}
+
+/* A frame no visible overlay is over any more gets its picture back at
+ * once (a layer removed with Mission Control open: the X window stays). */
+static void
+rl_mc_release_unused(void)
+{
+    for (NSNumber *f in rl_mc_frames.allObjects) {
+        BOOL used = NO;
+        for (XQRemoteLayerWindow *w in overlays.allValues)
+            if (w.isVisible && w.nativeBelow == f.unsignedIntValue)
+                used = YES;
+        if (!used) {
+            rl_frame_alpha(f.unsignedIntValue, 1.0f);
+            [rl_mc_frames removeObject:f];
+        }
+    }
+}
+
+/* The window list with descriptions costs about 1 ms; the ids alone, a
+ * sixth of that: the descriptions are read only when the windows on screen
+ * have changed. */
+static BOOL
+rl_mc_shield_up(void)
+{
+    static uint64_t last_ids;
+    static BOOL last_up;
+    const CGWindowListOption on_screen = kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements;
+    CFArrayRef ids = CGWindowListCreate(on_screen, kCGNullWindowID);
+    if (!ids)
+        return NO;
+    uint64_t h = 1469598103934665603ull;
+    for (CFIndex i = 0; i < CFArrayGetCount(ids); i++) {
+        h ^= (uint64_t)(uintptr_t)(const void *)CFArrayGetValueAtIndex(ids, i);
+        h *= 1099511628211ull;
+    }
+    CFRelease(ids);
+    if (h == last_ids)
+        return last_up;
+    last_ids = h;
+
+    BOOL up = NO;
+    CFArrayRef list = CGWindowListCopyWindowInfo(on_screen, kCGNullWindowID);
+    if (!list) {
+        last_ids = 0;       /* asked again at the next check */
+        return last_up = NO;
+    }
+    for (NSDictionary *d in (NSArray *)list) {
+        if ([d[(id)kCGWindowLayer] intValue] != CGWindowLevelForKey(kCGUtilityWindowLevelKey) ||
+            ![d[(id)kCGWindowOwnerName] isEqual:@"WindowManager"])
+            continue;
+        CGRect b;
+        if (!CGRectMakeWithDictionaryRepresentation((CFDictionaryRef)d[(id)kCGWindowBounds], &b))
+            continue;
+        for (NSScreen *sc in NSScreen.screens)
+            if (CGSizeEqualToSize(b.size, sc.frame.size))
+                up = YES;
+    }
+    CFRelease(list);
+    return last_up = up;
+}
+
+/* A covered overlay ordered out for Mission Control goes back once its
+ * frame is on screen: closed on another Space, it would otherwise be
+ * ordered in there, away from its frame (and, covering a display, take the
+ * pointer there). Covered, it shows nothing in the meantime. */
+static void
+rl_mc_restore_hidden(void)
+{
+    for (XQRemoteLayerWindow *w in overlays.allValues) {
+        if (!w.mcHidden)
+            continue;
+        if (!w.wanted || !w.nativeBelow) {
+            w.mcHidden = NO;
+            continue;
+        }
+        CFArrayRef frame = CGWindowListCreate(kCGWindowListOptionOnScreenOnly | kCGWindowListOptionIncludingWindow,
+                                              (CGWindowID)w.nativeBelow);
+        BOOL shown = frame && CFArrayGetCount(frame) > 0;
+        if (frame)
+            CFRelease(frame);
+        if (!shown)
+            continue;
+        w.mcHidden = NO;
+        [w orderWindow:NSWindowAbove relativeTo:w.nativeBelow];
+    }
+}
+
+/* Every 100 ms, while an overlay is on screen. */
+static void
+rl_mc_check(void)
+{
+    static int on = -1;
+    if (on < 0)
+        on = getenv("XQUARTZ_RL_MISSION_CONTROL") == NULL || getenv("XQUARTZ_RL_MISSION_CONTROL")[0] != '0';
+    if (!on)
+        return;
+    BOOL any = NO;
+    for (XQRemoteLayerWindow *w in overlays.allValues)
+        if (w.isVisible)
+            any = YES;
+    BOOL open = any && rl_mc_shield_up();
+    if (!open)
+        rl_mc_restore_hidden();
+    if (open == rl_mc_open)
+        return;
+    rl_mc_open = open;
+    if (!rl_mc_frames)
+        rl_mc_frames = [[NSMutableSet alloc] init];
+    ErrorF("remote layer: Mission Control %s\n", open ? "open: frames under layers made transparent" : "closed");
+    if (open) {
+        for (XQRemoteLayerWindow *w in overlays.allValues)
+            rl_mc_hide(w);
+        return;
+    }
+    for (NSNumber *f in rl_mc_frames)
+        rl_frame_alpha(f.unsignedIntValue, 1.0f);
+    [rl_mc_frames removeAllObjects];
+}
