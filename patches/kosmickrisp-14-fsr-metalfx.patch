@@ -0,0 +1,124 @@
+/*
+ * Copyright 2026 SteamARM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* SteamARM: a game's FSR 1 upscale done by MetalFX.
+ *
+ * FSR 1 enlarges a game's 3D picture in two passes: EASU, the upscale, and
+ * RCAS, a sharpening of its result. When the game draws with an EASU
+ * fragment shader (found at compile time by the two constants of its
+ * approximations, 0x7ef07ebb and 0x5f347d74), the draw is replaced by
+ * MetalFX's spatial scaler from the shader's input texture into the pass's
+ * colour attachment, in the same Metal command buffer (kk_cmd_draw.c,
+ * kk_fsr_metalfx_draw). RCAS still runs on MetalFX's result. The HUD the
+ * game draws afterwards stays at the display's resolution, as with FSR.
+ *
+ * Counter-Strike 2 ("FidelityFX Super Resolution" in its video settings):
+ * EASU samples set 1 binding 30 with the sampler at binding 14 and its
+ * constants at binding 1. The input is found by the resource id in the
+ * descriptor: image views register theirs here. */
+
+#include "kk_fsr_metalfx.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_descriptor_set.h"
+#include "kk_descriptor_set_layout.h"
+#include "kk_descriptor_types.h"
+
+#include "nir.h"
+#include "util/hash_table.h"
+#include "util/simple_mtx.h"
+
+#include <stdlib.h>
+
+#define FSR_EASU_BINDING 30
+
+bool
+kk_fsr_metalfx_enabled(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("KK_FSR_METALFX");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+bool
+kk_nir_is_fsr_easu(nir_shader *nir)
+{
+   bool a = false, b = false;
+
+   if (nir->info.stage != MESA_SHADER_FRAGMENT || !kk_fsr_metalfx_enabled())
+      return false;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_load_const)
+               continue;
+            nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+            if (lc->def.bit_size != 32)
+               continue;
+            for (unsigned c = 0; c < lc->def.num_components; c++) {
+               a |= lc->value[c].u32 == 0x7ef07ebb;
+               b |= lc->value[c].u32 == 0x5f347d74;
+            }
+         }
+      }
+   }
+   return a && b;
+}
+
+static simple_mtx_t textures_lock = SIMPLE_MTX_INITIALIZER;
+static struct hash_table_u64 *textures;
+
+void
+kk_fsr_register_texture(uint64_t gpu_resource_id, mtl_texture *texture)
+{
+   if (!gpu_resource_id || !kk_fsr_metalfx_enabled())
+      return;
+   simple_mtx_lock(&textures_lock);
+   if (!textures)
+      textures = _mesa_hash_table_u64_create(NULL);
+   _mesa_hash_table_u64_insert(textures, gpu_resource_id, texture);
+   simple_mtx_unlock(&textures_lock);
+}
+
+void
+kk_fsr_unregister_texture(uint64_t gpu_resource_id)
+{
+   if (!gpu_resource_id || !kk_fsr_metalfx_enabled())
+      return;
+   simple_mtx_lock(&textures_lock);
+   if (textures)
+      _mesa_hash_table_u64_remove(textures, gpu_resource_id);
+   simple_mtx_unlock(&textures_lock);
+}
+
+mtl_texture *
+kk_fsr_easu_input(struct kk_cmd_buffer *cmd)
+{
+   struct kk_descriptor_set *set = cmd->state.gfx.descriptors.sets[1];
+   if (!set || !set->layout ||
+       set->layout->binding_count <= FSR_EASU_BINDING)
+      return NULL;
+
+   const struct kk_descriptor_set_binding_layout *bl =
+      &set->layout->binding[FSR_EASU_BINDING];
+   if ((bl->type != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE &&
+        bl->type != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER) ||
+       bl->offset + sizeof(struct kk_sampled_image_descriptor) > set->size)
+      return NULL;
+
+   const struct kk_sampled_image_descriptor *desc =
+      (const void *)((const char *)set->mapped_ptr + bl->offset);
+   mtl_texture *texture = NULL;
+   simple_mtx_lock(&textures_lock);
+   if (textures)
+      texture = _mesa_hash_table_u64_search(textures,
+                                            desc->image_gpu_resource_id);
+   simple_mtx_unlock(&textures_lock);
+   return texture;
+}
