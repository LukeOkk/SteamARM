+ * SPDX-License-Identifier: MIT
+ */
+
+/* SteamARM: a game's FSR 1 upscale done by MetalFX.
+ *
+ * FSR 1 enlarges a game's 3D picture in two passes: EASU, the upscale, and
+ * RCAS, a sharpening of its result. When the game draws with an EASU
+ * fragment shader (found at compile time by the two constants of its
+ * approximations, 0x7ef07ebb and 0x5f347d74), the draw is replaced by
+ * MetalFX's spatial scaler from the shader's input texture into the pass's
+ * colour attachment, in the same Metal command buffer (kk_cmd_draw.c,
+ * kk_fsr_metalfx_draw). RCAS still runs on MetalFX's result. The HUD the
+ * game draws afterwards stays at the display's resolution, as with FSR.
+ *
+ * Counter-Strike 2 ("FidelityFX Super Resolution" in its video settings):
+ * EASU samples set 1 binding 30 with the sampler at binding 14 and its
+ * constants at binding 1. The input is found by the resource id in the
+ * descriptor: image views register theirs here. The input is a texture of
+ * the display's size with the picture in its top left (960x540 of
+ * 1920x1080 at 50 %): how much of it is read from EASU's constants (con0,
+ * the input's viewport over the output's size), in memory registered here
+ * by GPU address; MetalFX given the whole texture showed the picture small
+ * in a corner and garbage around it (MEASURED). */
+
+#include "kk_fsr_metalfx.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_descriptor_set.h"
+#include "kk_descriptor_set_layout.h"
+#include "kk_descriptor_types.h"
+
+#include "nir.h"
+#include "util/hash_table.h"
+#include "util/simple_mtx.h"
+#include "util/u_dynarray.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FSR_EASU_BINDING 30
+
+bool
+kk_fsr_metalfx_enabled(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("KK_FSR_METALFX");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+bool
+kk_nir_is_fsr_easu(nir_shader *nir)
+{
+   bool a = false, b = false;
+
+   /* The shader's own property, whatever KK_FSR_METALFX says: it is kept
+    * in pipeline caches whose key does not know the switch. */
+   if (nir->info.stage != MESA_SHADER_FRAGMENT)
+      return false;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_load_const)
+               continue;
+            nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+            if (lc->def.bit_size != 32)
+               continue;
+            for (unsigned c = 0; c < lc->def.num_components; c++) {
+               a |= lc->value[c].u32 == 0x7ef07ebb;
+               b |= lc->value[c].u32 == 0x5f347d74;
+            }
+         }
+      }
+   }
+   return a && b;
+}
+
+static simple_mtx_t textures_lock = SIMPLE_MTX_INITIALIZER;
+static struct hash_table_u64 *textures;
+
+void
+kk_fsr_register_texture(uint64_t gpu_resource_id, mtl_texture *texture)
+{
+   if (!gpu_resource_id || !kk_fsr_metalfx_enabled())
+      return;
+   simple_mtx_lock(&textures_lock);
+   if (!textures)
+      textures = _mesa_hash_table_u64_create(NULL);
+   _mesa_hash_table_u64_insert(textures, gpu_resource_id, texture);
+   simple_mtx_unlock(&textures_lock);
+}
+
+void
+kk_fsr_unregister_texture(uint64_t gpu_resource_id)
+{
+   if (!gpu_resource_id || !kk_fsr_metalfx_enabled())
+      return;
+   simple_mtx_lock(&textures_lock);
+   if (textures)
+      _mesa_hash_table_u64_remove(textures, gpu_resource_id);
+   simple_mtx_unlock(&textures_lock);
+}
+
+mtl_texture *
+kk_fsr_easu_input(struct kk_cmd_buffer *cmd)
+{
+   struct kk_descriptor_set *set = cmd->state.gfx.descriptors.sets[1];
+   if (!set || !set->layout ||
+       set->layout->binding_count <= FSR_EASU_BINDING)
+      return NULL;
+
+   const struct kk_descriptor_set_binding_layout *bl =
+      &set->layout->binding[FSR_EASU_BINDING];
+   if ((bl->type != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE &&
+        bl->type != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER) ||
+       bl->offset + sizeof(struct kk_sampled_image_descriptor) > set->size)
+      return NULL;
+
+   const struct kk_sampled_image_descriptor *desc =
+      (const void *)((const char *)set->mapped_ptr + bl->offset);
+   mtl_texture *texture = NULL;
+   simple_mtx_lock(&textures_lock);
+   if (textures)
+      texture = _mesa_hash_table_u64_search(textures,
+                                            desc->image_gpu_resource_id);
+   simple_mtx_unlock(&textures_lock);
+   return texture;
+}
+
+struct fsr_memory {
+   uint64_t gpu, size;
+   const void *cpu;
+};
+
+static simple_mtx_t memory_lock = SIMPLE_MTX_INITIALIZER;
+static struct util_dynarray memory;
+
+void
+kk_fsr_register_memory(uint64_t gpu, uint64_t size, void *cpu)
+{
+   if (!gpu || !cpu || !kk_fsr_metalfx_enabled())
+      return;
+   struct fsr_memory m = { gpu, size, cpu };
+   simple_mtx_lock(&memory_lock);
+   util_dynarray_append(&memory, m);
+   simple_mtx_unlock(&memory_lock);
+}
+
+void
+kk_fsr_unregister_memory(uint64_t gpu)
+{
+   if (!gpu || !kk_fsr_metalfx_enabled())
+      return;
+   simple_mtx_lock(&memory_lock);
+   util_dynarray_foreach(&memory, struct fsr_memory, m) {
+      if (m->gpu == gpu) {
+         *m = util_dynarray_pop(&memory, struct fsr_memory);
+         break;
+      }
+   }
+   simple_mtx_unlock(&memory_lock);
+}
+
+static bool
+fsr_read(uint64_t addr, void *dst, size_t len)
+{
+   bool found = false;
+   simple_mtx_lock(&memory_lock);
+   util_dynarray_foreach(&memory, struct fsr_memory, m) {
+      if (addr >= m->gpu && addr + len <= m->gpu + m->size) {
+         memcpy(dst, (const char *)m->cpu + (addr - m->gpu), len);
+         found = true;
+         break;
+      }
+   }
+   simple_mtx_unlock(&memory_lock);
+   return found;
+}
+
+#define FSR_EASU_CONSTANTS_BINDING 1
+
+bool
+kk_fsr_easu_content(struct kk_cmd_buffer *cmd, uint32_t out_w, uint32_t out_h,
+                    uint32_t *in_w, uint32_t *in_h)
+{
+   struct kk_descriptor_state *desc = &cmd->state.gfx.descriptors;
+   struct kk_descriptor_set *set = desc->sets[1];
+   if (!set || !set->layout ||
+       set->layout->binding_count <= FSR_EASU_CONSTANTS_BINDING)
+      return false;
+
+   const struct kk_descriptor_set_binding_layout *bl =
+      &set->layout->binding[FSR_EASU_CONSTANTS_BINDING];
+   struct kk_buffer_address ubo;
+   if (bl->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER) {
+      if (bl->offset + sizeof(ubo) > set->size)
+         return false;
+      memcpy(&ubo, (const char *)set->mapped_ptr + bl->offset, sizeof(ubo));
+   } else if (bl->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC) {
+      uint32_t i = desc->root.set_dynamic_buffer_start[1] +
+                   bl->dynamic_buffer_index;
+      if (i >= KK_MAX_DYNAMIC_BUFFERS)
+         return false;
+      ubo = desc->root.dynamic_buffers[i];
+   } else {
+      return false;
+   }
+
+   uint32_t con0[4];
+   if (ubo.size < sizeof(con0) || !fsr_read(ubo.base_addr, con0, sizeof(con0)))
+      return false;
+   float rx, ry;
+   memcpy(&rx, &con0[0], sizeof(rx));
+   memcpy(&ry, &con0[1], sizeof(ry));
+   /* FSR 1 goes up to 2x a side (its Performance mode); a little more is
+    * allowed, nothing above 1. */
+   if (!(rx >= 0.3f && rx <= 1.0001f && ry >= 0.3f && ry <= 1.0001f))
+      return false;
+   *in_w = (uint32_t)lroundf(rx * out_w);
+   *in_h = (uint32_t)lroundf(ry * out_h);
+
+   static uint32_t told_w, told_h;
+   if (*in_w != told_w || *in_h != told_h) {
+      fprintf(stderr, "kk: FSR by MetalFX: picture %ux%u -> %ux%u\n", *in_w,
+              *in_h, out_w, out_h);
+      told_w = *in_w;
+      told_h = *in_h;
+   }
+   return true;
+}
