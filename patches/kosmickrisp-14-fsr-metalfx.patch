+static void kk_force_attachment_load(struct kk_cmd_buffer *cmd);
+
+/* SteamARM: an FSR 1 upscale (EASU) draw done by MetalFX instead
+ * (kk_fsr_metalfx.c). The pass's encoder, begun with the pass, is ended
+ * (its clears and stores happen first), MetalFX goes into the same Metal
+ * command buffer, and what the pass draws afterwards restarts it with its
+ * attachments loaded. False: the game's draw is made. */
+static bool
+kk_fsr_metalfx_draw(struct kk_cmd_buffer *cmd)
+{
+   struct kk_shader *fs = cmd->state.shaders[MESA_SHADER_FRAGMENT];
+   struct kk_rendering_state *render = &cmd->state.gfx.render;
+
+   if (!fs || !fs->info.fsr_easu || !kk_fsr_metalfx_enabled() ||
+       render->color_att_count < 1 || !render->color_att[0].iview ||
+       render->view_mask || render->layer_count > 1 ||
+       cmd->state.cond_render.enabled)
+      return false;
+
+   /* MetalFX writes the whole output texture: only a pass drawing to all of
+    * level 0 of a plain image, from its origin, is replaced. */
+   const struct kk_image_view *oiv = render->color_att[0].iview;
+   const struct vk_image_view *ov = &oiv->vk;
+   const struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+   if (ov->base_mip_level || ov->base_array_layer ||
+       render->area.offset.x || render->area.offset.y ||
+       render->area.extent.width != ov->extent.width ||
+       render->area.extent.height != ov->extent.height ||
+       dyn->vp.viewport_count < 1 || dyn->vp.viewports[0].x != 0.0f ||
+       dyn->vp.viewports[0].y != 0.0f ||
+       dyn->vp.viewports[0].width != (float)ov->extent.width ||
+       dyn->vp.viewports[0].height != (float)ov->extent.height)
+      return false;
+
+   mtl_texture *in = kk_fsr_easu_input(cmd);
+   mtl_texture *out = oiv->planes[0].mtl_handle_render;
+   uint32_t in_w, in_h;
+   if (!in || !out ||
+       !kk_fsr_easu_content(cmd, ov->extent.width, ov->extent.height, &in_w,
+                            &in_h))
+      return false;
+
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   /* Asked before the pass is split: a combination MetalFX cannot take is
+    * the game's own draw, without ending its encoder. */
+   if (!mtl_metalfx_spatial_usable(dev->mtl_handle, dev->mtl_compiler_handle,
+                                   in, out, in_w, in_h))
+      return false;
+   /* Twice: compute work open beside the pass is closed as well. */
+   cs_end(cmd);
+   cs_end(cmd);
+   cmd->state.gfx.need_to_start_render_pass = true;
+   kk_force_attachment_load(cmd);
+   kk_cmd_buffer_dirty_all_gfx(cmd);
+
+   mtl_command_buffer *cmd_buf = kk_cmd_buffer_take_gfx_mtl(cmd);
+   bool done = mtl_metalfx_spatial_encode(dev->mtl_handle,
+                                          dev->mtl_compiler_handle, cmd_buf,
+                                          in, out, in_w, in_h);
+   kk_cmd_buffer_return_gfx_mtl(cmd, cmd_buf);
+   if (done) {
+      /* The pass goes on in a new encoder that waits for MetalFX (a queue
+       * barrier, after_metalfx) and ends with the producer barrier every
+       * encoder ends with: later work, in this command buffer or a later
+       * one (the WSI's copy to the drawable), waits for MetalFX's writes. */
+      cmd->after_metalfx = true;
+      cs_get_render(cmd);
+   }
+   return done;
+}
+
 static void
 kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
 {
+   if (kk_fsr_metalfx_draw(cmd))
+      return;
+
    kk_flush_gfx_state(cmd);
 
    data->restart = cmd->vk.dynamic_graphics_state.ia.primitive_restart_enable;
