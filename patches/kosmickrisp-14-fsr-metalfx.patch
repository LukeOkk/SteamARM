+/* Left open, as kk_stop_encoder leaves it, for the next render pass. */
+void
+kk_cmd_buffer_return_gfx_mtl(struct kk_cmd_buffer *cmd,
+                             mtl_command_buffer *cmd_buf)
+{
+   if (!kk_cmd_buf_per_pass() && !cmd->open_gfx_cmd_buf) {
+      cmd->open_gfx_cmd_buf = cmd_buf;
+      cmd->open_gfx_allocator = cmd->gfx.allocator;
+      cmd->gfx.allocator = NULL;
+      return;
+   }
+   mtl_end_command_buffer(cmd_buf);
+   util_dynarray_append(&cmd->ended_allocators, cmd->gfx.allocator);
+   cmd->gfx.allocator = NULL;
+   util_dynarray_append(&cmd->submit_cmd_bufs, cmd_buf);
+}
