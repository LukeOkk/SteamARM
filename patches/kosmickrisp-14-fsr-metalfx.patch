+ */
+
+#ifndef MTL_METALFX_H
+#define MTL_METALFX_H 1
+
+#include "mtl_types.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* SteamARM: MetalFX's spatial upscale of `in` (its content: the top left
+ * in_w x in_h, or the whole texture for 0) into the whole of `out`, encoded
+ * into `cmd_buf` (a Metal 4 command buffer with no encoder open). False when
+ * MetalFX cannot do it (formats, texture usage, no Metal 4 MetalFX): the
+ * caller draws the game's own pass instead. */
+/* Whether mtl_metalfx_spatial_encode would take this pair (it makes and
+ * keeps the scaler): asked before the caller splits its render pass. */
+bool mtl_metalfx_spatial_usable(mtl_device *device, mtl_compiler *compiler,
+                                mtl_texture *in, mtl_texture *out,
+                                uint32_t in_w, uint32_t in_h);
+
+bool mtl_metalfx_spatial_encode(mtl_device *device, mtl_compiler *compiler,
+                                mtl_command_buffer *cmd_buf, mtl_texture *in,
+                                mtl_texture *out, uint32_t in_w, uint32_t in_h);
+
+#endif /* MTL_METALFX_H */
diff -ruN -x *.orig -x *.rej -x __pycache__ a/src/kosmickrisp/bridge/mtl_metalfx.m b/src/kosmickrisp/bridge/mtl_metalfx.m
--- a/src/kosmickrisp/bridge/mtl_metalfx.m	1969-12-31 21:00:00
+++ b/src/kosmickrisp/bridge/mtl_metalfx.m	2026-10-03 13:08:23
@@ -0,0 +1,154 @@
+/*
+ * Copyright 2026 SteamARM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_metalfx.h"
+
+#include <Metal/Metal.h>
+#include <MetalFX/MetalFX.h>
+
+#include <pthread.h>
+#include <stdio.h>
+
+/* A game's FSR pass runs at one size or two (the menu and the match, a
+ * resolution changed): a few scalers kept, the oldest made again. */
+#define MFX_SCALERS 4
+
+struct mfx_scaler {
+   MTLPixelFormat in_format, out_format;
+   NSUInteger in_w, in_h, out_w, out_h;
+   id<MTL4FXSpatialScaler> scaler;   /* nil: MetalFX refused this one */
+   bool used;
+};
+
+static struct mfx_scaler scalers[MFX_SCALERS];
+static unsigned scaler_next;
+static pthread_mutex_t scaler_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static id<MTL4FXSpatialScaler>
+mfx_scaler_get(id<MTLDevice> dev, id<MTL4Compiler> compiler, id<MTLTexture> in,
+               id<MTLTexture> out)
+{
+   /* A refusal is remembered too: asked again it compiled and logged on
+    * every frame. */
+   for (unsigned i = 0; i < MFX_SCALERS; i++) {
+      struct mfx_scaler *s = &scalers[i];
+      if (s->used && s->in_format == in.pixelFormat &&
+          s->out_format == out.pixelFormat && s->in_w == in.width &&
+          s->in_h == in.height && s->out_w == out.width &&
+          s->out_h == out.height)
+         return s->scaler;
+   }
+
+   MTLFXSpatialScalerDescriptor *desc = [MTLFXSpatialScalerDescriptor new];
+   desc.inputWidth = in.width;
+   desc.inputHeight = in.height;
+   desc.outputWidth = out.width;
+   desc.outputHeight = out.height;
+   desc.colorTextureFormat = in.pixelFormat;
+   desc.outputTextureFormat = out.pixelFormat;
+   /* FSR 1 is given the picture after tone mapping, as MetalFX's
+    * perceptual mode expects. */
+   desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+   id<MTL4FXSpatialScaler> scaler =
+      [desc newSpatialScalerWithDevice:dev compiler:compiler];
+   [desc release];
+   fprintf(stderr,
+           "kk: FSR by MetalFX spatial: %lux%lu (format %lu) -> %lux%lu "
+           "(format %lu)%s\n",
+           (unsigned long)in.width, (unsigned long)in.height,
+           (unsigned long)in.pixelFormat, (unsigned long)out.width,
+           (unsigned long)out.height, (unsigned long)out.pixelFormat,
+           scaler ? "" : ": MetalFX has no scaler for it, the game's own pass");
+   if (scaler && ((in.usage & scaler.colorTextureUsage) != scaler.colorTextureUsage ||
+                  (out.usage & scaler.outputTextureUsage) != scaler.outputTextureUsage)) {
+      fprintf(stderr,
+              "kk: FSR by MetalFX: texture usage 0x%lx/0x%lx, MetalFX needs "
+              "0x%lx/0x%lx: the game's own pass\n",
+              (unsigned long)in.usage, (unsigned long)out.usage,
+              (unsigned long)scaler.colorTextureUsage,
+              (unsigned long)scaler.outputTextureUsage);
+      [scaler release];
+      scaler = nil;
+   }
+
+   struct mfx_scaler *s = &scalers[scaler_next++ % MFX_SCALERS];
+   [s->scaler release];
+   *s = (struct mfx_scaler){
+      .in_format = in.pixelFormat,
+      .out_format = out.pixelFormat,
+      .in_w = in.width,
+      .in_h = in.height,
+      .out_w = out.width,
+      .out_h = out.height,
+      .scaler = scaler,
+      .used = true,
+   };
+   return scaler;
+}
+
+/* The scaler for this pair, if MetalFX takes it: plain 2D textures, the
+ * content within the input, the input no larger than the output, a scaler
+ * MetalFX made and whose texture usage these textures have. Caller holds the
+ * lock. */
+static id<MTL4FXSpatialScaler>
+mfx_usable(id<MTLDevice> dev, id<MTL4Compiler> compiler, id<MTLTexture> in,
+           id<MTLTexture> out, uint32_t in_w, uint32_t in_h)
+{
+   static int supported = -1;
+   if (supported < 0)
+      supported = [MTLFXSpatialScalerDescriptor supportsMetal4FX:dev];
+   if (!supported || !in || !out || in.textureType != MTLTextureType2D ||
+       out.textureType != MTLTextureType2D || in.width > out.width ||
+       in.height > out.height || in_w > in.width || in_h > in.height)
+      return nil;
+   return mfx_scaler_get(dev, compiler, in, out);
+}
+
+bool
+mtl_metalfx_spatial_usable(mtl_device *device, mtl_compiler *compiler,
+                           mtl_texture *in, mtl_texture *out, uint32_t in_w,
+                           uint32_t in_h)
+{
+   bool ok;
+   @autoreleasepool {
+      pthread_mutex_lock(&scaler_lock);
+      ok = mfx_usable((id<MTLDevice>)device, (id<MTL4Compiler>)compiler,
+                      (id<MTLTexture>)in, (id<MTLTexture>)out, in_w, in_h) != nil;
+      pthread_mutex_unlock(&scaler_lock);
+   }
+   return ok;
+}
+
+bool
+mtl_metalfx_spatial_encode(mtl_device *device, mtl_compiler *compiler,
+                           mtl_command_buffer *cmd_buf, mtl_texture *in_tex,
+                           mtl_texture *out_tex, uint32_t in_w, uint32_t in_h)
+{
+   bool ok = false;
+
+   @autoreleasepool {
+      id<MTLTexture> in = (id<MTLTexture>)in_tex;
+      id<MTLTexture> out = (id<MTLTexture>)out_tex;
+
+      pthread_mutex_lock(&scaler_lock);
+      id<MTL4FXSpatialScaler> scaler =
+         mfx_usable((id<MTLDevice>)device, (id<MTL4Compiler>)compiler, in, out,
+                    in_w, in_h);
+      if (scaler) {
+         scaler.colorTexture = in;
+         scaler.outputTexture = out;
+         scaler.inputContentWidth = in_w ? in_w : in.width;
+         scaler.inputContentHeight = in_h ? in_h : in.height;
+         [scaler encodeToCommandBuffer:(id<MTL4CommandBuffer>)cmd_buf];
+         /* Encoded: the scaler need not keep the game's textures alive (a
+          * cached one held display-sized textures after they were freed). */
+         scaler.colorTexture = nil;
+         scaler.outputTexture = nil;
+         ok = true;
+      }
+      pthread_mutex_unlock(&scaler_lock);
+   }
+   return ok;
+}
