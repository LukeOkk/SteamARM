+/* Metal has SIMD-group functions and inputs in fragment and compute
+ * functions only. In another stage every invocation is a subgroup of its
+ * own, which is all an implementation promises where it does not list the
+ * stage in subgroupSupportedStages. Shaders use the operations there anyway:
+ * Source 2 merges light masks with subgroupOr in a loop its vertex shaders
+ * share with its fragment shaders, and "invalid 'thread_index_in_simdgroup'
+ * attribute for input declaration in a vertex function" refused those
+ * pipelines (Counter-Strike 2 asked for them again every frame; MEASURED).
+ */
+static nir_def *
+single_ballot(nir_builder *b, nir_intrinsic_instr *intrin, nir_def *bit)
+{
+   nir_def *comps[NIR_MAX_VEC_COMPONENTS];
+   unsigned bits = intrin->def.bit_size;
+
+   comps[0] = nir_u2uN(b, bit, bits);
+   for (unsigned i = 1; i < intrin->def.num_components; i++)
+      comps[i] = nir_imm_intN_t(b, 0, bits);
+   return nir_vec(b, comps, intrin->def.num_components);
+}
+
+static bool
+lower_single_invocation(nir_builder *b, nir_intrinsic_instr *intrin,
+                        void *_unused)
+{
+   nir_def *repl = NULL;
+
+   b->cursor = nir_before_instr(&intrin->instr);
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_load_subgroup_size:
+      repl = nir_imm_int(b, 1);
+      break;
+   case nir_intrinsic_load_subgroup_invocation:
+   case nir_intrinsic_first_invocation:
+   case nir_intrinsic_last_invocation:
+      repl = nir_imm_int(b, 0);
+      break;
+   case nir_intrinsic_load_subgroup_eq_mask:
+   case nir_intrinsic_load_subgroup_ge_mask:
+   case nir_intrinsic_load_subgroup_le_mask:
+      repl = single_ballot(b, intrin, nir_imm_int(b, 1));
+      break;
+   case nir_intrinsic_load_subgroup_gt_mask:
+   case nir_intrinsic_load_subgroup_lt_mask:
+      repl = single_ballot(b, intrin, nir_imm_int(b, 0));
+      break;
+   case nir_intrinsic_elect:
+   case nir_intrinsic_vote_feq:
+   case nir_intrinsic_vote_ieq:
+      repl = nir_imm_true(b);
+      break;
+   case nir_intrinsic_vote_any:
+   case nir_intrinsic_vote_all:
+   case nir_intrinsic_quad_vote_any:
+   case nir_intrinsic_quad_vote_all:
+   case nir_intrinsic_read_invocation:
+   case nir_intrinsic_read_first_invocation:
+   case nir_intrinsic_shuffle:
+   case nir_intrinsic_shuffle_xor:
+   case nir_intrinsic_shuffle_up:
+   case nir_intrinsic_shuffle_down:
+   case nir_intrinsic_rotate:
+   case nir_intrinsic_quad_broadcast:
+   case nir_intrinsic_quad_swap_horizontal:
+   case nir_intrinsic_quad_swap_vertical:
+   case nir_intrinsic_quad_swap_diagonal:
+   case nir_intrinsic_reduce:
+   case nir_intrinsic_inclusive_scan:
+      repl = intrin->src[0].ssa;
+      break;
+   case nir_intrinsic_exclusive_scan: {
+      nir_const_value identity = nir_alu_binop_identity(
+         nir_intrinsic_reduction_op(intrin), intrin->def.bit_size);
+      nir_const_value v[NIR_MAX_VEC_COMPONENTS];
+      for (unsigned i = 0; i < intrin->def.num_components; i++)
+         v[i] = identity;
+      repl = nir_build_imm(b, intrin->def.num_components, intrin->def.bit_size,
+                           v);
+      break;
+   }
+   case nir_intrinsic_ballot:
+   case nir_intrinsic_ballot_relaxed:
+      repl = single_ballot(b, intrin, nir_b2i32(b, intrin->src[0].ssa));
+      break;
+   case nir_intrinsic_inverse_ballot:
+      repl = nir_ine_imm(
+         b, nir_iand_imm(b, nir_channel(b, intrin->src[0].ssa, 0), 1), 0);
+      break;
+   case nir_intrinsic_ballot_bitfield_extract:
+      repl = nir_iand(
+         b, nir_ieq_imm(b, intrin->src[1].ssa, 0),
+         nir_ine_imm(
+            b, nir_iand_imm(b, nir_channel(b, intrin->src[0].ssa, 0), 1), 0));
+      break;
+   case nir_intrinsic_ballot_bit_count_reduce:
+   case nir_intrinsic_ballot_bit_count_inclusive:
+      repl = nir_u2uN(
+         b, nir_iand_imm(b, nir_channel(b, intrin->src[0].ssa, 0), 1),
+         intrin->def.bit_size);
+      break;
+   case nir_intrinsic_ballot_bit_count_exclusive:
+   case nir_intrinsic_ballot_find_lsb:
+   case nir_intrinsic_ballot_find_msb:
+      repl = nir_imm_intN_t(b, 0, intrin->def.bit_size);
+      break;
+   default:
+      return false;
+   }
+
+   nir_def_replace(&intrin->def, repl);
+   return true;
+}
+
+bool
+msl_nir_lower_subgroups_single(nir_shader *nir)
+{
+   if (nir->info.stage == MESA_SHADER_FRAGMENT ||
+       nir->info.stage == MESA_SHADER_COMPUTE)
+      return false;
+
+   return nir_shader_intrinsics_pass(nir, lower_single_invocation,
+                                     nir_metadata_control_flow, NULL);
+}
+
 void
 msl_nir_lower_subgroups(nir_shader *nir)
 {
+   NIR_PASS(_, nir, msl_nir_lower_subgroups_single);
+
