+// Where the guest's code bytes are on the host: identity, or GuestBase +
+// RIP for a 32-bit guest living at a base (Addressing.cpp has the story).
+uint64_t ContextImpl::GuestCodeBase() const {
+  // NOTE: `Config.Is64BitMode ? 0 : Config.GuestBase` silently truncated to
+  // 32 bits here (measured): both Getter<...> operands let the ternary's
+  // common-type deduction settle on the Value<uint64_t> CLASS type rather
+  // than plain uint64_t (0 converts to Value<uint64_t> via its converting
+  // constructor), and something in that path loses the high bits. Read each
+  // operand into a plain uint64_t first so the ternary only ever sees
+  // built-in types.
+  const uint64_t RawGuestBase = Config.GuestBase;
+  const bool Is64 = Config.Is64BitMode;
+  uint64_t Base = Is64 ? 0 : RawGuestBase;
+  return Base;
+}
+
+uint8_t ContextImpl::GuestWindowShift() const {
+  const bool Is64 = Config.Is64BitMode;
+  const uint64_t Base = Config.GuestBase;
+  if (!Is64 || Base < (1ULL << 32) || (Base & (Base - 1)) != 0) {
+    return 0;
+  }
+  return static_cast<uint8_t>(std::countr_zero(Base));
+}
+
+uint64_t ContextImpl::GuestCodeHost(uint64_t RIP) const {
+  const bool Is64 = Config.Is64BitMode;
+  const uint64_t Base = Config.GuestBase;
+  if (!Is64) {
+    return RIP + Base;
+  }
+  if (Base > 1 && RIP != 0 && RIP < (1ULL << 32)) {
+    return RIP + Base;
+  }
+  return RIP;
+}
+
+uint64_t ContextImpl::HostCodeToGuest(uint64_t Host) const {
+  const bool Is64 = Config.Is64BitMode;
+  const uint64_t Base = Config.GuestBase;
+  if (!Is64) {
+    return Host - Base;
+  }
+  if (Base > 1 && Host >= Base && Host < Base + (1ULL << 32)) {
+    return Host - Base;
+  }
+  return Host;
+}
