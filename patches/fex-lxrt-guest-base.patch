diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBase.h b/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBase.h
new file mode 100644
index 000000000..4d7892568
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBase.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+
+// 32-bit guests on a host that cannot map the low 4 GiB (Darwin's __PAGEZERO)
+// live at host = GuestBase + guest. Zero on Linux: identity, no cost.
+// Set once at start-up (FEXInterpreter.cpp) before anything touches guest
+// memory; the JIT reads the same value through gregs[8] / x19.
+namespace FEX::HLE {
+extern uint64_t GuestBase;
+// True when FEX runs on the lxrt runtime (GUESTBASE requested), whatever the
+// guest's bitness. That host cannot give two processes one address space.
+extern bool NoSharedVMProcesses;
+// Only 0 < guest < 4 GiB is translated: that is every non-NULL address of a
+// 32-bit guest, and exactly the low window of a 64-bit ET_EXEC guest (whose
+// other addresses are identity). Host addresses on Darwin are all >= 4 GiB,
+// so both directions are idempotent.
+inline uint64_t G2H(uint64_t Guest) {
+  return (GuestBase && Guest != 0 && Guest < (1ULL << 32)) ? Guest + GuestBase : Guest;
+}
+inline uint64_t H2G(uint64_t Host) {
+  return (GuestBase && Host >= GuestBase && Host < GuestBase + (1ULL << 32)) ? Host - GuestBase : Host;
+}
+inline void* G2H(const void* Guest) {
+  return reinterpret_cast<void*>(G2H(reinterpret_cast<uint64_t>(Guest)));
+}
+} // namespace FEX::HLE
diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBaseThunk.h b/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBaseThunk.h
new file mode 100644
index 000000000..79eb0f0d4
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestBaseThunk.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "LinuxSyscalls/GuestBase.h"
+
+#include <cstdint>
+#include <string_view>
+#include <type_traits>
+
+namespace FEXCore::Core {
+struct CpuStateFrame;
+}
+
+namespace FEX::HLE {
+// Guest address base (Darwin host, see LinuxSyscalls/GuestBase.h): a 32-bit
+// guest's (or a 64-bit ET_EXEC guest's low-window) pointer arguments are guest addresses, while every handler body
+// dereferences them on the host (FileManager, signal structs, iovecs, ...).
+// This wrapper is the single choke point: each raw-pointer parameter below
+// 4 GiB gets the base added before the handler runs. compat_ptr<> parameters
+// already translate on their own, integer parameters are untouched, and the
+// memory-management syscalls are excluded -- their address argument is owned
+// by the 32-bit allocator, which works in guest addresses.
+template<typename T>
+static inline T GuestBaseArg(T Value) {
+  if constexpr (std::is_pointer_v<T>) {
+    const auto Raw = reinterpret_cast<uintptr_t>(Value);
+    if (FEX::HLE::GuestBase && Raw && Raw < 0x1'0000'0000ULL) {
+      return reinterpret_cast<T>(Raw + FEX::HLE::GuestBase);
+    }
+  }
+  return Value;
+}
+
+template<class F, typename R, typename... Args>
+struct GuestBaseThunk {
+  static R Call(FEXCore::Core::CpuStateFrame* Frame, Args... args) {
+    return F {}(Frame, GuestBaseArg<Args>(args)...);
+  }
+};
+
+template<class F, typename R, typename... Args>
+static auto MakeGuestBaseThunk(R (*)(FEXCore::Core::CpuStateFrame*, Args...)) {
+  return &GuestBaseThunk<F, R, Args...>::Call;
+}
+
+static inline bool IsGuestBaseExcluded(std::string_view Name) {
+  constexpr std::string_view Excluded[] = {
+    "mmap", "mmap2", "munmap", "mprotect", "mremap", "madvise", "brk", "shmat", "shmdt", "mlock", "mlock2",
+    "munlock", "msync", "mincore", "remap_file_pages", "pkey_mprotect", "process_madvise", "mseal",
+    // semun is a pointer-typed parameter that carries an int for SETVAL.
+    "semctl",
+  };
+  for (auto E : Excluded) {
+    if (E == Name) {
+      return true;
+    }
+  }
+  return false;
+}
+
+} // namespace FEX::HLE
