+static void
+kk_guard_poly_grid(nir_shader *nir, bool geometry)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+   nir_builder b = nir_builder_at(nir_after_block(nir_start_block(impl)));
+   nir_def *base = geometry ? nir_load_geometry_param_buffer_poly(&b)
+                            : nir_load_vertex_param_buffer_poly(&b);
+   uint32_t offset = geometry ? offsetof(struct poly_geometry_params, grid)
+                              : offsetof(struct poly_vertex_params, grid);
+   nir_def *x = nir_load_global_constant(
+      &b, 1, 32, nir_iadd_imm(&b, base, offset));
+   nir_def *y = nir_load_global_constant(
+      &b, 1, 32, nir_iadd_imm(&b, base, offset + 4));
+   nir_def *id = nir_load_global_invocation_id(&b, 32);
+   nir_def *inside = nir_iand(&b, nir_ult(&b, nir_channel(&b, id, 0), x),
+                              nir_ult(&b, nir_channel(&b, id, 1), y));
+   nir_push_if(&b, inside);
+   b.cursor = nir_cf_reinsert(&body, b.cursor);
+   nir_pop_if(&b, NULL);
+   nir_progress(true, impl, nir_metadata_none);
+}
