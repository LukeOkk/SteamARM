SteamARM: vertex shaders without fused multiply-adds across statements

Counter-Strike 2 draws foliage and palm trunks in a depth prepass and then
with depth test EQUAL. Metal's fast math fuses multiplies and adds where
it sees fit, and two pipelines with the same vertex code (the prepass and
the colour pass) could round the position differently: wherever they came
out a rounding apart the pixel was not drawn -- clusters of black on the
palm trunks, dotted hanging fronds, on de_dust2 (the user's screenshots,
2026-10-04; MoltenVK shows the same).

Vertex shaders are now compiled with "#pragma METAL fp contract(off)"
(KK_CONTRACT_OFF=vertex, the default; fragment, all or none to compare).
MEASURED in the game: the trunks whole at 71-74 fps, as fast as before;
with the fusion off in fragment shaders too, 62 fps; Metal's safe math,
60-63; relaxed math with precise functions left the black clusters.
KK_MATH_MODE (fast, the default; relaxed; safe) and KK_MATH_FUNCTIONS
(fast, the default; precise) choose Metal's math for the application's
shaders, for comparisons.
diff -ruN a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
--- a/src/kosmickrisp/vulkan/kk_shader.c	2026-10-04 14:26:39
+++ b/src/kosmickrisp/vulkan/kk_shader.c	2026-10-04 14:26:39
@@ -838,6 +838,68 @@
 
 static const struct vk_shader_ops kk_shader_ops;
 
+/* SteamARM: the Metal math mode of the application's shaders. Fast math
+ * lets the compiler assume no NaN or infinity ever happens; Counter-Strike 2
+ * makes some (a normal of length 0 and the like) that desktop GPUs settle the
+ * IEEE way, and with fast math they came out as single pixels of wrong
+ * colours all over the picture, de_dust2's palms speckled above all (the
+ * user's screenshots, 2026-10-04). Relaxed keeps the fast optimisations but
+ * the IEEE handling of NaN and infinity. KK_MATH_MODE=fast|relaxed|safe. */
+static enum mtl_math_mode
+kk_math_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *e = getenv("KK_MATH_MODE");
+      mode = e && !strcmp(e, "fast") ? MTL_MATH_MODE_FAST
+           : e && !strcmp(e, "safe") ? MTL_MATH_MODE_SAFE
+           : e && !strcmp(e, "relaxed") ? MTL_MATH_MODE_RELAXED
+           : MTL_MATH_MODE_FAST;
+   }
+   return (enum mtl_math_mode)mode;
+}
+
+/* Vertex shaders compiled without fused multiply-adds across statements.
+ * Fast math fuses them where it sees fit, differently in two pipelines with
+ * the same vertex code: Counter-Strike 2 draws its foliage and palm trunks
+ * in a depth prepass and then with depth test EQUAL, and wherever the two
+ * positions came out a rounding apart the pixel was not drawn -- clusters of
+ * black on the trunks, dotted fronds (the user's screenshots, 2026-10-04).
+ * Without the fusion in vertex shaders the trunks were whole, at the same
+ * frame rate (72-74 fps; without it in fragment shaders as well, 62).
+ * KK_CONTRACT_OFF=vertex (the default)|fragment|all|none. The source to
+ * compile, to be freed when it is not the one given. */
+static const char *
+kk_msl_contract(const char *code, bool fragment)
+{
+   const char *e = getenv("KK_CONTRACT_OFF");
+   if (!e || !e[0])
+      e = "vertex";
+   if (!(strcmp(e, "all") == 0 || strcmp(e, fragment ? "fragment" : "vertex") == 0))
+      return code;
+   static const char pragma[] = "#pragma METAL fp contract(off)\n";
+   size_t n = strlen(code);
+   char *s = malloc(sizeof(pragma) + n);
+   if (!s)
+      return code;
+   memcpy(s, pragma, sizeof(pragma) - 1);
+   memcpy(s + sizeof(pragma) - 1, code, n + 1);
+   return s;
+}
+
+/* And of its functions (sqrt, pow, exp...): KK_MATH_FUNCTIONS=fast|precise. */
+static enum mtl_math_floating_point_functions
+kk_math_functions(void)
+{
+   static int fns = -1;
+   if (fns < 0) {
+      const char *e = getenv("KK_MATH_FUNCTIONS");
+      fns = e && !strcmp(e, "precise") ? MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE
+                                       : MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST;
+   }
+   return (enum mtl_math_floating_point_functions)fns;
+}
+
 static void
 kk_shader_destroy(struct vk_device *vk_dev, struct kk_shader *shader,
                   const VkAllocationCallbacks *pAllocator)
@@ -1246,8 +1308,8 @@
