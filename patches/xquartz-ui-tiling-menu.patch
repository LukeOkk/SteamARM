+/* SteamARM: macOS 15's window tiling for X windows (quartz-wm draws and
+ * places them; they are not NSWindows, so the system's own Fill, Center and
+ * Move & Resize never reach them). The Window menu's commands go to the
+ * window manager as an AppleWMControllerNotify of this kind, the action in
+ * its argument; quartz-wm's quartz-wm.h has the same numbers. */
+#define SteamARMTileKind        32
+enum {
+    SteamARMTileFill = 1, SteamARMTileCenter, SteamARMTileLeft, SteamARMTileRight,
+    SteamARMTileTop, SteamARMTileBottom, SteamARMTileTopLeft, SteamARMTileTopRight,
+    SteamARMTileBottomLeft, SteamARMTileBottomRight, SteamARMTileRestore,
+};
+
 #include <stdio.h>
 #include <unistd.h>
 #include <fcntl.h>
@@ -113,8 +125,134 @@
                                            selector:@selector(apps_table_done:)
                                                name:NSWindowWillCloseNotification
                                              object:self.apps_table.window];
