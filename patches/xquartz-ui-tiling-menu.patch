+/* SteamARM: AppKit puts its own Fill, Center, Move & Resize, Full Screen
+ * Tile and Remove Window from Set at the top of the Window menu, above the
+ * nib's Close. They act on NSWindows only: always off for X windows, next
+ * to ours. Hide everything above the first item of ours, and any other item
+ * with a private AppKit action; then the separators that leaves leading or
+ * doubled. AppKit finds its items again
+ * by tag, so they stay in place. */
+- (void) hide_appkit_window_items
+{
+    NSMenu * const menu = X11App.windowsMenu;
+    BOOL ours_yet = NO, after_item = NO;
+
+    for (NSMenuItem *item in menu.itemArray) {
+        if (item.target == self)
+            ours_yet = YES;
+        if (item.isSeparatorItem || item.target == self)
+            continue;
+        if (!ours_yet
+            || (item.action != NULL && [NSStringFromSelector(item.action) hasPrefix:@"_"]))
+            item.hidden = YES;
+    }
+    for (NSMenuItem *item in menu.itemArray) {
+        if (item.isSeparatorItem) {
+            item.hidden = !after_item;
+            after_item = NO;
+        } else if (!item.isHidden)
+            after_item = YES;
+    }
+}
+
+/* SteamARM: Fill, Center and Move & Resize in the Window menu, after Zoom
+ * and before the list of windows (set_window_menu counts that list from the
+ * menu's end), titled from AppKit's own table so they read as the system's
+ * do in the app's language. No shortcuts: AppKit keeps the Globe modifier
+ * of Globe-Control-F, C and R for its own items only ("only supported for
+ * system-provided menu items"), and Control-F, C and R alone belong to the
+ * X clients (Control-C in a terminal). */
+- (void) install_tiling_menu
+{
+    NSMenu * const menu = X11App.windowsMenu;
+    NSBundle * const ak = [NSBundle bundleForClass:NSApplication.class];
+    NSInteger at;
+    NSMenu *sub;
+    NSMenuItem *item;
+    static BOOL done;
+
+    if (done || menu == nil || getenv("XQUARTZ_NO_TILING_MENU"))
+        return;
+    done = YES;
+
+#define L(k) [ak localizedStringForKey:(k) value:(k) table:@"MenuCommands"]
+    at = [menu indexOfItemWithTarget:self andAction:@selector(zoom_window:)];
+    at = at >= 0 ? at + 1 : 0;
+
+    struct { NSString *key; NSInteger tag; } const top[] = {
+        { @"Fill", SteamARMTileFill },
+        { @"Center", SteamARMTileCenter },
+    };
+    for (size_t i = 0; i < sizeof top / sizeof top[0]; i++) {
+        item = [[NSMenuItem alloc] initWithTitle:L(top[i].key)
+                                          action:@selector(tile_window:)
+                                   keyEquivalent:@""];
+        item.target = self;
+        item.tag = top[i].tag;
+        [menu insertItem:item atIndex:at++];
+        [item release];
+    }
+
+    /* tag -1: a section header */
+    struct { NSString *key; NSInteger tag; } const moves[] = {
+        { @"Halves", -1 },
+        { @"Left", SteamARMTileLeft },
+        { @"Right", SteamARMTileRight },
+        { @"Top", SteamARMTileTop },
+        { @"Bottom", SteamARMTileBottom },
+        { @"Quarters_Header", -1 },
+        { @"Top Left", SteamARMTileTopLeft },
+        { @"Top Right", SteamARMTileTopRight },
+        { @"Bottom Left", SteamARMTileBottomLeft },
+        { @"Bottom Right", SteamARMTileBottomRight },
+        { nil, 0 },
+        { @"Return to Previous Size", SteamARMTileRestore },
+    };
+    sub = [[NSMenu alloc] initWithTitle:L(@"Move & Resize")];
+    for (size_t i = 0; i < sizeof moves / sizeof moves[0]; i++) {
+        if (moves[i].tag == 0) {
+            [sub addItem:[NSMenuItem separatorItem]];
+            continue;
+        }
+        if (moves[i].tag < 0) {
+            if (@available(macOS 14, *))
+                [sub addItem:[NSMenuItem sectionHeaderWithTitle:L(moves[i].key)]];
+            continue;
+        }
+        item = [[NSMenuItem alloc] initWithTitle:L(moves[i].key)
+                                          action:@selector(tile_window:)
+                                   keyEquivalent:@""];
+        item.target = self;
+        item.tag = moves[i].tag;
+        [sub addItem:item];
+        [item release];
+    }
+    item = [[NSMenuItem alloc] initWithTitle:sub.title action:NULL keyEquivalent:@""];
+    item.submenu = sub;
+    [menu insertItem:item atIndex:at++];
+    [item release];
+    [sub release];
+#undef L
+
+    [self hide_appkit_window_items];
+    /* AppKit may add (or add again) its items later on. */
+    [[NSNotificationCenter defaultCenter] addObserverForName:NSMenuDidAddItemNotification
+                                                      object:menu
+                                                       queue:nil
+                                                  usingBlock:^(NSNotification *n) {
+        (void) n;
+        [self hide_appkit_window_items];
+    }];
+    ErrorF("window menu: tiling commands added (%s)\n", ak.preferredLocalizations.firstObject.UTF8String ?: "?");
+}
