+/* SteamARM: tiling by dragging a window's title bar to an edge or corner
+ * of the screen, as macOS 15 does: left or right edge, half; top edge,
+ * Fill; near a corner, a quarter. While the pointer is there an outline of
+ * the region shows where the window will go; it is applied on release.
+ * XQuartz has no translucent windows (no alpha, no Composite), so the
+ * outline is a shaped ring at the floating level that takes no input. */
+#define TILE_EDGE    2      /* the pointer within this of the screen's edge */
+#define TILE_CORNER  48     /* ...and within this of a corner: a quarter */
+
+static struct {
+    Window preview;
+    Window root;
+    int where;              /* QWM_TILE_*, QWM_TILE_NONE when off */
+    X11Rect shown;
+    X11Point at;            /* the pointer the outline was drawn for */
+} tile_drag;
+
+/* The head under |p|, half open on its right and bottom edges as NSScreen
+ * frames are (zoomed_rect), so that the zone and its region agree on the
+ * screen where two heads meet. */
+static X11Rect
+tile_head (x_screen *s, X11Point p)
+{
+    for (int i = 0; i < s->_head_count; i++) {
+        X11Rect h = s->_heads[i];
+        if (p.x >= h.x && p.x < h.x + (int) h.width && p.y >= h.y && p.y < h.y + (int) h.height)
+            return h;
+    }
+    return [s head_containing_point:p];
+}
+
+static int
+tile_zone (x_window *w, X11Point p)
+{
+    X11Rect h = tile_head (w->_screen, p);
+    int band_y = MAX (TILE_CORNER, (int) h.height / 10);
+    int band_x = MAX (TILE_CORNER, (int) h.width / 10);
+    BOOL left = p.x <= h.x + TILE_EDGE - 1;
+    BOOL right = p.x >= h.x + (int) h.width - TILE_EDGE;
+    BOOL top = p.y <= h.y + TILE_EDGE - 1;
+    BOOL near_top = p.y < h.y + band_y;
+    BOOL near_bottom = p.y >= h.y + (int) h.height - band_y;
+
+    if (![w can_tile])
+        return QWM_TILE_NONE;
+    if (left)
+        return near_top ? QWM_TILE_TOP_LEFT : near_bottom ? QWM_TILE_BOTTOM_LEFT : QWM_TILE_LEFT;
+    if (right)
+        return near_top ? QWM_TILE_TOP_RIGHT : near_bottom ? QWM_TILE_BOTTOM_RIGHT : QWM_TILE_RIGHT;
+    if (top) {
+        if (p.x < h.x + band_x)
+            return QWM_TILE_TOP_LEFT;
+        if (p.x >= h.x + (int) h.width - band_x)
+            return QWM_TILE_TOP_RIGHT;
+        return QWM_TILE_FILL;
+    }
+    return QWM_TILE_NONE;
+}
+
+static void
+tile_preview_hide (void)
+{
+    if (tile_drag.preview != None)
+        XUnmapWindow (x_dpy, tile_drag.preview);
+    tile_drag.where = QWM_TILE_NONE;
+}
+
+static void
+tile_preview_show (x_window *w, X11Rect r)
+{
+    enum { RING = 4 };
+    XRectangle ring[4];
+
+    if (tile_drag.preview != None && tile_drag.root != w->_screen->_root) {
+        XDestroyWindow (x_dpy, tile_drag.preview);
+        tile_drag.preview = None;
+    }
+    if (tile_drag.preview == None) {
+        XSetWindowAttributes attr;
+        XColor c = { 0 };
+
+        /* macOS's accent blue */
+        c.red = 0x0a0a; c.green = 0x8484; c.blue = 0xffff;
+        c.flags = DoRed | DoGreen | DoBlue;
+        attr.background_pixel = XAllocColor (x_dpy, w->_screen->_colormap, &c)
+            ? c.pixel : WhitePixel (x_dpy, DefaultScreen (x_dpy));
+        attr.override_redirect = True;
+        attr.border_pixel = 0;
+        attr.colormap = w->_screen->_colormap;
+        tile_drag.preview = XCreateWindow (x_dpy, w->_screen->_root, r.x, r.y,
+                                           MAX (r.width, 2 * RING + 1), MAX (r.height, 2 * RING + 1),
+                                           0, w->_screen->_depth, InputOutput, w->_screen->_visual,
+                                           CWBackPixel | CWOverrideRedirect | CWBorderPixel | CWColormap,
+                                           &attr);
+        tile_drag.root = w->_screen->_root;
+        /* Never in the way of the pointer. */
+        XShapeCombineRectangles (x_dpy, tile_drag.preview, ShapeInput, 0, 0, NULL, 0,
+                                 ShapeSet, Unsorted);
+        tile_drag.shown = X11EmptyRect;
+    }
+
+    if (!X11RectEqualToRect (r, tile_drag.shown)) {
+        ring[0] = (XRectangle) { 0, 0, r.width, RING };
+        ring[1] = (XRectangle) { 0, r.height - RING, r.width, RING };
+        ring[2] = (XRectangle) { 0, RING, RING, r.height - 2 * RING };
+        ring[3] = (XRectangle) { r.width - RING, RING, RING, r.height - 2 * RING };
+        XMoveResizeWindow (x_dpy, tile_drag.preview, r.x, r.y, r.width, r.height);
+        XShapeCombineRectangles (x_dpy, tile_drag.preview, ShapeBounding, 0, 0, ring, 4,
+                                 ShapeSet, Unsorted);
+        tile_drag.shown = r;
+    }
+    XMapRaised (x_dpy, tile_drag.preview);
+    XAppleWMSetWindowLevel (x_dpy, tile_drag.preview, AppleWMWindowLevelFloating);
+}
+
+/* A drag of |w| is at |p|: the outline follows the zone. */
+static void
+tile_drag_motion (x_window *w, X11Point p)
+{
+    const char *e = getenv ("QUARTZ_WM_TILING");
+    int where;
+
+    if (e && e[0] == '0')
+        return;
+    where = tile_zone (w, p);
+    if (where == tile_drag.where)
+        return;
+    if (where == QWM_TILE_NONE) {
+        tile_preview_hide ();
+        return;
+    }
+    tile_drag.where = where;
+    tile_drag.at = p;
+    tile_preview_show (w, [w tile_rect:where at:p]);
+}
+
+/* The drag of |w| ended: tiled if it ended in a zone (|apply|), the
+ * outline gone either way. |pretile| is the frame the drag started from. */
+static void
+tile_drag_end (x_window *w, BOOL apply, X11Rect pretile)
+{
+    int where = tile_drag.where;
+
+    tile_preview_hide ();
+    if (apply && where != QWM_TILE_NONE && w != nil && !w->_removed && !w->_deleted)
+        [w do_tile:where pretile:pretile at:tile_drag.at];
+}
+
+/* The frame a framed title-bar drag started from (for Return to Previous
+ * Size after a tile). */
+static X11Rect tile_drag_start_frame;
