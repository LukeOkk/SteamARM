 /* Double click on a title bar: System Settings > Desktop & Dock >
  * "Double-click a window's title bar to" (Zoom / Fill / Minimize / Do
  * Nothing), like every native window. */
+/* SteamARM: macOS 15's window tiling, for X windows (they are not
+ * NSWindows, so the system's own tiling never applied to them). Regions of
+ * the visible frame of the screen under a point -- below the menu bar,
+ * beside the Dock -- with the gaps of "Tiled windows have margins"
+ * (com.apple.WindowManager EnableTiledWindowMargins, on by default). */
+static int
+tile_margin (void)
+{
+    Boolean ok = false;
+    Boolean on = CFPreferencesGetAppBooleanValue (CFSTR ("EnableTiledWindowMargins"),
+                                                  CFSTR ("com.apple.WindowManager"), &ok);
+    return (ok && !on) ? 0 : 8;
+}
+
+- (X11Rect) tile_rect:(int)where at:(X11Point)p
+{
+    X11Rect v = [_screen zoomed_rect:p];
+    int m = tile_margin ();
+    X11Rect a = X11RectMake (v.x + m, v.y + m, v.width - 2 * m, v.height - 2 * m);
+    int hw = (a.width - m) / 2, hh = (a.height - m) / 2;
+    X11Rect f;
+
+    switch (where) {
+        case QWM_TILE_LEFT:         return X11RectMake (a.x, a.y, hw, a.height);
+        case QWM_TILE_RIGHT:        return X11RectMake (a.x + a.width - hw, a.y, hw, a.height);
+        case QWM_TILE_TOP:          return X11RectMake (a.x, a.y, a.width, hh);
+        case QWM_TILE_BOTTOM:       return X11RectMake (a.x, a.y + a.height - hh, a.width, hh);
+        case QWM_TILE_TOP_LEFT:     return X11RectMake (a.x, a.y, hw, hh);
+        case QWM_TILE_TOP_RIGHT:    return X11RectMake (a.x + a.width - hw, a.y, hw, hh);
+        case QWM_TILE_BOTTOM_LEFT:  return X11RectMake (a.x, a.y + a.height - hh, hw, hh);
+        case QWM_TILE_BOTTOM_RIGHT: return X11RectMake (a.x + a.width - hw, a.y + a.height - hh, hw, hh);
+        case QWM_TILE_CENTER:
+            f = [self intended_frame];
+            return X11RectMake (v.x + (v.width - (int) f.width) / 2,
+                                v.y + (v.height - (int) f.height) / 2, f.width, f.height);
+        case QWM_TILE_FILL:
+        default:
+            return a;
+    }
+}
+
+- (void) do_tile:(int)where
+{
+    [self do_tile:where pretile:[self intended_frame]];
+}
+
+- (BOOL) can_tile
+{
+    return _movable && !_fullscreen && !_shaded && !_hidden;
+}
+
+/* Moved or resized by hand: no longer in its tile. */
+- (void) leave_tile
+{
+    _tiled = NO;
+}
+
+/* |pretile| is what Return to Previous Size goes back to when the window
+ * was not tiled already (for a drag, the frame the drag started from). */
+- (void) do_tile:(int)where pretile:(X11Rect)pretile
+{
+    X11Rect cur, r;
+    X11Point at;
+
+    if (_fullscreen || _shaded || _hidden || where <= QWM_TILE_NONE || where > QWM_TILE_RESTORE)
+        return;
+
+    if (where == QWM_TILE_RESTORE) {
+        if (!_tiled)
+            return;
+        _tiled = NO;
+        r = [self validate_frame_rect:_pretile_frame from_user:YES constrain:NO];
+        [self resize_frame:r force:YES];
+        return;
+    }
+
+    cur = [self intended_frame];
+    if (!_tiled)
+        _pretile_frame = pretile;
+
+    /* The screen the window's title bar is on. */
+    at = X11PointMake (cur.x + (int) cur.width / 2, cur.y + MIN ((int) cur.height / 2, 12));
+    r = [self tile_rect:where at:at];
+
+    /* A window that keeps its size (min = max, a dialog) goes to the
+     * middle of the region instead. */
+    if (!_resizable && where != QWM_TILE_CENTER) {
+        X11Rect c = X11RectMake (r.x + ((int) r.width - (int) cur.width) / 2,
+                                 r.y + ((int) r.height - (int) cur.height) / 2,
+                                 cur.width, cur.height);
+        r = c;
+    }
+
+    r = [self validate_frame_rect:r from_user:YES constrain:NO];
+    _tiled = YES;
+    _tile_where = where;
+    [self resize_frame:r force:YES];
+}
+
+/* A tiled window dragged away goes back to its size before the tile, as
+ * on macOS, with the point under the pointer kept in proportion. Returns
+ * the frame to drag from. */
+- (X11Rect) untile_for_drag_at:(X11Point)pointer
+{
+    X11Rect f = [self intended_frame], r;
+    double rel;
+
+    if (!_tiled)
+        return f;
+    _tiled = NO;
+    if (!_resizable || (int) f.width <= 0)
+        return f;
+
+    rel = (double) (pointer.x - f.x) / (double) f.width;
+    if (rel < 0) rel = 0;
+    if (rel > 1) rel = 1;
+    r = X11RectMake (pointer.x - (int) (rel * _pretile_frame.width), f.y,
+                     _pretile_frame.width, _pretile_frame.height);
+    r = [self validate_frame_rect:r from_user:YES constrain:NO];
+    [self resize_frame:r force:YES];
+    return r;
+}
