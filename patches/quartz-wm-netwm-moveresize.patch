+    /* WM_NORMAL_HINTS min/max size and increments; from_user: no cap at the
+     * screen size, same as the grow box. */
+    {
+        X11Rect c = r;
+        X11Size sz;
+
+        c.height -= _frame_title_height;
+        if (c.width < 1)
+            c.width = 1;
+        if (c.height < 1)
+            c.height = 1;
+
+        sz = [self validate_window_size:c from_user:YES constrain:YES];
+        r.width = sz.width;
+        r.height = sz.height + _frame_title_height;
+    }
+
+    /* The edge opposite the one being dragged stays put. */
+    if (left)
+        r.x = s.x + s.width - r.width;
+    if (top)
+        r.y = s.y + s.height - r.height;
+
+    return r;
+}
+
+/* Double click on a title bar: System Settings > Desktop & Dock >
+ * "Double-click a window's title bar to" (Zoom / Fill / Minimize / Do
+ * Nothing), like every native window. */
+- (void) do_title_double_click
+{
+    enum { ACTION_ZOOM, ACTION_MINIMIZE, ACTION_NONE } action = ACTION_ZOOM;
+    CFPropertyListRef value;
+
+    value = CFPreferencesCopyAppValue (CFSTR ("AppleActionOnDoubleClick"),
+                                       kCFPreferencesAnyApplication);
+    if (value != NULL && CFGetTypeID (value) == CFStringGetTypeID ()) {
+        CFStringRef str = (CFStringRef) value;
+
+        if (CFStringCompare (str, CFSTR ("Minimize"), kCFCompareCaseInsensitive) == kCFCompareEqualTo)
+            action = ACTION_MINIMIZE;
+        else if (CFStringCompare (str, CFSTR ("None"), kCFCompareCaseInsensitive) == kCFCompareEqualTo)
+            action = ACTION_NONE;
+        /* "Maximize" (Zoom) and "Fill" both fill the visible frame. */
+    } else {
+        /* Key used before macOS 10.11. */
+        Boolean ok = false;
+
+        if (CFPreferencesGetAppBooleanValue (CFSTR ("AppleMiniaturizeOnDoubleClick"),
+                                             kCFPreferencesAnyApplication, &ok) && ok)
+            action = ACTION_MINIMIZE;
+    }
+    if (value != NULL)
+        CFRelease (value);
+
+    DB("id: 0x%lx action: %d", _id, (int) action);
+
+    switch (action) {
+        case ACTION_MINIMIZE:
+            if (_frame_attr & XP_FRAME_ATTR_COLLAPSE)
+                [self do_collapse];
+            break;
+        case ACTION_ZOOM:
+            if (_frame_attr & XP_FRAME_ATTR_ZOOM)
+                [self do_zoom];
+            break;
+        case ACTION_NONE:
+            break;
+    }
+}
+
+/* The edge or corner of a frameless window under |p| (client window
+ * coordinates) as a _NET_WM_MOVERESIZE direction, -1 for none. Corners
+ * reach FRAMELESS_RESIZE_CORNER along both edges; the top edge is only
+ * FRAMELESS_RESIZE_TOP thick, below it are the client's title bar, tabs and
+ * menus (Steam's top bar). */
+- (int) frameless_resize_direction:(X11Point)p
+{
+    int border = frameless_resize_border;
+    int top_border = MIN (border, FRAMELESS_RESIZE_TOP);
+    int corner = MAX (border, FRAMELESS_RESIZE_CORNER);
+    int width, height;
+    BOOL left, right, top, bottom;
+    BOOL near_left, near_right, near_top, near_bottom;
+
+    if (!_frameless || border <= 0 || ![self can_moveresize:NET_WM_MOVERESIZE_SIZE_RIGHT])
+        return -1;
+
+    width = _current_frame.width;
+    height = _current_frame.height - _frame_title_height;
+
+    left = p.x < border;
+    right = !left && p.x >= width - border;
+    top = p.y < top_border;
+    bottom = !top && p.y >= height - border;
+
+    if (!left && !right && !top && !bottom)
+        return -1;
+
+    near_left = p.x < corner;
+    near_right = !near_left && p.x >= width - corner;
+    near_top = p.y < corner;
+    near_bottom = !near_top && p.y >= height - corner;
+
+    if ((left && near_top) || (top && near_left))
+        return NET_WM_MOVERESIZE_SIZE_TOPLEFT;
+    if ((right && near_top) || (top && near_right))
+        return NET_WM_MOVERESIZE_SIZE_TOPRIGHT;
+    if ((left && near_bottom) || (bottom && near_left))
+        return NET_WM_MOVERESIZE_SIZE_BOTTOMLEFT;
+    if ((right && near_bottom) || (bottom && near_right))
+        return NET_WM_MOVERESIZE_SIZE_BOTTOMRIGHT;
+    if (left)
+        return NET_WM_MOVERESIZE_SIZE_LEFT;
+    if (right)
+        return NET_WM_MOVERESIZE_SIZE_RIGHT;
+    if (top)
+        return NET_WM_MOVERESIZE_SIZE_TOP;
+
+    return NET_WM_MOVERESIZE_SIZE_BOTTOM;
+}
+
 @end
