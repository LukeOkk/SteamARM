+ * there. 0 turns it off. */
+#define PREFS_FRAMELESS_RESIZE_BORDER "wm_frameless_resize_border"
+#define FRAMELESS_RESIZE_CORNER 16
+#define FRAMELESS_RESIZE_TOP 3
+extern int frameless_resize_border;
+
+/* Modifier for the Option keys (Alt_L / Mode_switch), 0 if none */
