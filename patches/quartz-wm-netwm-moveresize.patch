+/* Drag that ends without the pointer passing DRAG_THRESHOLD is a click; two
+ * such clicks on the same window within the macOS double-click interval run
+ * the title-bar double-click action (System Settings > Desktop & Dock).
+ * Only for requests that name a button (SDL3); Chromium sends button 0 and
+ * handles double clicks on its own title bar itself. */
+#define PREFS_MOVERESIZE_DOUBLE_CLICK "wm_moveresize_double_click"
