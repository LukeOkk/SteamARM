+/* _NET_WM_MOVERESIZE (EWMH): a client asks the window manager to run an
+ * interactive move or edge resize from the button press it just received.
+ * Frameless clients have no other way to be moved or resized: Chromium/CEF
+ * custom title bars (X11Window::DispatchHostWindowDragMovement ->
+ * ui::DoWMMoveResize) and SDL3 hit-test windows
+ * (X11_TriggerHitTestAction -> DispatchWindowMove / InitiateWindowResize).
+ * Steam is both at once: its SDL3 toplevel holds CEF's window, which holds
+ * Chromium's X11Window; Chromium gets the presses and sends the request for
+ * its own window, two levels below the one we manage.
+ *
+ * Xplugin windows belong to the X server, so AppKit's own window dragging is
+ * out of reach; like the title-bar drag above, this runs on X pointer events,
+ * under an active pointer grab on the root window, and moves/resizes the
+ * frame with resize_frame (pipelined against ConfigureNotify). The same
+ * drag also serves presses on the edges of frameless windows and
+ * Cmd-Option-drag (frameless_press). */
+
+static struct {
+    x_window *w;                /* retained while a drag runs */
+    int direction;
+    X11Point anchor;            /* root coordinates of the press */
+    X11Rect start_frame;
+    unsigned moved :1;          /* pointer went past DRAG_THRESHOLD */
+    unsigned record_click :1;   /* a click may start a double click */
+} moveresize;
+
+/* The last drag that turned out to be a plain click, for double clicks. */
+static struct {
+    Window id;
+    CFAbsoluteTime time;
+    X11Point where;
+} moveresize_click;
+
+/* Resize cursors by direction. A move keeps whatever cursor the window
+ * under the pointer has (None), as macOS keeps the arrow. */
+static Cursor
+moveresize_cursor (int direction)
+{
+    static Cursor cursors[8];
+    static const unsigned int shapes[8] = {
+        XC_top_left_corner, XC_top_side, XC_top_right_corner,
+        XC_right_side, XC_bottom_right_corner, XC_bottom_side,
+        XC_bottom_left_corner, XC_left_side,
+    };
+
+    if (direction < NET_WM_MOVERESIZE_SIZE_TOPLEFT
+        || direction > NET_WM_MOVERESIZE_SIZE_LEFT)
+        return None;
+
+    if (cursors[direction] == None)
+        cursors[direction] = XCreateFontCursor (x_dpy, shapes[direction]);
+
+    return cursors[direction];
+}
+
+static CFTimeInterval
+double_click_interval (void)
+{
+    CFPropertyListRef value;
+    double interval = 0.5;
+
+    value = CFPreferencesCopyAppValue (CFSTR ("com.apple.mouse.doubleClickThreshold"),
+                                       kCFPreferencesAnyApplication);
+    if (value != NULL) {
+        if (CFGetTypeID (value) == CFNumberGetTypeID ())
+            CFNumberGetValue ((CFNumberRef) value, kCFNumberDoubleType, &interval);
+        CFRelease (value);
+    }
+
+    if (interval < 0.1 || interval > 5.0)
+        interval = 0.5;
+
+    return interval;
+}
+
+/* Ends the drag where it is: button released, _NET_WM_MOVERESIZE_CANCEL,
+ * a new request, X going inactive, the window going away. */
+static void
+moveresize_end (void)
+{
+    x_window *w = moveresize.w;
+
+    if (w == nil)
+        return;
+
+    moveresize.w = nil;
+
+    XUngrabPointer (x_dpy, CurrentTime);
+
+    if (!w->_removed && !w->_deleted) {
+        if (moveresize.direction == NET_WM_MOVERESIZE_MOVE) {
+#if MAC_OS_X_VERSION_MIN_REQUIRED >= 1050
+            if (moveresize.moved)
+                qwm_dock_drag_end ([w get_osx_id]);
+#endif
+        } else {
+            [w remove_resizing_title];
+        }
+
+        if (moveresize.record_click && !moveresize.moved
+            && moveresize.direction == NET_WM_MOVERESIZE_MOVE) {
+            moveresize_click.id = w->_id;
+            moveresize_click.time = CFAbsoluteTimeGetCurrent ();
+            moveresize_click.where = moveresize.anchor;
+        } else {
+            moveresize_click.id = None;
+        }
+    }
+
+    DB("end: id 0x%lx direction %d moved %d", w->_id,
+       moveresize.direction, (int) moveresize.moved);
+
+    XFlush (x_dpy);
+    [w release];
+}
+
+static void
+moveresize_motion (int x_root, int y_root, unsigned int state)
+{
+    x_window *w = moveresize.w;
+    X11Point p = X11PointMake (x_root, y_root);
+    X11Rect r;
+
+    /* Gone, or minimized, hidden or made fullscreen under the drag */
+    if (![w can_moveresize:moveresize.direction]) {
+        moveresize_end ();
+        return;
+    }
+
+    if ((state & BUTTON_MASK) == 0) {
+        /* We must have missed the button release. */
+        moveresize_end ();
+        return;
+    }
+
+    if (!moveresize.moved) {
+        if (point_distance (moveresize.anchor, p) < DRAG_THRESHOLD)
+            return;
+
+        moveresize.moved = YES;
+#if MAC_OS_X_VERSION_MIN_REQUIRED >= 1050
+        if (moveresize.direction == NET_WM_MOVERESIZE_MOVE)
+            qwm_dock_drag_begin ([w get_osx_id]);
+#endif
+    }
+
+    r = [w moveresize_frame:moveresize.start_frame
+                  direction:moveresize.direction
+                         dx:p.x - moveresize.anchor.x
+                         dy:p.y - moveresize.anchor.y
+                    pointer:p];
+    [w resize_frame:r];
+
+    if (moveresize.direction != NET_WM_MOVERESIZE_MOVE)
+        [w set_resizing_title:r];
+}
+
+/* Takes the pointer for a drag of |w|: an active grab on the root with the
+ * cursor for |direction|. It replaces our own passive grab on the client
+ * window too, thawing the pointer without replaying the press. */
+static BOOL
+moveresize_grab (x_window *w, int direction)
+{
+    int status;
+
+    status = XGrabPointer (x_dpy, w->_screen->_root, False,
+                           ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
+                           GrabModeAsync, GrabModeAsync, None,
+                           moveresize_cursor (direction), CurrentTime);
+    if (status != GrabSuccess) {
+        asl_log (aslc, NULL, ASL_LEVEL_WARNING,
+                 "_NET_WM_MOVERESIZE: pointer grab failed (%d)", status);
+        return NO;
+    }
+
+    return YES;
+}
+
+/* Starts the drag once the pointer is ours; |anchor| is the press. */
+static void
+moveresize_start (x_window *w, int direction, X11Point anchor,
+                  X11Rect start_frame, BOOL record_click)
+{
+    moveresize.w = [w retain];
+    moveresize.direction = direction;
+    moveresize.anchor = anchor;
+    moveresize.start_frame = start_frame;
+    moveresize.moved = NO;
+    moveresize.record_click = record_click;
+}
+
+static void
+moveresize_begin (x_window *w, XClientMessageEvent *e)
+{
+    int direction = (int) e->data.l[2];
