+    if (moveresize.w == nil)
+        return NO;
+
+    switch (e->type) {
+        case MotionNotify:
+            /* Only the newest position matters, but never skip past
+             * anything else: a ButtonRelease behind it ends the drag. */
+            while (XEventsQueued (x_dpy, QueuedAfterReading) > 0) {
+                XPeekEvent (x_dpy, &next);
+                if (next.type != MotionNotify)
+                    break;
+                XNextEvent (x_dpy, e);
+            }
+            moveresize_motion (e->xmotion.x_root, e->xmotion.y_root,
+                               e->xmotion.state);
+            return YES;
+
+        case ButtonRelease:
+            moveresize_motion (e->xbutton.x_root, e->xbutton.y_root,
+                               e->xbutton.state);
+            moveresize_end ();
+            return YES;
+
+        case ButtonPress:
+            return YES;
+    }
