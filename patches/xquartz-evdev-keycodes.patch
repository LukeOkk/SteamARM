+/* macOS virtual key code -> X keycode - MIN_KEYCODE; a bijection on
+   0..NUM_KEYCODES-1 (keys with no Linux code take the free numbers). */
+static unsigned char darwin_vk_to_x[NUM_KEYCODES];
+static Bool darwin_vk_to_x_ready;
+
 static void
+DarwinBuildKeycodeMap(UInt32 keyboard_type)
+{
+    const char *e = getenv("STEAMARM_X11_EVDEV_KEYCODES");
+    Bool evdev = !(e && e[0] == '0');
+    Bool iso = KBGetLayoutType(keyboard_type) == kKeyboardISO;
+    Bool taken[NUM_KEYCODES];
+    Bool placed[NUM_KEYCODES];
+    int vk, x = 0;
+
+    memset(taken, 0, sizeof(taken));
+    memset(placed, 0, sizeof(placed));
+    for (vk = 0; vk < NUM_KEYCODES; vk++) {
+        int src = vk, code = vk;
+
+        if (evdev) {
+            if (iso && vk == kVK_ISO_Section)
+                src = kVK_ANSI_Grave;
+            else if (iso && vk == kVK_ANSI_Grave)
+                src = kVK_ISO_Section;
+            code = src < 128 ? darwin_vk_to_evdev[src] : 0;
+            if (code == 0)
+                continue;
+        }
+        if (code < NUM_KEYCODES && !taken[code]) {
+            darwin_vk_to_x[vk] = code;
+            taken[code] = placed[vk] = TRUE;
+        }
+    }
+    for (vk = 0; vk < NUM_KEYCODES; vk++) {
+        if (placed[vk])
+            continue;
+        while (taken[x])
+            x++;
+        darwin_vk_to_x[vk] = x;
+        taken[x] = TRUE;
+    }
+    darwin_vk_to_x_ready = TRUE;
+    ErrorF("keycodes: %s%s\n", evdev ? "Linux evdev + 8" : "macOS + 8",
+           evdev && iso ? " (ISO keyboard)" : "");
+}
+
+int
+DarwinXKeycode(int vk)
+{
+    if (vk < 0 || vk >= NUM_KEYCODES || !darwin_vk_to_x_ready)
+        return vk + MIN_KEYCODE;
+    return darwin_vk_to_x[vk] + MIN_KEYCODE;
+}
