diff -ruN a/src/kosmickrisp/vulkan/kk_mfx_temporal.c b/src/kosmickrisp/vulkan/kk_mfx_temporal.c
--- a/src/kosmickrisp/vulkan/kk_mfx_temporal.c	1969-12-31 21:00:00
+++ b/src/kosmickrisp/vulkan/kk_mfx_temporal.c	2026-10-04 21:13:34
@@ -0,0 +1,362 @@
+/*
+ * Copyright 2026 SteamARM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* SteamARM: a game's temporal upscale (FSR 3.1, DLSS) done by MetalFX's
+ * temporal scaler, at its place in the command buffer.
+ *
+ * A Windows FFX DLL of SteamARM's records the upscale as an ordinary
+ * vkCmdUpdateBuffer whose data is a struct sa_mfxt_cmd (kk_mfx_temporal.h);
+ * the call crosses winevulkan and FEX unchanged, and SteamARM's Vulkan shim
+ * catches it and calls kk_steamarm_upscale_temporal here instead of the
+ * update. Its status goes back to the DLL in the same call: anything but
+ * SA_ST_OK and the DLL runs the game's own upscaler in the same frame.
+ *
+ * ENCODE: each VkImage is its kk_image's Metal texture (a view where another
+ * format is asked for and the image is mutable; depth always in its own
+ * format). Refused, with nothing encoded: inside a render pass, a secondary
+ * command buffer, conditional rendering on, an image or size missing or
+ * outside its image, a scale MetalFX does not take (1x to 3x a side on an
+ * M4), formats or texture usage it does not take. Then patch 14's sequence:
+ * the open encoders end, MetalFX is encoded into the render passes' Metal
+ * command buffer, and the next encoder waits for it (after_metalfx); when
+ * none follows in this command buffer, a small one is added at its end
+ * (kk_mfxt_end). A command buffer that may be submitted again keeps the
+ * command in its queue (a vkCmdUpdateBuffer on KK_MFXT_REPLAY_BUFFER) and
+ * encodes it again when it is recorded again.
+ *
+ * PROBE: whether this GPU has MetalFX's temporal scaler (OK or
+ * UNSUPPORTED), with caps_out, driver_out and max_scale_out written into
+ * the command given. DESTROY: the context's scalers are dropped (work
+ * already encoded keeps them until it has run).
+ *
+ * Flags: RESET, DEPTH_INV (depthReversed, always set: MetalFX's default is
+ * YES), AUTO_EXP or HDR without an exposure texture (auto exposure),
+ * MV_DISPLAY and MV_JITTERED (macOS 27). Sharpening is not done: MetalFX has
+ * none (SHARPEN and sharpness are ignored).
+ *
+ * KK_MFXT=0: every ENCODE and PROBE answers UNSUPPORTED (the game's own
+ * upscaler). KK_MFXT_SCRATCH=1: the output through a private texture and a
+ * copy (bridge/mtl_metalfx.m). */
+
+#include "kk_mfx_temporal.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_format.h"
+#include "kk_image.h"
+
+#include "kosmickrisp/bridge/mtl_metalfx.h"
+
+#include "util/format/u_format.h"
+#include "util/simple_mtx.h"
+#include "vk_cmd_enqueue_entrypoints.h"
+#include "vk_format.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool
+kk_mfxt_enabled(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("KK_MFXT");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+/* One line per reason a context's upscale is refused, the first time. */
+static void
+kk_mfxt_refused(const struct sa_mfxt_cmd *c, uint32_t status, const char *why)
+{
+   static const char *told[32];
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   if (!why)
+      why = "refused";
+   simple_mtx_lock(&lock);
+   unsigned i;
+   for (i = 0; i < ARRAY_SIZE(told) && told[i]; i++)
+      if (told[i] == why)
+         break;
+   bool tell = i < ARRAY_SIZE(told) && !told[i];
+   if (tell)
+      told[i] = why;
+   simple_mtx_unlock(&lock);
+   if (tell)
+      fprintf(stderr,
+              "kk: MetalFX temporal: context %llu %ux%u -> %ux%u: %s (status "
+              "%u): the game's own upscaler\n",
+              (unsigned long long)c->context, c->render_w, c->render_h,
+              c->upscale_w, c->upscale_h, why, status);
+}
+
+static uint32_t
+kk_mfxt_status(enum mtl_metalfx_temporal_status st)
+{
+   switch (st) {
+   case MTL_MFXT_OK:
+      return SA_ST_OK;
+   case MTL_MFXT_BAD_ARGS:
+      return SA_ST_BAD_ARGS;
+   case MTL_MFXT_NO_SCALER:
+      return SA_ST_NO_SCALER;
+   default:
+      return SA_ST_UNSUPPORTED;
+   }
+}
+
+static bool
+kk_mfxt_identity(const struct kk_va_format *va)
+{
+   return va && va->unswizzle.red == PIPE_SWIZZLE_X &&
+          va->unswizzle.green == PIPE_SWIZZLE_Y &&
+          va->unswizzle.blue == PIPE_SWIZZLE_Z &&
+          va->unswizzle.alpha == PIPE_SWIZZLE_W;
+}
+
+/* An image of the command as the bridge takes it. */
+static uint32_t
+kk_mfxt_tex(struct kk_device *dev, const struct sa_mfxt_tex *t, bool depth,
+            struct mtl_metalfx_temporal_tex *out, const char **why)
+{
+   memset(out, 0, sizeof(*out));
+   if (!t->image)
+      return SA_ST_OK;
+
+   struct kk_image *img = kk_image_from_handle((VkImage)(uintptr_t)t->image);
+   if (img->vk.base.type != VK_OBJECT_TYPE_IMAGE ||
+       img->vk.base.device != &dev->vk) {
+      *why = "a handle that is not an image of this device";
+      return SA_ST_BAD_ARGS;
+   }
+   if (img->vk.image_type != VK_IMAGE_TYPE_2D || img->vk.samples != 1 ||
+       img->plane_count != 1) {
+      *why = "an image that is not plain 2D, or multisampled";
+      return SA_ST_UNSUPPORTED;
+   }
+   if (!img->planes[0].mtl_handle) {
+      *why = "an image without memory";
+      return SA_ST_BAD_ARGS;
+   }
+   /* w, h: the image's size as the sender knows it (0: not given). */
+   if (t->w > img->vk.extent.width || t->h > img->vk.extent.height) {
+      *why = "an image smaller than the sender says";
+      return SA_ST_BAD_ARGS;
+   }
+
+   enum pipe_format have = vk_format_to_pipe_format(img->vk.format);
+   if (!kk_mfxt_identity(kk_get_va_format(have))) {
+      *why = "an image format the driver stores swizzled";
+      return SA_ST_UNSUPPORTED;
+   }
+   if (!depth && t->vk_format && t->vk_format != (uint32_t)img->vk.format) {
+      enum pipe_format want = vk_format_to_pipe_format((VkFormat)t->vk_format);
+      const struct kk_va_format *va = kk_get_va_format(want);
+      if (!kk_mfxt_identity(va)) {
+         *why = "a view format the driver stores swizzled";
+         return SA_ST_UNSUPPORTED;
+      }
+      if (!(img->vk.create_flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) ||
+          util_format_get_blocksize(want) != util_format_get_blocksize(have)) {
+         *why = "a view format the image cannot have";
+         return SA_ST_UNSUPPORTED;
+      }
+      out->format = va->mtl_pixel_format;
+   }
+   out->texture = img->planes[0].mtl_handle;
+   out->x = t->x;
+   out->y = t->y;
+   return SA_ST_OK;
+}
+
+static uint32_t
+kk_mfxt_args(struct kk_device *dev, const struct sa_mfxt_cmd *c,
+             struct mtl_metalfx_temporal_args *a, const char **why)
+{
+   const struct sa_mfxt_tex *in[6] = {
+      &c->color, &c->depth, &c->motion, &c->exposure, &c->reactive, &c->output,
+   };
+   struct mtl_metalfx_temporal_tex *out[6] = {
+      &a->color, &a->depth, &a->motion, &a->exposure, &a->reactive, &a->output,
+   };
+   memset(a, 0, sizeof(*a));
+   for (unsigned i = 0; i < 6; i++) {
+      uint32_t st = kk_mfxt_tex(dev, in[i], i == 1, out[i], why);
+      if (st != SA_ST_OK)
+         return st;
+   }
+   if (!a->color.texture || !a->depth.texture || !a->motion.texture ||
+       !a->output.texture) {
+      *why = "colour, depth, motion vectors or output missing";
+      return SA_ST_BAD_ARGS;
+   }
+   a->context = c->context;
+   a->render_w = c->render_w;
+   a->render_h = c->render_h;
+   a->out_w = c->upscale_w;
+   a->out_h = c->upscale_h;
+   a->jitter_x = c->jitter_x;
+   a->jitter_y = c->jitter_y;
+   a->mv_scale_x = c->mv_scale_x;
+   a->mv_scale_y = c->mv_scale_y;
+   a->pre_exposure = c->pre_exposure;
+   a->reset = c->flags & SA_MFXT_RESET;
+   a->depth_reversed = c->flags & SA_MFXT_DEPTH_INV;
+   a->auto_exposure = (c->flags & SA_MFXT_AUTO_EXP) ||
+                      ((c->flags & SA_MFXT_HDR) && !a->exposure.texture);
+   a->mv_display = c->flags & SA_MFXT_MV_DISPLAY;
+   a->mv_jittered = c->flags & SA_MFXT_MV_JITTERED;
+   /* MetalFX ignores the exposure texture with auto exposure: drop it, so
+    * its format cannot refuse the upscale. */
+   if (a->auto_exposure)
+      memset(&a->exposure, 0, sizeof(a->exposure));
+   return SA_ST_OK;
+}
+
+/* The encode itself (also when a command buffer is recorded again). */
+static uint32_t
+kk_mfxt_encode(struct kk_cmd_buffer *cmd, const struct sa_mfxt_cmd *c)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   const char *why = NULL;
+   uint32_t st;
+
+   if (!kk_mfxt_enabled()) {
+      why = "KK_MFXT=0";
+      st = SA_ST_UNSUPPORTED;
+      goto refused;
+   }
+   if (cmd->vk.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY) {
+      why = "a secondary command buffer";
+      st = SA_ST_UNSUPPORTED;
+      goto refused;
+   }
+   /* The application's render pass still going on (a pass it ended whose
+    * encoder is left open, pending_end, is over). */
+   if (gfx->render_pass_descriptor && !gfx->pending_end) {
+      why = "inside a render pass";
+      st = SA_ST_BAD_ARGS;
+      goto refused;
+   }
+   if (cmd->state.cond_render.enabled) {
+      why = "conditional rendering on";
+      st = SA_ST_UNSUPPORTED;
+      goto refused;
+   }
+
+   struct mtl_metalfx_temporal_args args;
+   st = kk_mfxt_args(dev, c, &args, &why);
+   if (st != SA_ST_OK)
+      goto refused;
+   /* Asked before the encoders end: a refusal leaves the command buffer as
+    * it was. */
+   st = kk_mfxt_status(mtl_metalfx_temporal_prepare(
+      dev->mtl_handle, dev->mtl_compiler_handle, &args, &why));
+   if (st != SA_ST_OK)
+      goto refused;
+
+   /* Twice: compute work open beside a pass is closed as well. */
+   cs_end(cmd);
+   cs_end(cmd);
+   mtl_command_buffer *cmd_buf = kk_cmd_buffer_take_gfx_mtl(cmd);
+   st = kk_mfxt_status(mtl_metalfx_temporal_encode(
+      dev->mtl_handle, dev->mtl_compiler_handle, cmd_buf, &args, &why));
+   kk_cmd_buffer_return_gfx_mtl(cmd, cmd_buf);
+   if (st != SA_ST_OK)
+      goto refused;
+   /* The next encoder waits for all that came before it (a queue barrier)
+    * and ends with the producer barrier every encoder ends with. */
+   cmd->after_metalfx = true;
+   return SA_ST_OK;
+
+refused:
+   kk_mfxt_refused(c, st, why);
+   return st;
+}
+
+static uint32_t
+kk_mfxt_probe(struct kk_device *dev, struct sa_mfxt_cmd *c)
+{
+   struct mtl_metalfx_temporal_caps caps;
+   mtl_metalfx_temporal_get_caps(dev->mtl_handle, &caps);
+   c->driver_out = VK_DRIVER_ID_MESA_KOSMICKRISP;
+   if (!kk_mfxt_enabled() || !caps.supported) {
+      c->caps_out = 0;
+      c->max_scale_out = 0.0f;
+      return SA_ST_UNSUPPORTED;
+   }
+   c->caps_out = SA_MFXT_CAP_TEMPORAL |
+                 (caps.mv_display ? SA_MFXT_CAP_MV_DISPLAY : 0) |
+                 (caps.mv_jittered ? SA_MFXT_CAP_MV_JITTERED : 0) |
+                 (caps.offsets ? SA_MFXT_CAP_OFFSETS : 0) |
+                 (caps.reactive ? SA_MFXT_CAP_REACTIVE : 0) |
+                 (mtl_metalfx_temporal_scratch() ? SA_MFXT_CAP_SCRATCH : 0);
+   c->max_scale_out = caps.max_scale;
+   return SA_ST_OK;
+}
+
+PUBLIC uint32_t
+kk_steamarm_upscale_temporal(VkCommandBuffer commandBuffer,
+                             const struct sa_mfxt_cmd *c)
+{
+   if (!commandBuffer || !c || c->magic != SA_MFXT_MAGIC ||
+       c->version != SA_MFXT_VERSION || c->size != sizeof(*c))
+      return SA_ST_BAD_ARGS;
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   switch (c->op) {
+   case SA_OP_PROBE:
+      /* The out fields of the caller's own copy (the shim's): the entry's
+       * one write into the command. */
+      return kk_mfxt_probe(dev, (struct sa_mfxt_cmd *)c);
+   case SA_OP_DESTROY:
+      mtl_metalfx_temporal_destroy(c->context);
+      return SA_ST_OK;
+   case SA_OP_ENCODE:
+      break;
+   default:
+      return SA_ST_BAD_ARGS;
+   }
+
+   uint32_t st = kk_mfxt_encode(cmd, c);
+   /* Recorded again at a second submission (rerecord_cmd_buffer): replayed
+    * from the command queue, through kk_CmdUpdateBuffer. */
+   if (st == SA_ST_OK && !cmd->one_time_submit)
+      vk_cmd_enqueue_CmdUpdateBuffer(commandBuffer, KK_MFXT_REPLAY_BUFFER, 0,
+                                     sizeof(*c), c);
+   return st;
+}
+
+void
+kk_mfxt_replay(struct kk_cmd_buffer *cmd, const void *data, VkDeviceSize size)
+{
+   struct sa_mfxt_cmd c;
+   if (size != sizeof(c))
+      return;
+   memcpy(&c, data, sizeof(c));
+   /* The game saw OK when it recorded this, so it recorded no fallback: a
+    * refusal now leaves the output unwritten for this frame. */
+   if (c.magic == SA_MFXT_MAGIC && c.op == SA_OP_ENCODE) {
+      uint32_t st = kk_mfxt_encode(cmd, &c);
+      if (st != SA_ST_OK)
+         kk_mfxt_refused(&c, st, "re-recorded upscale refused, output left unwritten this frame");
+   }
+}
+
+void
+kk_mfxt_end(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->after_metalfx)
+      return;
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   mtl_command_buffer *cmd_buf = kk_cmd_buffer_take_gfx_mtl(cmd);
+   mtl_metalfx_temporal_tail(dev->mtl_handle, cmd_buf);
+   kk_cmd_buffer_return_gfx_mtl(cmd, cmd_buf);
+   cmd->after_metalfx = false;
+}
diff -ruN a/src/kosmickrisp/vulkan/kk_mfx_temporal.h b/src/kosmickrisp/vulkan/kk_mfx_temporal.h
--- a/src/kosmickrisp/vulkan/kk_mfx_temporal.h	1969-12-31 21:00:00
+++ b/src/kosmickrisp/vulkan/kk_mfx_temporal.h	2026-10-04 21:13:34
@@ -0,0 +1,131 @@
+/*
+ * Copyright 2026 SteamARM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* SteamARM: a temporal upscale (FSR 3.1 / DLSS style) handed to Apple's
+ * MetalFX by the Vulkan shim (SteamARM's shim/mfx_temporal.c), which calls
+ * kk_steamarm_upscale_temporal (kk_mfx_temporal.c) with the command a
+ * Windows FFX DLL recorded as a vkCmdUpdateBuffer.
+ *
+ * The block between the SA_MFX_TEMPORAL_H guards is SteamARM's
+ * shim/mfx_temporal.h protocol, byte for byte the same layout (the same
+ * text): the DLL, the shim and this driver share it. What follows it is
+ * this driver's side. */
+
+#ifndef KK_MFX_TEMPORAL_H
+#define KK_MFX_TEMPORAL_H 1
+
+#ifndef SA_MFX_TEMPORAL_H
+#define SA_MFX_TEMPORAL_H
+
+#include <stdint.h>
+
+#define SA_MFXT_MAGIC 0x5458464D41455453ull   /* "STEAMFXT" */
+#define SA_MFXT_VERSION 1u
+
+enum { SA_OP_PROBE=1, SA_OP_ENCODE=2, SA_OP_DESTROY=3 };
+enum { SA_ST_UNSEEN=0, SA_ST_OK=1, SA_ST_NO_DRIVER, SA_ST_BAD_ARGS, SA_ST_UNSUPPORTED, SA_ST_NO_SCALER };
+
+/* sa_mfxt_cmd.flags */
+#define SA_MFXT_RESET        1u
+#define SA_MFXT_DEPTH_INV    2u
+#define SA_MFXT_AUTO_EXP     4u
+#define SA_MFXT_MV_DISPLAY   8u
+#define SA_MFXT_MV_JITTERED 16u
+#define SA_MFXT_HDR         32u
+#define SA_MFXT_SHARPEN     64u
+
+struct sa_mfxt_tex { uint64_t image; uint32_t vk_format, w, h, x, y, flags; };      /* 32 B */
+struct sa_mfxt_cmd {
+  uint64_t magic; uint32_t version, size, op, status /* written back */; uint64_t context;
+  struct sa_mfxt_tex color, depth, motion, exposure, reactive, output;             /* image 0 = absent */
+  uint32_t render_w, render_h, upscale_w, upscale_h;
+  float jitter_x, jitter_y, mv_scale_x, mv_scale_y, pre_exposure, sharpness;
+  uint32_t flags;   /* RESET 1, DEPTH_INV 2, AUTO_EXP 4, MV_DISPLAY 8, MV_JITTERED 16, HDR 32, SHARPEN 64 */
+  uint32_t caps_out, driver_out; float max_scale_out; uint32_t reserved[10];       /* pad to 320 */
+};
+
+#define SA_MFXT_STATUS_OFFSET 20u   /* offsetof(struct sa_mfxt_cmd, status) */
+
+_Static_assert(sizeof(struct sa_mfxt_tex) == 32, "sa_mfxt_tex is 32 bytes");
+_Static_assert(sizeof(struct sa_mfxt_cmd) == 320, "sa_mfxt_cmd is 320 bytes");
+_Static_assert(__builtin_offsetof(struct sa_mfxt_cmd, status) == SA_MFXT_STATUS_OFFSET, "status at 20");
+_Static_assert(__builtin_offsetof(struct sa_mfxt_cmd, color) == 32, "textures at 32");
+_Static_assert(__builtin_offsetof(struct sa_mfxt_cmd, render_w) == 224, "sizes at 224");
+
+/* The KosmicKrisp entry (default visibility in the driver), found by the
+   shim with lxrt_host_dlsym on the driver's handle; returns an SA_ST_*. */
+#define SA_MFXT_KK_ENTRY "kk_steamarm_upscale_temporal"
+
+#endif
+
+#include <stddef.h>
+
+/* Every field where the DLL and the shim put it (the layout above is the
+ * contract: a field moved is a different protocol). */
+_Static_assert(offsetof(struct sa_mfxt_tex, image) == 0, "tex.image");
+_Static_assert(offsetof(struct sa_mfxt_tex, vk_format) == 8, "tex.vk_format");
+_Static_assert(offsetof(struct sa_mfxt_tex, w) == 12, "tex.w");
+_Static_assert(offsetof(struct sa_mfxt_tex, h) == 16, "tex.h");
+_Static_assert(offsetof(struct sa_mfxt_tex, x) == 20, "tex.x");
+_Static_assert(offsetof(struct sa_mfxt_tex, y) == 24, "tex.y");
+_Static_assert(offsetof(struct sa_mfxt_tex, flags) == 28, "tex.flags");
+_Static_assert(offsetof(struct sa_mfxt_cmd, magic) == 0, "magic");
+_Static_assert(offsetof(struct sa_mfxt_cmd, version) == 8, "version");
+_Static_assert(offsetof(struct sa_mfxt_cmd, size) == 12, "size");
+_Static_assert(offsetof(struct sa_mfxt_cmd, op) == 16, "op");
+_Static_assert(offsetof(struct sa_mfxt_cmd, context) == 24, "context");
+_Static_assert(offsetof(struct sa_mfxt_cmd, depth) == 64, "depth");
+_Static_assert(offsetof(struct sa_mfxt_cmd, motion) == 96, "motion");
+_Static_assert(offsetof(struct sa_mfxt_cmd, exposure) == 128, "exposure");
+_Static_assert(offsetof(struct sa_mfxt_cmd, reactive) == 160, "reactive");
+_Static_assert(offsetof(struct sa_mfxt_cmd, output) == 192, "output");
+_Static_assert(offsetof(struct sa_mfxt_cmd, render_h) == 228, "render_h");
+_Static_assert(offsetof(struct sa_mfxt_cmd, upscale_w) == 232, "upscale_w");
+_Static_assert(offsetof(struct sa_mfxt_cmd, upscale_h) == 236, "upscale_h");
+_Static_assert(offsetof(struct sa_mfxt_cmd, jitter_x) == 240, "jitter_x");
+_Static_assert(offsetof(struct sa_mfxt_cmd, jitter_y) == 244, "jitter_y");
+_Static_assert(offsetof(struct sa_mfxt_cmd, mv_scale_x) == 248, "mv_scale_x");
+_Static_assert(offsetof(struct sa_mfxt_cmd, mv_scale_y) == 252, "mv_scale_y");
+_Static_assert(offsetof(struct sa_mfxt_cmd, pre_exposure) == 256, "pre_exposure");
+_Static_assert(offsetof(struct sa_mfxt_cmd, sharpness) == 260, "sharpness");
+_Static_assert(offsetof(struct sa_mfxt_cmd, flags) == 264, "flags");
+_Static_assert(offsetof(struct sa_mfxt_cmd, caps_out) == 268, "caps_out");
+_Static_assert(offsetof(struct sa_mfxt_cmd, driver_out) == 272, "driver_out");
+_Static_assert(offsetof(struct sa_mfxt_cmd, max_scale_out) == 276, "max_scale_out");
+_Static_assert(offsetof(struct sa_mfxt_cmd, reserved) == 280, "reserved");
+
+/* What PROBE writes into the command it is given (caps_out, driver_out,
+ * max_scale_out; the shim passes its own copy, which it may copy back to
+ * the sender's data with the status). caps_out bits: */
+#define SA_MFXT_CAP_TEMPORAL    1u  /* MetalFX's temporal scaler (Metal 4) on this GPU */
+#define SA_MFXT_CAP_MV_DISPLAY  2u  /* motion vectors at the output's size (macOS 27) */
+#define SA_MFXT_CAP_MV_JITTERED 4u  /* motion vectors with the jitter in them (macOS 27) */
+#define SA_MFXT_CAP_OFFSETS     8u  /* sa_mfxt_tex.x/y: content not at the origin (macOS 27) */
+#define SA_MFXT_CAP_REACTIVE   16u  /* a reactive mask */
+#define SA_MFXT_CAP_SCRATCH    32u  /* the output goes through a private texture and a copy */
+/* driver_out: VK_DRIVER_ID_MESA_KOSMICKRISP (28); max_scale_out: the
+ * largest output / render size MetalFX takes on each side (3.0 on an M4). */
+
+#include <vulkan/vulkan_core.h>
+
+/* Returns an SA_ST_*. Never called by the application: see above. */
+uint32_t kk_steamarm_upscale_temporal(VkCommandBuffer commandBuffer,
+                                      const struct sa_mfxt_cmd *cmd);
+
+struct kk_cmd_buffer;
+
+/* The destination buffer of the vkCmdUpdateBuffer an encode leaves in the
+ * command queue of a command buffer that may be submitted again: replayed
+ * (rerecord_cmd_buffer), kk_CmdUpdateBuffer hands it back here. Not an
+ * address any buffer can have. */
+#define KK_MFXT_REPLAY_BUFFER ((VkBuffer)(uintptr_t)0xFFFF534D46580001ull)
+void kk_mfxt_replay(struct kk_cmd_buffer *cmd, const void *data,
+                    VkDeviceSize size);
+
+/* The command buffer ends with MetalFX's work the last in it
+ * (after_metalfx still set): work in later command buffers waits for it. */
+void kk_mfxt_end(struct kk_cmd_buffer *cmd);
+
+#endif /* KK_MFX_TEMPORAL_H */
