+static int rl_presentation_mode(void);
+
+/* A game covering a display, on top of the X stack, while this application
+ * is the active one: its overlay goes above the menu bar and the Dock
+ * (XQUARTZ_RL_PRESENTATION cover, the default). Hiding them through the
+ * application's presentation options instead made the window server stop
+ * compositing the overlay (HideDock|HideMenuBar: the plain desktop where the
+ * game was) or show its frames out of order (AutoHide: the picture jumped
+ * back and forth); with neither, the game was fluid under the Dock (MEASURED
+ * with the user, 2026-10-03, Counter-Strike 2). The overlay then takes the
+ * pointer itself -- X11Application sends its events to X -- or a click at
+ * the bottom of the game would land on the Dock hidden under it. */
+static BOOL
+rl_covering(XQRemoteLayerWindow *w)
+{
+    return rl_presentation_mode() == 3 && w.coversScreen && w.top && NSApp.active;
+}
+
 static NSInteger
 rl_level(XQRemoteLayerWindow *w)
 {
     static int on = -1;
     if (on < 0)
         on = rl_switch("XQUARTZ_RL_LEVEL", 1);
+    if (rl_covering(w))
+        return NSMainMenuWindowLevel + 2;   /* above the menu bar's status items too */
     return w.baseLevel + (on && w.top && NSApp.active ? 1 : 0);
 }
 
+/* A covering overlay is one column wider than its display, the column off
+ * its edge (one with no other display next to it): a window that covers a
+ * display exactly is taken by the window server for a fullscreen one, and
+ * then the layer it hosts from the game's process is not drawn at all -- the
+ * desktop, grey, where the game was, whatever its level or opacity. One
+ * column short worked but showed the X window under it, a white line; one
+ * column over shows nothing (MEASURED with the user, 2026-10-03).
+ * XQUARTZ_RL_OUTSET: columns (default 1; 0 covers the display exactly). */
+static NSRect
+rl_cover_frame(XQRemoteLayerWindow *w, NSRect r)
+{
+    static int outset = -1;
+    if (outset < 0) {
+        const char *e = getenv("XQUARTZ_RL_OUTSET");
+        outset = e && e[0] ? atoi(e) : 1;
+        if (outset < 0 || outset > 64)
+            outset = 1;
+    }
+    if (!outset || !w.coversScreen || rl_presentation_mode() != 3)
+        return r;
+    BOOL left = NO, right = NO;
+    for (NSScreen *sc in NSScreen.screens) {
+        NSRect f = sc.frame;
+        if (NSEqualRects(f, r))
+            continue;
+        if (NSMaxX(f) == NSMinX(r) && NSMaxY(f) > NSMinY(r) && NSMinY(f) < NSMaxY(r))
+            left = YES;
+        if (NSMinX(f) == NSMaxX(r) && NSMaxY(f) > NSMinY(r) && NSMinY(f) < NSMaxY(r))
+            right = YES;
+    }
+    if (!left) {
+        r.origin.x -= outset;
+        r.size.width += outset;
+    } else if (!right)
+        r.size.width += outset;
+    else {
+        /* Displays on both sides: the column goes off the top instead. */
+        r.size.height += outset;
+    }
+    return r;
+}
+
+/* The level and whether the overlay takes the pointer go together. */
 static void
+rl_set_level(XQRemoteLayerWindow *w)
+{
+    NSInteger level = rl_level(w);
+    if (w.level != level)
+        w.level = level;
+    BOOL ignore = !rl_covering(w);
+    if (w.ignoresMouseEvents != ignore)
+        w.ignoresMouseEvents = ignore;
+}
+
+/* For X11Application: pointer events in a covering overlay are the X
+ * window's under it. */
+int
+XQRemoteLayerIsOverlay(id window)
+{
+    return [window isKindOfClass:XQRemoteLayerWindow.class];
+}
+
