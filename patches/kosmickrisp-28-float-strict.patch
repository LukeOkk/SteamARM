     */
    rename_main_entrypoint(shader);
 
+   if (options->float_strict != MSL_FLOAT_STRICT_FULL)
+      msl_relax_float_controls(shader, options->float_strict);
+
    struct nir_to_msl_ctx ctx = {
       .shader = shader,
       .text = _mesa_string_buffer_create(options->mem_ctx, 1024),
-      .disabled_workarounds = options->disabled_workarounds,
+      /* KK_WORKAROUND_14 only keeps NaNs: with none to keep, no guards. */
+      .disabled_workarounds =
+         options->disabled_workarounds |
+         (options->float_strict == MSL_FLOAT_STRICT_FAST ? BITFIELD64_BIT(14)
+                                                         : 0),
    };
    nir_function_impl *impl = nir_shader_get_entrypoint(shader);
    msl_gather_info(&ctx, options);
