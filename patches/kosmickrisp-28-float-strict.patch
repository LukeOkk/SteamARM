+/* SteamARM: how much of the application's SignedZeroInfNanPreserve the MSL of
+ * a stage keeps (KK_FLOAT_STRICT, kk_physical_device.c). `stage` is the
+ * application's: a vertex shader run as a compute kernel before tessellation
+ * or a geometry shader is still a vertex shader. Only compute shaders and
+ * fragment shaders that do not write depth are relaxed. Whatever computes a
+ * position must compute it the same way in every pipeline it is linked into:
+ * a depth prepass and a colour pass with depth test EQUAL miss every pixel
+ * where the two round differently (patch 18), and relaxed arithmetic leaves
+ * Metal's compiler free to fuse and reorder it differently each time. */
+static enum msl_float_strict
+kk_stage_float_strict(const struct kk_device *dev, mesa_shader_stage stage,
+                      const nir_shader *nir)
+{
+   enum msl_float_strict strict =
+      (enum msl_float_strict)kk_device_physical(dev)->float_strict;
+   if (stage == MESA_SHADER_COMPUTE)
+      return strict;
+   if (stage == MESA_SHADER_FRAGMENT &&
+       !(nir->info.outputs_written & BITFIELD64_BIT(FRAG_RESULT_DEPTH)))
+      return strict;
+   return MSL_FLOAT_STRICT_FULL;
+}
