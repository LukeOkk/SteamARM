+/* SteamARM: KK_FLOAT_STRICT below full. An instruction's
+ * SignedZeroInfNanPreserve is honoured from its fp_math_ctrl as it is
+ * printed: precise:: functions, a relaxed math block, signed-zero fmin/fmax,
+ * the lerp and fract written out, KK_WORKAROUND_14's guard on multiplies.
+ * Here, after every NIR optimisation has run with the flags, they are
+ * dropped: "nan" keeps the Inf/NaN ones on float compares, fmin/fmax and
+ * isfinite/isnormal, "fast" none (and its caller drops KK_WORKAROUND_14's
+ * isnan guards on compares too). NoContraction (nir_fp_exact) stays. */
+static void
+msl_relax_float_controls(nir_shader *shader, enum msl_float_strict strict)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_alu)
+               continue;
+            nir_alu_instr *alu = nir_instr_as_alu(instr);
+            unsigned keep = 0;
+            if (strict == MSL_FLOAT_STRICT_NAN) {
+               switch (alu->op) {
+               case nir_op_flt:
+               case nir_op_fge:
+               case nir_op_feq:
+               case nir_op_fneu:
+               case nir_op_fmin:
+               case nir_op_fmax:
+               case nir_op_fisfinite:
+               case nir_op_fisnormal:
+                  keep = nir_fp_preserve_inf | nir_fp_preserve_nan;
+                  break;
+               default:
+                  break;
+               }
+            }
+            alu->fp_math_ctrl &= ~(nir_fp_preserve_sz_inf_nan & ~keep);
+         }
+      }
+   }
+}
+
