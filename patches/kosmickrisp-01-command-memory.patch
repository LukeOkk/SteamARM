+void
+kk_device_init_cmd_mem(struct kk_device *dev)
+{
+   simple_mtx_init(&dev->cmd_mem.lock, mtx_plain);
+   dev->cmd_mem.idle_count = 0;
+   dev->cmd_mem.free_slots = NULL;
+   dev->cmd_mem.in_flight = 0;
+}
+
+mtl_command_allocator *
+kk_device_get_allocator(struct kk_device *dev)
+{
+   mtl_command_allocator *allocator = NULL;
+
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   if (dev->cmd_mem.idle_count > 0)
+      allocator = dev->cmd_mem.idle[--dev->cmd_mem.idle_count];
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+
+   return allocator ? allocator : mtl_new_command_allocator(dev->mtl_handle);
+}
+
+/* Every command buffer begun with `allocator` has finished on the GPU, or was
+ * never committed. */
+void
+kk_device_put_allocator(struct kk_device *dev, mtl_command_allocator *allocator)
+{
+   mtl_command_allocator_reset(allocator);
+
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   if (dev->cmd_mem.idle_count < KK_ALLOCATOR_POOL_SIZE) {
+      /* Last in, first out: the allocator whose memory is warm goes next. */
+      dev->cmd_mem.idle[dev->cmd_mem.idle_count++] = allocator;
+      allocator = NULL;
+   }
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+
+   if (allocator)
+      mtl_release(allocator);
+}
+
+static void
+kk_retire_slot_done(struct mtl_feedback_data *data)
+{
+   struct kk_retire_slot *slot = data->user_data;
+   struct kk_device *dev = slot->dev;
+
+   if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
+      vk_device_set_lost(
+         &dev->vk, "Command queue error: %s, with message \"%s\"",
+         mtl_command_queue_error_to_string(data->error), data->error_message);
+   }
+
+   util_dynarray_foreach(&slot->cmd_bufs, mtl_command_buffer *, cmd_buf) {
+      mtl_release(*cmd_buf);
+   }
+   util_dynarray_clear(&slot->cmd_bufs);
+
+   util_dynarray_foreach(&slot->allocators, mtl_command_allocator *, allocator) {
+      kk_device_put_allocator(dev, *allocator);
+   }
+   util_dynarray_clear(&slot->allocators);
+
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   slot->next = dev->cmd_mem.free_slots;
+   dev->cmd_mem.free_slots = slot;
+   dev->cmd_mem.in_flight--;
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+}
+
+/* A slot for one commit, counted as in flight until its handler has run.
+ * NULL if there is no memory for one. */
+struct kk_retire_slot *
+kk_device_get_retire_slot(struct kk_device *dev)
+{
+   struct kk_retire_slot *slot;
+
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   slot = dev->cmd_mem.free_slots;
+   if (slot)
+      dev->cmd_mem.free_slots = slot->next;
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+
+   if (!slot) {
+      slot = vk_zalloc(&dev->vk.alloc, sizeof(*slot), 8,
+                       VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+      if (!slot)
+         return NULL;
+      slot->dev = dev;
+      slot->cmd_bufs = UTIL_DYNARRAY_INIT;
+      slot->allocators = UTIL_DYNARRAY_INIT;
+   }
+
+   /* Options with exactly one handler, for exactly one commit. The options
+    * of the slot's last commit are released only now, long after their
+    * handler returned. */
+   if (slot->options)
+      mtl_release(slot->options);
+   slot->options = mtl_new_commit_options();
+   if (!slot->options) {
+      util_dynarray_fini(&slot->cmd_bufs);
+      util_dynarray_fini(&slot->allocators);
+      vk_free(&dev->vk.alloc, slot);
+      return NULL;
+   }
+   mtl_commit_options_add_feedback_handler(slot->options, kk_retire_slot_done,
+                                           slot);
+
+   slot->next = NULL;
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   dev->cmd_mem.in_flight++;
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+
+   return slot;
+}
+
+void
+kk_device_finish_cmd_mem(struct kk_device *dev)
+{
+   /* The application has waited for its submissions; their feedback handlers
+    * run on Metal's thread a moment later. */
+   for (unsigned tries = 0; tries < 400; tries++) {
+      simple_mtx_lock(&dev->cmd_mem.lock);
+      uint32_t in_flight = dev->cmd_mem.in_flight;
+      simple_mtx_unlock(&dev->cmd_mem.lock);
+      if (!in_flight)
+         break;
+      struct timespec ts = {.tv_nsec = 5 * 1000 * 1000};
+      nanosleep(&ts, NULL);
+   }
+
+   simple_mtx_lock(&dev->cmd_mem.lock);
+   for (uint32_t i = 0; i < dev->cmd_mem.idle_count; i++)
+      mtl_release(dev->cmd_mem.idle[i]);
+   dev->cmd_mem.idle_count = 0;
+   struct kk_retire_slot *slot = dev->cmd_mem.free_slots;
+   dev->cmd_mem.free_slots = NULL;
+   simple_mtx_unlock(&dev->cmd_mem.lock);
+
+   while (slot) {
+      struct kk_retire_slot *next = slot->next;
+      if (slot->options)
+         mtl_release(slot->options);
+      util_dynarray_fini(&slot->cmd_bufs);
+      util_dynarray_fini(&slot->allocators);
+      vk_free(&dev->vk.alloc, slot);
+      slot = next;
+   }
+
+   simple_mtx_destroy(&dev->cmd_mem.lock);
+}
