+/* Occlusion results live in one visibility buffer per device, which Metal
+ * limits to 256 KB: KK_MAX_OCCLUSION_QUERIES slots for every pool together.
+ * A pool used to take a slot for each of its queries when it was created, so
+ * the third pool of 16384 queries failed -- Source 2 creates them that size
+ * and uses a few queries of each (Counter-Strike 2 then died in
+ * kk_CmdBeginQuery on the pool it never got; MEASURED). A query now takes its
+ * slot when it is first begun and gives it back when it is reset; until then
+ * its index is the device's scratch slot, which the reset and copy shaders
+ * may read and write like any other.
+ */
 static void
+kk_oq_release_slots(struct kk_device *dev, struct kk_query_pool *pool,
+                    uint32_t first_query, uint32_t num_queries)
+{
+   uint16_t *remap_index = kk_pool_index_ptr(pool);
+
+   for (uint32_t i = first_query; i < first_query + num_queries; i++) {
+      if (remap_index[i] == dev->oq_scratch)
+         continue;
+      kk_query_table_remove(dev, &dev->occlusion_queries, remap_index[i]);
+      remap_index[i] = dev->oq_scratch;
+   }
+}
