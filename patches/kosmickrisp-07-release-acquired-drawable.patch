+   /* An image acquired and never presented still holds its drawable (the
+    * retain of wsi_metal_layer_acquire_drawable is given up only by a
+    * present). Destroying such a swapchain leaked one drawable of the
+    * layer's pool each time: a game that remade its swapchain twice with an
+    * image in hand -- SteamARM's mailbox keeps one acquired -- then found no
+    * drawable at all (nextDrawable's one-second timeout at every frame). */
+   if (metal_image->drawable) {
+      wsi_metal_release_drawable(metal_image->drawable);
+      metal_image->drawable = NULL;
+   }
