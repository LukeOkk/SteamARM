 libartbase/base/globals.h | 45 +++++++++++++++++++++++++++++++++++++++
 libartbase/base/utils.h   | 11 ++++++++--
 3 files changed, 81 insertions(+), 3 deletions(-)

diff --git a/build/art.go b/build/art.go
index bf3e488..47aa788 100644
--- a/build/art.go
+++ b/build/art.go
@@ -60,6 +60,15 @@ func globalFlags(ctx android.LoadHookContext) ([]string, []string) {
 		cflags = append(cflags, "-DART_USE_CXX_INTERPRETER=1")
 	}
 
+	// SteamARM (HYPOTHESIS, UNTESTED): ART_HEAP_REFERENCE_BASE, a hex number
+	// such as 0x4000000000, moves the managed heap from the low 4 GiB to
+	// [base, base + 4 GiB). The arm64 code generator emits that base on the
+	// host and on the device; the device runtime uses it too (deviceFlags,
+	// deviceAsflags). Unset: upstream behaviour.
+	if heapBase := ctx.Config().Getenv("ART_HEAP_REFERENCE_BASE"); heapBase != "" {
+		cflags = append(cflags, "-DART_TARGET_HEAP_REFERENCE_BASE="+heapBase)
+	}
+
 	if !ctx.Config().IsEnvFalse("ART_USE_READ_BARRIER") && ctx.Config().ArtUseReadBarrier() {
 		// Used to change the read barrier type. Valid values are BAKER, BROOKS,
 		// TABLELOOKUP. The default is BAKER.
@@ -142,9 +151,24 @@ func deviceFlags(ctx android.LoadHookContext) []string {
 	cflags = append(cflags, "-DART_BASE_ADDRESS_MIN_DELTA="+minDelta)
 	cflags = append(cflags, "-DART_BASE_ADDRESS_MAX_DELTA="+maxDelta)
 
+	// SteamARM: the runtime's heap reference base (see globalFlags). Device
+	// only: dex2oat on the build host keeps its own heap in the low 4 GiB.
+	if heapBase := ctx.Config().Getenv("ART_HEAP_REFERENCE_BASE"); heapBase != "" {
+		cflags = append(cflags, "-DART_HEAP_REFERENCE_BASE="+heapBase)
+	}
+
 	return cflags
 }
 
+// SteamARM: the same definition for the runtime's assembly (entrypoints, mterp).
+func deviceAsflags(ctx android.LoadHookContext) []string {
+	var asflags []string
+	if heapBase := ctx.Config().Getenv("ART_HEAP_REFERENCE_BASE"); heapBase != "" {
+		asflags = append(asflags, "-DART_HEAP_REFERENCE_BASE="+heapBase)
+	}
+	return asflags
+}
+
 func hostFlags(ctx android.LoadHookContext) []string {
 	var cflags []string
 	hostFrameSizeLimit := 1736
@@ -181,7 +205,8 @@ func globalDefaults(ctx android.LoadHookContext) {
 	type props struct {
 		Target struct {
 			Android struct {
-				Cflags []string
+				Cflags  []string
+				Asflags []string
 			}
 			Host struct {
 				Cflags []string
@@ -197,6 +222,7 @@ func globalDefaults(ctx android.LoadHookContext) {
 	p := &props{}
 	p.Cflags, p.Asflags = globalFlags(ctx)
 	p.Target.Android.Cflags = deviceFlags(ctx)
+	p.Target.Android.Asflags = deviceAsflags(ctx)
 	p.Target.Host.Cflags = hostFlags(ctx)
 
 	if ctx.Config().IsEnvTrue("ART_DEX_FILE_ACCESS_TRACKING") {
diff --git a/libartbase/base/globals.h b/libartbase/base/globals.h
index 97eae63..d3e5e0c 100644
--- a/libartbase/base/globals.h
+++ b/libartbase/base/globals.h
@@ -95,6 +95,51 @@ static constexpr bool kIsTargetFuchsia = false;
 # endif
 #endif
 
+// SteamARM (HYPOTHESIS, UNTESTED; docs/ART_HEAP_ABOVE_4GB.md in SteamARM).
+// The base of the 4 GiB window that holds every object, and everything else a
+// 32-bit compressed reference can name (boot image, heap spaces, JIT data).
+// A compressed reference stays the low 32 bits of the address; it is
+// decompressed by ORing the base back in, and 0 stays null. Upstream ART has
+// base 0: its heap must be in the low 4 GiB, which an arm64 macOS process
+// cannot map (__PAGEZERO). The base must be 4 GiB-aligned, so that the 32-bit
+// store of a pointer's low half is the compression, and a single bit, so that
+// arm64 code applies it with one ORR (a logical immediate). Nothing may be
+// mapped in [base, base + 64 KiB): an object there would compress to a value
+// below 64 KiB, and a stale upper half would dereference into it.
+//
+// kHeapReferenceBase is what this runtime uses. kTargetHeapReferenceBase is
+// what the arm64 code generator emits: dex2oat on an x86-64 build host
+// generates device code while its own runtime keeps base 0.
+#if defined(__LP64__) && defined(ART_HEAP_REFERENCE_BASE)
+static constexpr uint64_t kHeapReferenceBase = ART_HEAP_REFERENCE_BASE;
+#else
+static constexpr uint64_t kHeapReferenceBase = 0u;
+#endif
+#if defined(ART_TARGET_HEAP_REFERENCE_BASE)
+static constexpr uint64_t kTargetHeapReferenceBase = ART_TARGET_HEAP_REFERENCE_BASE;
+#else
+static constexpr uint64_t kTargetHeapReferenceBase = kHeapReferenceBase;
+#endif
+static_assert((kHeapReferenceBase & UINT64_C(0xFFFFFFFF)) == 0u &&
+                  (kHeapReferenceBase & (kHeapReferenceBase - 1u)) == 0u &&
+                  kHeapReferenceBase < (UINT64_C(1) << 47),
+              "The heap reference base is 0 or a single bit from 2^32 to 2^46");
+static_assert((kTargetHeapReferenceBase & UINT64_C(0xFFFFFFFF)) == 0u &&
+                  (kTargetHeapReferenceBase & (kTargetHeapReferenceBase - 1u)) == 0u &&
+                  kTargetHeapReferenceBase < (UINT64_C(1) << 47),
+              "The target heap reference base is 0 or a single bit from 2^32 to 2^46");
+
+// The compressed form of an address in the window (its low 32 bits) and back.
+static constexpr uint32_t CompressHeapAddress(uint64_t address) {
+  return static_cast<uint32_t>(address);
+}
+static constexpr uint64_t DecompressHeapAddress(uint32_t compressed) {
+  return compressed == 0u ? UINT64_C(0) : (kHeapReferenceBase | compressed);
+}
+static constexpr bool IsInHeapReferenceWindow(uint64_t address) {
+  return (address & ~UINT64_C(0xFFFFFFFF)) == kHeapReferenceBase;
+}
+
 // Additional statically-linked ART binaries (dex2oats, oatdumps, etc.) are
 // always available on the host
 #if !defined(ART_TARGET)
diff --git a/libartbase/base/utils.h b/libartbase/base/utils.h
index 4bcb915..49ef547 100644
--- a/libartbase/base/utils.h
+++ b/libartbase/base/utils.h
@@ -33,10 +33,17 @@
 
 namespace art {
 
+// SteamARM: "low memory" is the heap reference window (the low 4 GiB when
+// kHeapReferenceBase is 0), and the result is the compressed address.
 static inline uint32_t PointerToLowMemUInt32(const void* p) {
   uintptr_t intp = reinterpret_cast<uintptr_t>(p);
-  DCHECK_LE(intp, 0xFFFFFFFFU);
-  return intp & 0xFFFFFFFFU;
+  DCHECK(intp == 0u || IsInHeapReferenceWindow(intp)) << p;
+  return CompressHeapAddress(intp);
+}
+
+// SteamARM: the inverse of PointerToLowMemUInt32(); 0 stays null.
+static inline void* LowMemUInt32ToPointer(uint32_t value) {
+  return reinterpret_cast<void*>(static_cast<uintptr_t>(DecompressHeapAddress(value)));
 }
 
 // Returns a human-readable size string such as "1MB".
