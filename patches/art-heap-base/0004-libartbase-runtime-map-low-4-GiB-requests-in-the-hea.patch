From b6287ee3d6195943e19b8aa6bcf8d5d788ceb639 Mon Sep 17 00:00:00 2001
From: LukeOkk <85941941+LukeOkk@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:08:32 -0300
Subject: [PATCH 4/9] libartbase, runtime: map "low 4 GiB" requests in the heap
 reference window (SteamARM, HYPOTHESIS)

HYPOTHESIS, UNTESTED: not compiled, not run.

Every heap space, the boot image reservation, the large object space and
the JIT code cache ask MemMap for low_4gb memory (14 call sites). On arm64
ART serves them with its own linear allocator, which probes the low 4 GiB
with msync() from LOW_MEM_START (64 KiB). An arm64 macOS process has
__PAGEZERO there, so the probe never finds space and ART aborts with
"Could not find contiguous low-memory space" (SteamARM
benchmarks/stage25-android-userspace.txt).

The allocator now scans [kHeapReferenceBase + 64 KiB, kHeapReferenceBase +
4 GiB), rejects results below or above that window, and MapInternal()'s
range check for low_4gb requests with an address checks the window. The
call sites are unchanged.

The card table covers the window instead of the low 4 GiB (compiled code
and art_quick_aput_obj index it with full addresses). The sentinel fault
page, a fixed address below 4 GiB, is no longer a low_4gb request when the
base is non-zero.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01L6ANQQienC2qRCeZBzUfuS
---
 libartbase/base/mem_map.cc | 20 +++++++++++++-------
 runtime/gc/heap.cc         |  7 +++++--
 runtime/runtime.cc         |  4 +++-
 3 files changed, 21 insertions(+), 10 deletions(-)

diff --git a/libartbase/base/mem_map.cc b/libartbase/base/mem_map.cc
index 03e8218..ae54522 100644
--- a/libartbase/base/mem_map.cc
+++ b/libartbase/base/mem_map.cc
@@ -94,7 +94,10 @@ std::mutex* MemMap::mem_maps_lock_ = nullptr;
 // Handling mem_map in 32b address range for 64b architectures that do not support MAP_32BIT.
 
 // The regular start of memory allocations. The first 64KB is protected by SELinux.
-static constexpr uintptr_t LOW_MEM_START = 64 * KB;
+// SteamARM: "low memory" is the heap reference window [kHeapReferenceBase, +4 GiB)
+// (the low 4 GiB when the base is 0). Its first 64 KiB stay unmapped.
+static constexpr uintptr_t LOW_MEM_START = kHeapReferenceBase + 64 * KB;
+static constexpr uintptr_t LOW_MEM_END = kHeapReferenceBase + 4 * GB;
 
 // Generate random starting position.
 // To not interfere with image position, take the image's address and only place it below. Current
@@ -265,7 +268,9 @@ void* MemMap::TryMemMapLow4GB(void* ptr,
   if (actual != MAP_FAILED) {
     // Since we didn't use MAP_FIXED the kernel may have mapped it somewhere not in the low
     // 4GB. If this is the case, unmap and retry.
-    if (reinterpret_cast<uintptr_t>(actual) + page_aligned_byte_count >= 4 * GB) {
+    // SteamARM: outside the window, below it included (a kernel that ignores the hint).
+    if (reinterpret_cast<uintptr_t>(actual) < LOW_MEM_START ||
+        reinterpret_cast<uintptr_t>(actual) + page_aligned_byte_count >= LOW_MEM_END) {
       TargetMUnmap(actual, page_aligned_byte_count);
       actual = MAP_FAILED;
     }
@@ -1044,7 +1049,7 @@ void* MemMap::MapInternalArtLow4GBAllocator(size_t length,
   bool first_run = true;
 
   std::lock_guard<std::mutex> mu(*mem_maps_lock_);
-  for (uintptr_t ptr = next_mem_pos_; ptr < 4 * GB; ptr += kPageSize) {
+  for (uintptr_t ptr = next_mem_pos_; ptr < LOW_MEM_END; ptr += kPageSize) {
     // Use gMaps as an optimization to skip over large maps.
     // Find the first map which is address > ptr.
     auto it = gMaps->upper_bound(reinterpret_cast<void*>(ptr));
@@ -1075,7 +1080,7 @@ void* MemMap::MapInternalArtLow4GBAllocator(size_t length,
       return actual;
     }
 
-    if (4U * GB - ptr < length) {
+    if (LOW_MEM_END - ptr < length) {
       // Not enough memory until 4GB.
       if (first_run) {
         // Try another time from the bottom;
@@ -1136,11 +1141,12 @@ void* MemMap::MapInternal(void* addr,
 #ifdef __LP64__
   // When requesting low_4g memory and having an expectation, the requested range should fit into
   // 4GB.
-  if (low_4gb && (
+  // SteamARM: into the heap reference window (the low 4 GiB when the base is 0).
+  if (low_4gb && addr != nullptr && (
       // Start out of bounds.
-      (reinterpret_cast<uintptr_t>(addr) >> 32) != 0 ||
+      !IsInHeapReferenceWindow(reinterpret_cast<uintptr_t>(addr)) ||
       // End out of bounds. For simplicity, this will fail for the last page of memory.
-      ((reinterpret_cast<uintptr_t>(addr) + length) >> 32) != 0)) {
+      !IsInHeapReferenceWindow(reinterpret_cast<uintptr_t>(addr) + length))) {
     LOG(ERROR) << "The requested address space (" << addr << ", "
                << reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(addr) + length)
                << ") cannot fit in low_4gb";
diff --git a/runtime/gc/heap.cc b/runtime/gc/heap.cc
index be3b7f8..485cbd0 100644
--- a/runtime/gc/heap.cc
+++ b/runtime/gc/heap.cc
@@ -627,8 +627,11 @@ Heap::Heap(size_t initial_size,
   // Start at 4 KB, we can be sure there are no spaces mapped this low since the address range is
   // reserved by the kernel.
   static constexpr size_t kMinHeapAddress = 4 * KB;
-  card_table_.reset(accounting::CardTable::Create(reinterpret_cast<uint8_t*>(kMinHeapAddress),
-                                                  4 * GB - kMinHeapAddress));
+  // SteamARM: the heap reference window, not the low 4 GiB. Compiled code and
+  // art_quick_aput_obj index the table with the object's full address.
+  card_table_.reset(accounting::CardTable::Create(
+      reinterpret_cast<uint8_t*>(static_cast<uintptr_t>(kHeapReferenceBase) + kMinHeapAddress),
+      4 * GB - kMinHeapAddress));
   CHECK(card_table_.get() != nullptr) << "Failed to create card table";
   if (foreground_collector_type_ == kCollectorTypeCC && kUseTableLookupReadBarrier) {
     rb_table_.reset(new accounting::ReadBarrierTable());
diff --git a/runtime/runtime.cc b/runtime/runtime.cc
index 7c6e34c..d52dfcc 100644
--- a/runtime/runtime.cc
+++ b/runtime/runtime.cc
@@ -1212,11 +1212,13 @@ bool Runtime::Init(RuntimeArgumentMap&& runtime_options_in) {
   {
     constexpr uintptr_t kSentinelAddr =
         RoundDown(static_cast<uintptr_t>(Context::kBadGprBase), kPageSize);
+    // SteamARM: the sentinel address is below 4 GiB, outside a non-zero
+    // heap reference window, so it is not a low_4gb request there.
     protected_fault_page_ = MemMap::MapAnonymous("Sentinel fault page",
                                                  reinterpret_cast<uint8_t*>(kSentinelAddr),
                                                  kPageSize,
                                                  PROT_NONE,
-                                                 /*low_4gb=*/ true,
+                                                 /*low_4gb=*/ kHeapReferenceBase == 0u,
                                                  /*reuse=*/ false,
                                                  /*reservation=*/ nullptr,
                                                  /*error_msg=*/ nullptr);
