+// SteamARM: boot image relocation works on the low 32 bits of addresses (an
+// image has the same layout for any heap reference base, and an upstream
+// image has none), and every relocated address lies in the window.
+static ALWAYS_INLINE uint32_t ImageLowBits(const void* ptr) {
+  return CompressHeapAddress(reinterpret_cast<uintptr_t>(ptr));
+}
+
+template <typename T>
+static ALWAYS_INLINE T* ImageWindowPointer(uint32_t low_bits) {
+  return reinterpret_cast<T*>(static_cast<uintptr_t>(DecompressHeapAddress(low_bits)));
+}
