+
+// SteamARM (Darwin host): guest address ranges for host memory a guest must
+// see. A 32-bit guest lives at host = base + guest (GuestBase.h), so a
+// pointer the host library hands back -- Vulkan's vkMapMemory above all --
+// is out of its reach. The runtime's Vulkan shim takes a range from the
+// guest allocator here, aliases the host pages into it, and returns the
+// window address; the thunk then gives the guest the window offset.
+#include <sys/mman.h>
+extern "C" {
+FEX_DEFAULT_VISIBILITY uint64_t fex_lxrt_guest_bits() {
+  return FEX::HLE::_SyscallHandler && FEX::HLE::_SyscallHandler->Is64BitMode() ? 64 : 32;
+}
+
+// Returns a 16 KiB aligned guest address with Size bytes reserved
+// (PROT_NONE), or 0.
+FEX_DEFAULT_VISIBILITY uint64_t fex_lxrt_guest_reserve(uint64_t Size) {
+  auto* A = FEX::HLE::_SyscallHandler ? FEX::HLE::_SyscallHandler->Get32BitAllocator() : nullptr;
+  if (!A || !Size) {
+    return 0;
+  }
+  constexpr uint64_t HostPage = 0x4000;
+  const uint64_t Len = (Size + HostPage - 1) & ~(HostPage - 1);
+  const auto R = reinterpret_cast<uint64_t>(A->Mmap(nullptr, Len + HostPage, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0));
+  if (R > ~0xFFFULL) { // -errno
+    return 0;
+  }
+  const uint64_t Aligned = (R + HostPage - 1) & ~(HostPage - 1);
+  if (Aligned > R) {
+    A->Munmap(reinterpret_cast<void*>(R), Aligned - R);
+  }
+  const uint64_t End = R + Len + HostPage;
+  if (End > Aligned + Len) {
+    A->Munmap(reinterpret_cast<void*>(Aligned + Len), End - (Aligned + Len));
+  }
+  return Aligned;
+}
+
+FEX_DEFAULT_VISIBILITY void fex_lxrt_guest_release(uint64_t Addr, uint64_t Size) {
+  auto* A = FEX::HLE::_SyscallHandler ? FEX::HLE::_SyscallHandler->Get32BitAllocator() : nullptr;
+  if (A && Addr && Size) {
+    A->Munmap(reinterpret_cast<void*>(Addr), (Size + 0x3FFF) & ~0x3FFFULL);
+  }
+}
+}
