+/*
+ * SteamARM: pointer confinement on macOS.
+ *
+ * An X client that grabs the pointer with confine_to (SDL's mouse grab and
+ * relative mode, which games use for mouse-look) has the X sprite confined
+ * by the DIX, but the cursor on screen is macOS's, and it went on moving:
+ * out of the game's window while the player aimed, so that a click landed
+ * on another window or the desktop and the game lost its focus.
+ *
+ *   - confined and the cursor hidden (mouse-look): the macOS cursor is put
+ *     at the centre of the confining window and dissociated from the mouse
+ *     (CGAssociateMouseAndMouseCursorPosition(false), what SDL itself does
+ *     in relative mode on macOS). The mouse still reports its motion, which
+ *     reaches the client as the pointer's Rel X / Rel Y valuators (XInput 2
+ *     raw motion: SDL 3 reads those), and every click lands in the window;
+ *   - confined and the cursor shown: the cursor is kept inside the box.
+ *
+ * Nothing is held while another application is active (Cmd-Tab gives the
+ * mouse back at once). XQUARTZ_POINTER_CONFINE=0 turns all of it off;
+ * XQUARTZ_PTR_DEBUG=1 logs the changes.
+ */
+static volatile int xq_ptr_confined, xq_ptr_hidden;
+static volatile int xq_ptr_box[4];
+static BOOL xq_ptr_locked;
+static id xq_ptr_observer_active, xq_ptr_observer_resign;
+
+static BOOL
+xq_ptr_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("XQUARTZ_POINTER_CONFINE");
+        on = !(e && e[0] == '0');
+    }
+    return on;
+}
+
+static BOOL
+xq_ptr_debug(void)
+{
+    static int on = -1;
+    if (on < 0)
+        on = getenv("XQUARTZ_PTR_DEBUG") != NULL;
+    return on;
+}
+
+static void
+xq_ptr_apply(void)
+{
+    BOOL lock = xq_ptr_enabled() && xq_ptr_confined && xq_ptr_hidden && NSApp.active;
+
+    if (!xq_ptr_observer_active) {
+        NSNotificationCenter *nc = NSNotificationCenter.defaultCenter;
+        xq_ptr_observer_active = [[nc addObserverForName:NSApplicationDidBecomeActiveNotification
+                                                  object:nil queue:nil
+                                              usingBlock:^(NSNotification *n) { xq_ptr_apply(); }] retain];
+        xq_ptr_observer_resign = [[nc addObserverForName:NSApplicationDidResignActiveNotification
+                                                  object:nil queue:nil
+                                              usingBlock:^(NSNotification *n) { xq_ptr_apply(); }] retain];
+    }
+
+    if (lock && !xq_ptr_locked) {
+        CGPoint centre = CGPointMake((xq_ptr_box[0] + xq_ptr_box[2]) / 2.0,
+                                     (xq_ptr_box[1] + xq_ptr_box[3]) / 2.0);
+        CGWarpMouseCursorPosition(centre);
+        CGAssociateMouseAndMouseCursorPosition(false);
+        xq_ptr_locked = YES;
+        if (xq_ptr_debug())
+            ErrorF("pointer: locked at %.0f,%.0f (box %d,%d-%d,%d)\n", centre.x, centre.y,
+                   xq_ptr_box[0], xq_ptr_box[1], xq_ptr_box[2], xq_ptr_box[3]);
+    }
+    else if (!lock && xq_ptr_locked) {
+        CGAssociateMouseAndMouseCursorPosition(true);
+        xq_ptr_locked = NO;
+        if (xq_ptr_debug())
+            ErrorF("pointer: released (confined %d, hidden %d, active %d)\n",
+                   xq_ptr_confined, xq_ptr_hidden, (int)NSApp.active);
+    }
+}
+
+/* X server thread. */
+void
+XQPointerSetConfine(int confined, int x1, int y1, int x2, int y2)
+{
+    if (confined == xq_ptr_confined && (!confined ||
+        (x1 == xq_ptr_box[0] && y1 == xq_ptr_box[1] &&
+         x2 == xq_ptr_box[2] && y2 == xq_ptr_box[3])))
+        return;
+    xq_ptr_box[0] = x1;
+    xq_ptr_box[1] = y1;
+    xq_ptr_box[2] = x2;
+    xq_ptr_box[3] = y2;
+    xq_ptr_confined = confined;
+    if (xq_ptr_debug())
+        ErrorF("pointer: %s %d,%d-%d,%d\n", confined ? "confined to" : "free, screen",
+               x1, y1, x2, y2);
+    dispatch_async(dispatch_get_main_queue(), ^{ xq_ptr_apply(); });
+}
+
+/* X server thread. */
+void
+XQPointerSetCursorHidden(int hidden)
+{
+    if (hidden == xq_ptr_hidden)
+        return;
+    xq_ptr_hidden = hidden;
+    if (xq_ptr_debug())
+        ErrorF("pointer: cursor %s\n", hidden ? "hidden" : "shown");
+    dispatch_async(dispatch_get_main_queue(), ^{ xq_ptr_apply(); });
+}
+
+/* After CGWarpMouseCursorPosition (XWarpPointer): macOS drops the mouse's
+ * events for a quarter of a second after a warp unless the cursor is
+ * associated again at once (what SDL does on macOS). Not while locked:
+ * that would let the cursor go. */
+void
+XQPointerAfterWarp(void)
+{
+    if (!xq_ptr_locked)
+        CGAssociateMouseAndMouseCursorPosition(true);
+}
+
+/* Main thread, for each mouse event: a visible cursor confined by a grab is
+ * put back inside the box (global coordinates, top-left origin). */
+BOOL
+XQPointerClamp(NSPoint *location)
+{
+    CGFloat x, y;
+
+    if (!xq_ptr_enabled() || !xq_ptr_confined || xq_ptr_locked)
+        return NO;
+    x = location->x;
+    y = location->y;
+    if (x < xq_ptr_box[0]) x = xq_ptr_box[0];
+    if (y < xq_ptr_box[1]) y = xq_ptr_box[1];
+    if (x > xq_ptr_box[2] - 1) x = xq_ptr_box[2] - 1;
+    if (y > xq_ptr_box[3] - 1) y = xq_ptr_box[3] - 1;
+    if (x == location->x && y == location->y)
+        return NO;
+    location->x = x;
+    location->y = y;
+    CGWarpMouseCursorPosition(CGPointMake(x, y));
+    CGAssociateMouseAndMouseCursorPosition(true);
+    return YES;
+}
