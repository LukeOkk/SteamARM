+
+/* A cursor nothing of which is drawn: what SDL and other toolkits set to
+ * hide the pointer (an empty pixmap cursor), like no cursor at all. */
+static Bool
+QuartzCursorIsInvisible(CursorPtr pCursor)
+{
+    CursorBitsPtr bits;
+    size_t i, n;
+
+    if (pCursor == NULL)
+        return TRUE;
+    bits = pCursor->bits;
+    if (bits->argb != NULL) {
+        n = (size_t)bits->width * bits->height;
+        for (i = 0; i < n; i++)
+            if (bits->argb[i] >> 24)
+                return FALSE;
+        return TRUE;
+    }
+    if (bits->mask == NULL)
+        return FALSE;
+    n = (size_t)BitmapBytePad(bits->width) * bits->height;
+    for (i = 0; i < n; i++)
+        if (bits->mask[i])
+            return FALSE;
+    return TRUE;
+}
+
+/* The DIX confines the X sprite (a grab with confine_to, the root window
+ * otherwise); the macOS cursor, which is the one on screen, has to follow. */
+static void
+QuartzConstrainCursor(DeviceIntPtr pDev, ScreenPtr pScreen, BoxPtr pBox)
+{
+    int ox = pScreen->x + darwinMainScreenX;
+    int oy = pScreen->y + darwinMainScreenY;
+    Bool whole;
+
+    QuartzSavedConstrainCursor(pDev, pScreen, pBox);
+    whole = pBox->x1 <= 0 && pBox->y1 <= 0 &&
+            pBox->x2 >= pScreen->width && pBox->y2 >= pScreen->height;
+    XQPointerSetConfine(!whole, pBox->x1 + ox, pBox->y1 + oy,
+                        pBox->x2 + ox, pBox->y2 + oy);
+}
