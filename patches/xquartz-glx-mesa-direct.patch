--- a/hw/xquartz/GL/capabilities.c
+++ b/hw/xquartz/GL/capabilities.c
@@ -365,6 +365,26 @@
 
 #undef DEPTH
 
+    /* Apple Silicon's renderers describe only 0 and 32 bits of depth. A
+     * direct-rendering Mesa client (Zink, llvmpipe) pairs each server
+     * fbconfig with one of its own by exact depth size and offers 16 and
+     * 24, never 32 (src/glx/dri_common.c driConfigEqual): with 0 and 32
+     * alone, nothing with a depth buffer matched -- glxgears found no
+     * double-buffered visual. CGL satisfies a request for 16 or 24 with its
+     * 32-bit buffer, so they are honest for indirect clients too. */
+    {
+        bool has16 = false, has24 = false, has32 = false;
+        for (int i = 0; i < offset; i++) {
+            has16 |= c->depth_buffers[i] == 16;
+            has24 |= c->depth_buffers[i] == 24;
+            has32 |= c->depth_buffers[i] == 32;
+        }
+        if (has32 && !has16 && offset < GLCAPS_DEPTH_BUFFERS - 1)
+            c->depth_buffers[offset++] = 16;
+        if (has32 && !has24 && offset < GLCAPS_DEPTH_BUFFERS - 1)
+            c->depth_buffers[offset++] = 24;
+    }
+
     c->total_depth_buffer_depths = offset;
     assert(c->total_depth_buffer_depths < GLCAPS_DEPTH_BUFFERS);
 }
