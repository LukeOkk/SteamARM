+bool
+kk_nir_is_fsr_bilinear(nir_shader *nir)
+{
+   if (nir->info.stage != MESA_SHADER_FRAGMENT)
+      return false;
+
+   unsigned tex = 0;
+   bool ok = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *t = nir_instr_as_tex(instr);
+            tex++;
+            int ti = nir_tex_instr_src_index(t, nir_tex_src_texture_deref);
+            int si = nir_tex_instr_src_index(t, nir_tex_src_sampler_deref);
+            if (t->op != nir_texop_tex || ti < 0 || si < 0)
+               return false;
+            nir_variable *tv = nir_deref_instr_get_variable(nir_src_as_deref(t->src[ti].src));
+            nir_variable *sv = nir_deref_instr_get_variable(nir_src_as_deref(t->src[si].src));
+            ok = tv && sv && tv->data.descriptor_set == 1 && tv->data.binding == FSR_EASU_BINDING &&
+                 sv->data.descriptor_set == 1 && sv->data.binding == 14;
+         }
+      }
+   }
+   return tex == 1 && ok && !kk_nir_is_fsr_easu(nir);
+}
