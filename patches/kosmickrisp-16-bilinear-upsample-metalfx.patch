+void
+kk_fsr_note_drawn(struct kk_cmd_buffer *cmd)
+{
+   struct kk_rendering_state *render = &cmd->state.gfx.render;
+   const struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
+   if (render->color_att_count < 1 || !render->color_att[0].iview ||
+       dyn->vp.viewport_count < 1 || dyn->vp.viewports[0].x != 0.0f ||
+       dyn->vp.viewports[0].y != 0.0f)
+      return;
+   const struct kk_image_view *iv = render->color_att[0].iview;
+   if (iv->vk.base_mip_level)
+      return;
+   struct kk_image *image = container_of(iv->vk.image, struct kk_image, vk);
+   image->fsr_drawn_w = (uint32_t)dyn->vp.viewports[0].width;
+   image->fsr_drawn_h = (uint32_t)dyn->vp.viewports[0].height;
+}
