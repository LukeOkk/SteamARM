+
+/* An argument table for this command buffer's recording: one of the
+ * device's idle tables, or a new one (root at 0, samplers at 1, per-draw
+ * data at 2). */
+static void
+kk_cmd_buffer_borrow_argument_table(struct kk_cmd_buffer *cmd)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (cmd->argument_table)
+      return;
+   simple_mtx_lock(&dev->arg_tables.lock);
+   if (dev->arg_tables.count) {
+      cmd->argument_table = dev->arg_tables.tables[--dev->arg_tables.count];
+      simple_mtx_unlock(&dev->arg_tables.lock);
+      return;
+   }
+   dev->arg_tables.made++;
+   simple_mtx_unlock(&dev->arg_tables.lock);
+
+   mtl_argument_table_descriptor *desc = mtl_new_argument_table_descriptor();
+   mtl_set_max_buffer_binding_count(desc, 3u);
+   cmd->argument_table = mtl_new_argument_table(dev->mtl_handle, desc);
+   mtl_set_address(cmd->argument_table, dev->samplers.table.bo->gpu, 1u);
+   mtl_release(desc);
+}
+
+/* Done recording (or reset, or destroyed while recording): the table goes
+ * back to the device. The commands encoded with it keep their snapshots. */
+static void
+kk_cmd_buffer_return_argument_table(struct kk_cmd_buffer *cmd)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   mtl_argument_table *table = cmd->argument_table;
+   if (!table)
+      return;
+   cmd->argument_table = NULL;
+   simple_mtx_lock(&dev->arg_tables.lock);
+   if (dev->arg_tables.count == dev->arg_tables.cap) {
+      uint32_t cap = dev->arg_tables.cap ? dev->arg_tables.cap * 2 : 16;
+      mtl_argument_table **t =
+         realloc(dev->arg_tables.tables, cap * sizeof(*t));
+      if (!t) {
+         simple_mtx_unlock(&dev->arg_tables.lock);
+         mtl_release(table);
+         return;
+      }
+      dev->arg_tables.tables = t;
+      dev->arg_tables.cap = cap;
+   }
+   dev->arg_tables.tables[dev->arg_tables.count++] = table;
+   simple_mtx_unlock(&dev->arg_tables.lock);
 }
 
