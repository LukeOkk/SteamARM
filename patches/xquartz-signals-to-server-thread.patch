+/* SteamARM: termination/reset signals must be handled on the X server
+ * thread.  If SIGTERM lands on another thread, GiveUp() only sets a flag and
+ * the server thread keeps sleeping in poll() until some client wakes it. */
+static void
+quartz_termination_sigset(sigset_t *set)
+{
+    sigemptyset(set);
+    sigaddset(set, SIGTERM);
+    sigaddset(set, SIGINT);
+    sigaddset(set, SIGHUP);
+    sigaddset(set, SIGQUIT);
+}
+
 _X_NORETURN
 static void
 server_thread(void *arg)
 {
     struct arg args = *((struct arg *)arg);
+    sigset_t set;
+
     free(arg);
+    quartz_termination_sigset(&set);
+    pthread_sigmask(SIG_UNBLOCK, &set, NULL);
     exit(dix_main(args.argc, args.argv, args.envp));
 }
 
