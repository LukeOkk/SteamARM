+/* SteamARM, diagnostics: KK_PASS_STATS=1 prints, every 120 frames
+ * (kk_queue.c), the render encoders per frame, what they store (all and
+ * multisampled, in megabytes before compression) and why encoders ended.
+ * It found Counter-Strike 2's 4x MSAA cost: about 90 encoders a frame, 75
+ * of them ended by a pass on other attachments, storing ~2 GB of samples. */
+uint64_t kk_stat_encoders, kk_stat_ms_stores, kk_stat_ms_store_bytes, kk_stat_stores, kk_stat_store_bytes;
+/* Why render encoders ended: 0 barrier inside a pass, 1 compute or copy after
+ * a pass, 2 next pass on other attachments, 3 end of a pass (resolve, flags),
+ * 4 render state change, 5 other. */
+uint64_t kk_stat_end_reason[6];
+void kk_stat_end(struct kk_cmd_buffer *cmd, int reason);
 void
+kk_stat_end(struct kk_cmd_buffer *cmd, int reason)
+{
+   if (cmd->gfx.encoder)
+      __atomic_fetch_add(&kk_stat_end_reason[reason], 1, __ATOMIC_RELAXED);
+}
+static void
+kk_stat_store(const struct kk_attachment *att, enum mtl_store_action a)
+{
+   if (a != MTL_STORE_ACTION_STORE || !att->iview)
+      return;
+   const struct vk_image *img = att->iview->vk.image;
+   uint64_t b = (uint64_t)img->extent.width * img->extent.height * img->samples *
+                vk_format_get_blocksize(att->iview->vk.format);
+   if (img->samples > 1) {
+      __atomic_fetch_add(&kk_stat_ms_stores, 1, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&kk_stat_ms_store_bytes, b, __ATOMIC_RELAXED);
+   }
+   __atomic_fetch_add(&kk_stat_stores, 1, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&kk_stat_store_bytes, b, __ATOMIC_RELAXED);
+}
