+
+/* Metal takes alpha-to-coverage from the alpha the fragment function returns
+ * for colour attachment 0. KosmicKrisp blends, applies the colour write mask
+ * and trims the colour to the attachment's channels in the shader
+ * (nir_lower_blend), so that alpha is not the one the application's shader
+ * wrote when attachment 0 is blended, masked (a depth prepass with colour
+ * writes off: the store is gone and every sample is covered), has no alpha
+ * channel (B10G11R11) or is swizzled. Then the coverage is computed in the
+ * shader from the alpha before all that and returned in the sample mask.
+ */
+static bool
+kk_fs_lowers_alpha_to_coverage(const struct vk_graphics_pipeline_state *state)
+{
+   if (!state->ms || !state->ms->alpha_to_coverage_enable || !state->rp)
+      return false;
+
+   const struct vk_render_pass_state *rp = state->rp;
+   for (uint32_t i = 0u; i < rp->color_attachment_count; ++i) {
+      if (kk_get_logical_color_att_index(state, i) != 0u)
+         continue;
+
+      VkFormat vk_format = rp->color_attachment_formats[i];
+      if (vk_format == VK_FORMAT_UNDEFINED)
+         return false;
+
+      enum pipe_format format = vk_format_to_pipe_format(vk_format);
+      if (util_format_get_nr_components(format) < 4)
+         return true;
+      const struct kk_va_format *va = kk_get_va_format(format);
+      if (va && !va->is_native)
+         return true;
+
+      if (state->cb) {
+         const struct vk_color_blend_attachment_state *att =
+            &state->cb->attachments[i];
+         if (state->cb->logic_op_enable || att->blend_enable ||
+             (att->write_mask & 0xf) != 0xf)
+            return true;
+      }
+      return false;
+   }
+   return false;
 }
 
+/* The sample mask alpha-to-coverage leaves: the formula and the dithering of
+ * nir_lower_alpha.c, in 32-bit integers.
+ */
+static nir_def *
+kk_alpha_to_coverage_mask(nir_builder *b, nir_def *alpha)
+{
+   nir_def *m = nir_f2i32(
+      b, nir_fround_even(b, nir_fmul_imm(b, nir_fsat(b, alpha), 16.0)));
+   nir_def *part_a = nir_iand_imm(
+      b, nir_ushr(b, nir_imm_int(b, 0xf7540), nir_iand_imm(b, m, ~3)), 0xf);
+   nir_def *part_b = nir_iand_imm(b, m, 2);
+   nir_def *part_c = nir_iand_imm(b, m, 1);
+   nir_def *mask = nir_ior(b, nir_imul_imm(b, part_a, 0x1111),
+                           nir_ior(b, nir_imul_imm(b, part_b, 0x0404),
+                                   nir_imul_imm(b, part_c, 0x0080)));
+
+   /* Rotated by (x % 2) + (y % 2) within its 16 bits */
+   nir_def *pixel = nir_f2u32(b, nir_build_frag_coord(b, 2));
+   BITSET_SET(b->shader->info.system_values_read, SYSTEM_VALUE_FRAG_COORD);
+   nir_def *rotate =
+      nir_iadd(b, nir_iand_imm(b, nir_channel(b, pixel, 0), 1),
+               nir_iand_imm(b, nir_channel(b, pixel, 1), 1));
+   mask = nir_ior(b, nir_ushr(b, mask, rotate),
+                  nir_ishl(b, mask, nir_isub_imm(b, 16, rotate)));
+   return nir_iand_imm(b, mask, 0xffff);
+}
+
+static bool
+kk_nir_lower_alpha_to_coverage(nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_block *last = nir_impl_last_block(impl);
+   nir_intrinsic_instr *color = NULL, *mask = NULL;
+
+   /* nir_lower_io_vars_to_temporaries left the stores in the last block */
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_store_output)
+            continue;
+         nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+         if (sem.location == FRAG_RESULT_SAMPLE_MASK) {
+            if (block != last || mask)
+               return nir_no_progress(impl);
+            mask = intr;
+         } else if (sem.location == FRAG_RESULT_DATA0 &&
+                    sem.dual_source_blend_index == 0 && block == last) {
+            color = intr;
+         }
+      }
+   }
+
+   /* No alpha written to location 0: it is undefined, take it as 1 */
+   if (!color || nir_intrinsic_component(color) != 0 ||
+       color->src[0].ssa->num_components < 4 ||
+       !(nir_intrinsic_write_mask(color) & 0x8))
+      return nir_no_progress(impl);
+
+   nir_builder b = nir_builder_at(nir_after_block_before_jump(last));
+   nir_def *coverage =
+      kk_alpha_to_coverage_mask(&b, nir_channel(&b, color->src[0].ssa, 3));
+
+   nir_def *old;
+   if (mask) {
+      old = mask->src[0].ssa;
+      nir_instr_remove(&mask->instr);
+   } else {
+      old = nir_load_sample_mask_in(&b);
+      BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_SAMPLE_MASK_IN);
+   }
+
+   struct nir_io_semantics io_semantics = {
+      .location = FRAG_RESULT_SAMPLE_MASK,
+      .num_slots = 1u,
+   };
+   nir_store_output(&b, nir_iand(&b, old, coverage), nir_imm_int(&b, 0u),
+                    .base = 0u, .range = 1u, .write_mask = 0x1,
+                    .component = 0u, .src_type = nir_type_uint32,
+                    .io_semantics = io_semantics);
+   nir->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_SAMPLE_MASK);
+
+   return nir_progress(true, impl, nir_metadata_control_flow);
+}
