@@ -56,6 +56,30 @@
 #define DEFAULT_REFRESH         60
 #define kDisplayModeUsableFlags (kDisplayModeValidFlag | kDisplayModeSafeFlag)
 
+/* SteamARM: the fake modes are told apart from real CoreGraphics modes by
+ * their refresh rate, 1 Hz (rootless) and 2 Hz (fullscreen), and that number
+ * also went out on the wire as the mode's rate. RandR 1.2 clients derive a
+ * mode's refresh as dotClock / (hTotal * vTotal), and RROldModeAdd
+ * (randr/rrinfo.c) builds the dot clock from this rate, so the rootless
+ * desktop looked like a 1 Hz display. Chromium paces its compositor by that
+ * number (ui/base/x/x11_display_util.cc,
+ * GetPrimaryDisplayRefreshIntervalFromXrandr, used by every X11 output
+ * surface through XrandrIntervalOnlyVSyncProvider) and drew one frame per
+ * second; SDL3 and Wine read the same field. Clients now see the display's
+ * real rate for the rootless mode. The fake value stays the server's internal
+ * key, and a set request for the rootless size at that rate is mapped back to
+ * it. The fullscreen fake mode keeps 2 Hz on the wire: it has the size of a
+ * real mode, and the rate is what tells the two apart in a set request. */
+static int rootless_wire_refresh = DEFAULT_REFRESH;
+
+static int
+QuartzRandRWireRefresh(const QuartzModeInfo *pMode)
+{
+    if (pMode->refresh == FAKE_REFRESH_ROOTLESS)
+        return rootless_wire_refresh;
+    return pMode->refresh;
+}
+
 #define CALLBACK_SUCCESS        0
 #define CALLBACK_CONTINUE       1
 #define CALLBACK_ERROR          -1
