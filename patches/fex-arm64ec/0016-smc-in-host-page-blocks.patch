+void InvalidationTracker::ReleaseBlockNeighbours(uint64_t Address, uint64_t Size) {
+  // The host page now carries write for the whole block: a store into a neighbouring guest page that FEX
+  // write-protected after translating it would no longer fault. Drop that protection, and the code behind it.
+  const auto Begin = SMCBlockBase(Address);
+  const auto End = SMCBlockEnd(Address, Size);
+  if (Begin == Address && End == Address + Size) {
+    return;
+  }
+
+  std::scoped_lock CodeLock(CTX.GetCodeInvalidationMutex());
+  if (Begin < Address) {
+    InvalidateAndUntrapLocked(Begin, Address - Begin);
+  }
+  if (End > Address + Size) {
+    InvalidateAndUntrapLocked(Address + Size, End - (Address + Size));
+  }
+}
+
+bool InvalidationTracker::InvalidateAndUntrapLocked(uint64_t Address, uint64_t Size) {
+  // NOTE: This assumes CodeInvalidationMutex is locked by the caller: no block can be compiled (and trap a page)
+  // between the check, the invalidation and the unprotection. IntervalsLock is not held across the invalidation.
+  {
+    std::shared_lock Lock(IntervalsLock);
+    if (SMCDetectionDisabled || !RWXIntervals.Intersect({Address, Address + Size})) {
+      return false;
+    }
+  }
+
+  InvalidateIntervalInternalLocked(Address, Size);
+
+  const auto End = Address + Size;
+  std::shared_lock Lock(IntervalsLock);
+  while (Address < End) {
+    const auto Query = RWXIntervals.Query(Address);
+    if (Query.Enclosed) {
+      void* TmpAddress = reinterpret_cast<void*>(Address);
+      SIZE_T TmpSize = static_cast<SIZE_T>(std::min(End, Address + Query.Size) - Address);
+      ULONG TmpProt;
+      NtProtectVirtualMemory(NtCurrentProcess(), &TmpAddress, &TmpSize, GetUntrapProt(Address), &TmpProt);
+    } else if (!Query.Size) {
+      break;
+    }
+    Address += Query.Size;
   }
+  return true;
 }
 
