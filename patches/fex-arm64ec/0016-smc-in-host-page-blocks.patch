+  // Self-modifying code is tracked in blocks of this many bytes, a multiple of FEX_PAGE_SIZE: SteamARM's runtime
+  // backs 4 KiB guest pages with 16 KiB host pages that carry the union of their guest pages' protections, so a
+  // guest page's write protection only holds while every guest page sharing its host page is protected as well.
+  uint64_t SMCBlockSize {FEXCore::Utils::FEX_PAGE_SIZE};
+  uint64_t SMCBlockBase(uint64_t Address) const {
+    return Address & ~(SMCBlockSize - 1);
+  }
+  uint64_t SMCBlockEnd(uint64_t Address, uint64_t Size) const {
+    return (Address + Size + SMCBlockSize - 1) & ~(SMCBlockSize - 1);
+  }
+  // After the guest made [Address, Address + Size) writable: the guest pages around it in the same blocks can no
+  // longer be write-protected, so their code is invalidated and their trap protection dropped.
+  void ReleaseBlockNeighbours(uint64_t Address, uint64_t Size);
+  // Invalidates the code of, then unprotects, the RWX intervals in the range; false when there are none.
+  // NOTE: CodeInvalidationMutex must be locked by the caller, IntervalsLock must not be.
+  bool InvalidateAndUntrapLocked(uint64_t Address, uint64_t Size);
+  bool Initialized {false};
