 #include <winternl.h>
 
 namespace FEX::Windows {
+// Converted into a buffer on the stack, not one from the process heap: GetSectionFilePath runs with
+// ThreadCreationMutex held (NotifyMapViewOfSection), and a thread holding the process heap's lock takes
+// that mutex when the heap grows (NtAllocateVirtualMemory -> NotifyMemoryAlloc) or writes to a page the
+// SMC tracking write-protected. RtlUnicodeStringToAnsiString(..., TRUE) deadlocked the two threads.
+inline fextl::string UnicodeToAnsiPath(const UNICODE_STRING& PathW) {
+  std::array<char, PATH_MAX * 2 + 1> Buf;
+  STRING PathA {.Length = 0, .MaximumLength = static_cast<USHORT>(Buf.size()), .Buffer = Buf.data()};
+  if (RtlUnicodeStringToAnsiString(&PathA, &PathW, FALSE)) {
+    return {};
+  }
+  return fextl::string(PathA.Buffer, PathA.Length);
+}
+
