--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/LxrtJit.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+// W^X for FEX on top of the SteamARM Darwin runtime (lxrun), here as the
+// ARM64EC DLL Wine loads. The Linux ELF build of FEX carries the same scopes
+// (SteamARM patches/LxrtJit.h); this copy drops what an ARM64EC DLL cannot
+// have.
+//
+// Under the runtime a JIT region is Darwin MAP_JIT: a thread may write it or
+// execute it but never both, and the switch is per thread. The runtime cannot
+// make the switch from a fault (a pthread_jit_write_protect_np() inside a
+// signal handler does not survive the handler's return), so FEX asks, on its
+// own stack, around every store into its code.
+//
+// Private syscall 0x4C580020 in x8, (enable, addr, len):
+//    0  open this thread for writing (the runtime counts nested opens)
+//    1  scan [addr,len) for instructions the runtime cannot let run, and
+//       return to execute mode when the outermost scope closes
+//    3  turn [addr,len), read-write-execute memory from VirtualAlloc, into a
+//       JIT region at the same address (contents are not kept)
+//
+// Without it, Wine commits FEX's PAGE_EXECUTE_READWRITE code buffer with
+// mprotect and the runtime splits it page by page: every compiled block cost
+// a write flip and an execute flip of a 16 KiB page, each an mprotect.
+//
+// An ARM64EC DLL must not have thread_local data (it takes a TLS slot of the
+// game's), so the nesting is the runtime's to count. Anywhere else the
+// syscall number is unknown: Linux returns -ENOSYS, Windows an error status,
+// the probe latches false once, and every scope costs one predictable branch.
+
+#include <cstddef>
+#include <cstdint>
+
+namespace FEXCore::LxrtJit {
+
+#if (defined(__aarch64__) && defined(__linux__)) || defined(__arm64ec__)
+
+inline long Call(long Enable, uint64_t Addr, uint64_t Len) {
+  register long x8 asm("x8") = 0x4C580020;
+  register long x0 asm("x0") = Enable;
+  register uint64_t x1 asm("x1") = Addr;
+  register uint64_t x2 asm("x2") = Len;
+  asm volatile("svc #0" : "+r"(x0) : "r"(x8), "r"(x1), "r"(x2) : "memory", "cc");
+  return x0;
+}
+
+// Asking for execute mode is the safe probe: under the runtime it is the state
+// a thread is already in. Constant-initialised, so no guard and no TLS; a race
+// between two first callers asks twice and gets the same answer.
+inline bool Available() {
+  static int Supported = -1;
+  if (Supported < 0) {
+    Supported = Call(1, 0, 0) == 0;
+  }
+  return Supported != 0;
+}
+
+// RAII. Construct around every write into an executable buffer; pass the range
+// that write lands in so the runtime scans that and nothing else.
+class WriteScope final {
+public:
+  explicit WriteScope(void* Addr = nullptr, size_t Len = 0)
+    : Base(reinterpret_cast<uint64_t>(Addr))
+    , Size(Len) {
+    if (!Available()) {
+      return;
+    }
+    Active = true;
+    Call(0, 0, 0);
+  }
+
+  ~WriteScope() {
+    if (Active) {
+      Call(1, Base, Size);
+    }
+  }
+
+  WriteScope(const WriteScope&) = delete;
+  WriteScope& operator=(const WriteScope&) = delete;
+
+private:
+  uint64_t Base;
+  size_t Size;
+  bool Active = false;
+};
+
+// Make a freshly allocated, still unwritten code buffer a JIT region.
+inline bool Adopt(void* Addr, size_t Len) {
+  return Available() && Call(3, reinterpret_cast<uint64_t>(Addr), Len) == 0;
+}
+
+#else
+
+class WriteScope final {
+public:
+  explicit WriteScope(void* = nullptr, size_t = 0) {}
+  WriteScope(const WriteScope&) = delete;
+  WriteScope& operator=(const WriteScope&) = delete;
+};
+inline bool Available() {
+  return false;
+}
+inline bool Adopt(void*, size_t) {
+  return false;
+}
+
+#endif
+
+} // namespace FEXCore::LxrtJit
