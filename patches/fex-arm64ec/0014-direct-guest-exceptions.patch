SteamARM: raise JIT-generated guest exceptions without a host trap.
The dispatcher's GuestSignal_* handlers call Pointers.GuestExceptionHook (set by the
ARM64EC frontend) instead of executing hlt/brk: under Wine every host trap is a host
signal. STEAMARM_FEX_TRAP_HOOK=0 restores the trap. The pointer is the last JITPointers
field, so no other field's offset moves.

--- a/FEXCore/include/FEXCore/Core/CoreState.h
+++ b/FEXCore/include/FEXCore/Core/CoreState.h
@@ -356,6 +356,7 @@
   // Handles returning/calling ARM64EC code from the JIT, expects the target PC in TMP3
   uint64_t ExitFunctionEC {};
 
+
   FallbackABIInfo FallbackHandlerPointers[FallbackHandlerIndex::OPINDEX_MAX];
   uint64_t NamedVectorConstantPointers[FEXCore::IR::NamedVectorConstant::NAMED_VECTOR_CONST_POOL_MAX];
   uint64_t IndexedNamedVectorConstantPointers[FEXCore::IR::IndexNamedVectorConstant::INDEXED_NAMED_VECTOR_MAX];
@@ -395,6 +396,11 @@
 
   // Copy of process-wide named vector constants data.
   alignas(16) uint64_t NamedVectorConstants[FEXCore::IR::NamedVectorConstant::NAMED_VECTOR_CONST_POOL_MAX][2];
+
+  // Windows frontends: raises the guest exception described by SynchronousFaultData directly, without the host
+  // trap the GuestSignal_* handlers otherwise execute. Never returns. Zero: the host trap is used.
+  // Last, so no other field moves (code cached by an earlier build addresses them by offset).
+  uint64_t GuestExceptionHook {};
 };
 
 // Each guest JIT frame has one of these
