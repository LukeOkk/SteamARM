+
+// Pointers.GuestExceptionHook: the dispatcher's GuestSignal_* handlers call this instead of trapping. The guest state
+// is spilled and SynchronousFaultData describes the fault, which is all ResetToConsistentStateImpl uses for an
+// exception raised at a dispatcher address; doing the same here skips the host trap. Under Wine that trap is a host
+// signal per guest exception, ~85% of the cost of every exception a protector's VEH emulates (MEASURED:
+// Minecraft Dungeons II's invalid-opcode VM, thousands a second).
+extern "C" [[noreturn]] void RaiseGeneratedGuestException() {
+  const auto CPUArea = GetCPUArea();
+  auto* Thread = CPUArea.ThreadState();
+
+  ARM64_NT_CONTEXT Context {};
+  Context.ContextFlags = CONTEXT_ARM64_CONTROL | CONTEXT_ARM64_INTEGER | CONTEXT_ARM64_FLOATING_POINT;
+  Context.Pc = Thread->CurrentFrame->Pointers.GuestSignal_SIGILL; // Any dispatcher address: the state is already spilled
+  Context.Sp = reinterpret_cast<uint64_t>(__builtin_frame_address(0));
+  uint64_t Fpcr, Fpsr;
+  asm volatile("mrs %0, fpcr" : "=r"(Fpcr));
+  asm volatile("mrs %0, fpsr" : "=r"(Fpsr));
+  Context.Fpcr = static_cast<uint32_t>(Fpcr);
+  Context.Fpsr = static_cast<uint32_t>(Fpsr);
+
+  EXCEPTION_RECORD Rec {};
+  Rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION; // Replaced from SynchronousFaultData by HandleGuestException
+  Rec.ExceptionAddress = reinterpret_cast<void*>(Context.Pc);
+
+  {
+    ScopedCallbackDisable guard;
+    if (Exception::RetryStaleNoExecFault(CPUArea, Context)) {
+      NtContinueNative(&Context, false);
+    }
+    Exception::RethrowGuestException(Rec, Context);
+  }
+  __builtin_unreachable();
 }
 
