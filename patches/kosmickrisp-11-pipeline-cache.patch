--- a/src/kosmickrisp/vulkan/kk_instance.c
+++ b/src/kosmickrisp/vulkan/kk_instance.c
@@ -20,6 +20,83 @@
 #include "util/mesa-blake3.h"
 #include "util/u_debug.h"
 
+#include "kosmickrisp/bridge/mtl_bridge.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* Gives this process a Metal shader cache of its own program's:
+ * <DARWIN_USER_CACHE_DIR>/org.mesa.kosmickrisp/<application>. Every process
+ * of SteamARM is the same bundle-less executable, so they all share Metal's
+ * default directory, where each running process takes a separate set of
+ * files; a game then finds its compiled pipelines only if it gets the same
+ * set as the last time, i.e. if the same number of other Metal processes
+ * (Steam's web helpers, ...) happen to run. A miss costs the whole MSL
+ * compilation again (tens to hundreds of ms per pipeline).
+ * KK_METAL_CACHE_DIR=<dir> chooses the directory, KK_METAL_CACHE_DIR=0 keeps
+ * Metal's default. Set once per process, before anything is compiled. */
+static void
+kk_init_metal_shader_cache(const VkInstanceCreateInfo *pCreateInfo)
+{
+   static bool done = false;
+   if (done)
+      return;
+   done = true;
+
+   const char *dir = getenv("KK_METAL_CACHE_DIR");
+   if (dir && (dir[0] == '\0' || !strcmp(dir, "0")))
+      return;
+
+   char path[1024];
+   if (dir) {
+      snprintf(path, sizeof(path), "%s", dir);
+   } else {
+      char base[512];
+      size_t n = confstr(_CS_DARWIN_USER_CACHE_DIR, base, sizeof(base));
+      if (n == 0 || n > sizeof(base))
+         return;
+
+      const VkApplicationInfo *app = pCreateInfo->pApplicationInfo;
+      const char *name = NULL;
+      if (app && app->pApplicationName && app->pApplicationName[0])
+         name = app->pApplicationName;
+      else if (app && app->pEngineName && app->pEngineName[0])
+         name = app->pEngineName;
+      else
+         name = getprogname();
+
+      char clean[65];
+      unsigned len = 0;
+      for (const char *c = name; c && *c && len < sizeof(clean) - 1; c++) {
+         bool ok = (*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') ||
+                   (*c >= '0' && *c <= '9') || *c == '.' || *c == '-' ||
+                   *c == '_';
+         clean[len++] = ok ? *c : '_';
+      }
+      clean[len] = '\0';
+      if (len == 0 || !strcmp(clean, ".") || !strcmp(clean, ".."))
+         snprintf(clean, sizeof(clean), "unnamed");
+
+      snprintf(path, sizeof(path), "%s/org.mesa.kosmickrisp/%s", base, clean);
+   }
+
+   /* mkdir -p */
+   for (char *p = path + 1; *p; p++) {
+      if (*p != '/')
+         continue;
+      *p = '\0';
+      mkdir(path, 0700);
+      *p = '/';
+   }
+   if (mkdir(path, 0700) != 0 && errno != EEXIST)
+      return;
+
+   mtl_set_shader_cache_path(path);
+}
