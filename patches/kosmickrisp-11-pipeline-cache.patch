+/* Metal's shader cache is one directory per bundle identifier (all processes
+ * without one share <DARWIN_USER_CACHE_DIR>/com.apple.metal) and, inside it,
+ * one set of files per process that has it open: the first process takes
+ * "libraries.data", the next one "libraries1.data", and so on. A program that
+ * is started while N other Metal programs of the user run therefore finds
+ * only what was compiled in the N-th set, usually nothing. */
+bool
+mtl_set_shader_cache_path(const char *path)
+{
+   void (*set_path)(NSString *) =
+      (void (*)(NSString *))dlsym(RTLD_DEFAULT, "MTLSetShaderCachePath");
+   if (set_path == NULL || path == NULL)
+      return false;
+
+   @autoreleasepool {
+      set_path([NSString stringWithUTF8String:path]);
+   }
+   return true;
 }
 
