+// SteamARM (Darwin host): a 32-bit guest lives at host = base + guest (FEX's
+// guest base, announced to the lxrt runtime); every guest pointer a host
+// thunk follows needs the base, and a host pointer handed to the guest loses
+// it. The base comes from the runtime (private syscall 0x4C580031).
+#ifdef IS_32BIT_THUNK
+inline uintptr_t fex_lxrt_guest_base() {
+  static uintptr_t base = [] {
+    register long x8 __asm__("x8") = 0x4C580031L;
+    register long x0 __asm__("x0") = 0;
+    __asm__ __volatile__("svc #0" : "+r"(x0) : "r"(x8) : "memory", "cc");
+    return x0 > 0 ? (uintptr_t)x0 : (uintptr_t)0;
+  }();
+  return base;
+}
+// Host pointers outside the guest window (Vulkan's dispatchable handles are
+// MoltenVK objects far above 4 GiB) are aliased into one guest range by the
+// Vulkan shim (shim/map32.c, lxrt_handle_alias); a guest address inside that
+// range converts back to the original host pointer.
+struct fex_lxrt_handle_alias {
+  uint64_t lo, hi;
+  uint32_t (*h2g)(uint64_t);
+  uint64_t (*g2h)(uint32_t);
+};
+inline fex_lxrt_handle_alias* fex_lxrt_handles() {
+  static fex_lxrt_handle_alias* a = (fex_lxrt_handle_alias*)dlsym(RTLD_DEFAULT, "lxrt_handle_alias");
+  return a;
+}
+inline uintptr_t fex_lxrt_g2h(uint64_t g) {
+  if (!g) {
+    return 0;
+  }
+  auto* a = fex_lxrt_handles();
+  if (a && g - a->lo < a->hi - a->lo) {
+    return a->g2h((uint32_t)g);
+  }
+  return (uintptr_t)g + fex_lxrt_guest_base();
+}
+inline uint64_t fex_lxrt_h2g(uintptr_t h) {
+  const uintptr_t b = fex_lxrt_guest_base();
+  if (!h || !b || (h >= b && h - b < (1ULL << 32))) {
+    return h ? h - b : 0;
+  }
+  auto* a = fex_lxrt_handles();
+  return a ? a->h2g(h) : h;
+}
+#else
+inline uintptr_t fex_lxrt_g2h(uint64_t g) {
+  return g;
+}
+inline uint64_t fex_lxrt_h2g(uintptr_t h) {
+  return h;
+}
+#endif
