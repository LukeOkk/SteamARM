+/*
+ * SteamARM: DarwinRelMouseProc, the relative pointer. While a game holds
+ * the pointer (confined, cursor hidden: X11Application.m keeps the macOS
+ * cursor at the window's centre), darwinEvents.c sends the mouse's motion,
+ * buttons and scroll through this device, whose X and Y axes (0 and 1) are
+ * relative. Wine reads only axes 0 and 1 of the pointer, for raw input
+ * (WM_INPUT) and for the cursor while it is clipped; on darwinPointer those
+ * are absolute and stood still at the centre, so mouse-look did nothing in
+ * Windows games. SDL 3 finds Rel X / Rel Y on either device.
+ */
 static int
+DarwinRelMouseProc(DeviceIntPtr pPointer, int what)
+{
+#define NBUTTONS 3
+#define NAXES    4
+    CARD8 map[NBUTTONS + 1] = { 0, 1, 2, 3 };
+    Atom btn_labels[NBUTTONS] = { 0 };
+    Atom axes_labels[NAXES] = { 0 };
+    int i;
+
+    switch (what) {
+    case DEVICE_INIT:
+        pPointer->public.on = FALSE;
+
+        btn_labels[0] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_LEFT);
+        btn_labels[1] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_MIDDLE);
+        btn_labels[2] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_RIGHT);
+
+        axes_labels[0] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_X);
+        axes_labels[1] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_Y);
+        axes_labels[2] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_WHEEL);
+        axes_labels[3] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_HWHEEL);
+
+        InitPointerDeviceStruct((DevicePtr)pPointer, map, NBUTTONS,
+                                btn_labels,
+                                (PtrCtrlProcPtr)NoopDDA,
+                                GetMotionHistorySize(), NAXES,
+                                axes_labels);
+        for (i = 0; i < NAXES; i++)
+            InitValuatorAxisStruct(pPointer, i, axes_labels[i],
+                                   NO_AXIS_LIMITS, NO_AXIS_LIMITS,
+                                   1, 0, 1, Relative);
+
+        SetScrollValuator(pPointer, 2, SCROLL_TYPE_VERTICAL, -1.0, SCROLL_FLAG_PREFERRED);
+        SetScrollValuator(pPointer, 3, SCROLL_TYPE_HORIZONTAL, -1.0, SCROLL_FLAG_NONE);
+        break;
+
+    case DEVICE_ON:
+        pPointer->public.on = TRUE;
+        return Success;
+
+    case DEVICE_CLOSE:
+    case DEVICE_OFF:
+        pPointer->public.on = FALSE;
+        return Success;
+    }
+
+    return Success;
+#undef NBUTTONS
+#undef NAXES
+}
