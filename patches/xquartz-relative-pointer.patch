+/* SteamARM: whether the pointer is held by a game (X11Application.m; the
+ * main thread, like the callers here): its events then come from
+ * darwinRelPointer (darwin.c DarwinRelMouseProc says why). */
+extern int XQPointerLocked(void);
+
+static Bool
+DarwinPointerRelative(void)
+{
+    return darwinRelPointer && darwinRelPointer->enabled && XQPointerLocked();
+}
