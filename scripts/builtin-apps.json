[
  {
    "id": "steam-arm64-frame",
    "name": "Steam ARM64 · Steam Frame (experimental)",
    "kind": "steam",
    "builtIn": true,
    "readiness": "experimental",
    "command": [
      "/tmp/armhome/.local/share/Steam/steamrtarm64/steam"
    ],
    "root": "/tmp/lxrt-arm64root",
