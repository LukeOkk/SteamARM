[
  {
    "id": "steam-arm64-frame",
    "name": "SteamARM",
    "kind": "steam",
    "builtIn": true,
    "command": [
      "/tmp/armhome/.local/share/Steam/steamrtarm64/steam"
    ],
    "root": "/tmp/lxrt-arm64root",
    "fexRootfs": null,
    "env": {
      "HOME_IN_GUEST": "/tmp/armhome",
      "LXRT_GUEST_PAGE": "4096",
      "LXRT_X18_ALL_TEXT": "libcef.so",
      "STEAM_IGNORE_INDIRECT_RENDERING": "1"
    },
    "architecture": "aarch64"
  }
]
