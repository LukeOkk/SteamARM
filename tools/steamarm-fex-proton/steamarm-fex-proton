#!/bin/bash
# SteamARM: Proton x86 via FEX (experimental).
#
# A Steam compatibility tool for Valve's native arm64 Steam client running
# under lxrun (docs/FEX_GAME_BOUNDARY.md). The client runs this script, an
# aarch64 bash script in the client's own ARM64 root, the way its
# toolmanifest.vdf says:
#
#   steamarm-fex-proton <verb> <game.exe> [args...]
#
# It hands the game to the x86 Proton and the x86 Steam Linux Runtime that
# SteamARM's x86 Steam root already has, run by SteamARM's FEX: the only x86
# code in the chain is the game's world (Proton, Wine, the container runtime
# and the game). It execs, in place of itself:
#
#   <FEX> /bin/bash <SLR>/_v2-entry-point --verb=<verb> -- <Proton>/proton <verb> <game.exe> [args...]
#
# with the runtime's root switched to the x86 Steam root (LXRT_ROOT), and a
# bind (LXRT_MOUNTS) that shows the arm64 client's own paths -- its HOME,
# library folders, the game and its prefix -- at the same guest paths there.
# Nothing is copied and nothing in the x86 root is changed.
#
# Configuration: steamarm-fex-proton.conf next to this script, KEY=VALUE
# lines written by scripts/install-fex-proton-tool.sh (host paths are the
# runtime's /tmp links, as scripts/env-links.sh makes them):
#   X86_ROOT   the x86 Steam root               (/tmp/lxrt-steamroot)
#   X86_HOME   HOME there, FEX's config         (/tmp/fexhome)
#   X86_STEAM  the x86 client's Steam directory (/tmp/fexhome/.local/share/Steam)
#   PROTON     x86 Proton, in X86_STEAM/steamapps/common   (Proton - Experimental)
#   RUNTIME    the Steam Linux Runtime it requires          (SteamLinuxRuntime_4)
#   FEXDIR     host directory of FEX and FEXServer          (/tmp/lxrt-root/usr/bin)
#   FEXBIN     the FEX binary in it                         (FEX-gb)
# Installed under the name steamarm-fex-linux (tools/steamarm-fex-linux, the
# same script) it is "SteamARM: Linux x86 via FEX": a tool for NATIVE Linux
# x86 games (from_oslist linux), so that the ARM64 client downloads a game's
# Linux build and not its Windows one. No Proton in that chain:
#
#   <FEX> /bin/bash <SLR>/_v2-entry-point --verb=<verb> -- <game> [args...]
#
# with RUNTIME (default SteamLinuxRuntime_sniper) from the x86 root and HOME
# left the client's own: a native game finds the running client through
# ~/.steam (steam.pid, sdk64/steamclient.so), which is the ARM64 client's.
# FEX's configuration still comes from the x86 home (FEX_APP_CONFIG_LOCATION).
#
# FSR 3.1 / FSR 4 -> MetalFX: with STEAMARM_WIN_UPSCALER=metalfx (launcher
# "Escalado del juego", scripts/settings-env.py) and a Windows game without an
# anti-cheat, Wine takes SteamARM's FidelityFX API DLLs from the x86 root's
# /opt/steamarm/wine (scripts/install-ffx-metalfx.sh) over the game's own
# (see "FSR 3.1 / FSR 4" below). Installed there under the name steamarm-ffx,
# the same script does only that, for SteamARM's x86 Steam client, whose game
# environment is Steam's own (scripts/run-steam.sh) and has no per-game step
# of SteamARM's: a game's launch options there read
#
#   /opt/steamarm/wine/steamarm-ffx %command%
#
# and it sets the same environment (or none) and execs the command.
#
# STEAMARM_FEX_PROTON_DRYRUN=1 prints the checks and the command instead of
# running them (tests/launcher/fex_proton_tool.sh).
# STEAMARM_FEX_KEEP_LD_PRELOAD=1 keeps the client's LD_PRELOAD (the Steam
# overlay); by default it is dropped (see the doc).
#
# Exit status: 2 usage, 3 configuration, 4 an x86 component is missing,
# 5 FEXServer is not running, 6 refused (an ARM64 Proton, or not an ARM64
# root); otherwise whatever the chain returns.
set -u

me=${0##*/}
ffx_only=0
case "$me" in
    steamarm-fex-linux) linux=1 ;;
    steamarm-ffx) linux=0 ffx_only=1 ;;
    *) me=steamarm-fex-proton linux=0 ;;
esac
say() { echo "$me: $*" >&2; }
die() { local rc=$1; shift; say "$*"; exit "$rc"; }
here=${BASH_SOURCE[0]%/*}
[ "$here" != "${BASH_SOURCE[0]}" ] || here=.

# ------------------------------------------- FSR 3.1 / FSR 4 -> MetalFX
# SteamARM's FidelityFX API DLLs (tools/ffx-metalfx) are Wine builtins with
# Wine's prefer-native flag, installed in the x86 root (FFX_DIR): Wine takes
# them over a game's amd_fidelityfx_*.dll only where WINEDLLPATH has their
# directory AND the load order says "b,n" (MEASURED, tests/win/run_ffx_load.sh),
# and loads the game's own file otherwise. Both are set here only when
# STEAMARM_WIN_UPSCALER=metalfx (Escalado del juego AUTO on KosmicKrisp) and
# the game shows no anti-cheat -- a replaced module could get an account
# flagged: in the directory of the program Proton runs and its parents up to
# steamapps/common/<game> (and STEAM_COMPAT_INSTALL_PATH) no EasyAntiCheat/,
# EasyAntiCheat_EOS*, BattlEye/, BEService*.exe or start_protected_game.exe
# (any case), and the Steam app id not in anticheat-appids.txt (next to this
# script; tools/ffx-metalfx/ in a checkout). Without the variable nothing at
# all is set or said; when a game is left out, one line says why. Never the
# game's loader DLL (amd_fidelityfx_loader_dx12.dll): it loads the DLLs
# named here. Ours go IN FRONT of WINEDLLOVERRIDES: Wine lets a later entry
# for the same DLL win, so the user's own overrides (and Proton's, which it
# appends) keep the last word. WINEDLLPATH and PRESSURE_VESSEL_FILESYSTEMS_RO
# get the directory appended: Proton puts its own directories first
# (proton: dllpaths), and pressure-vessel shares the directory read-only.
# SteamARM's container sees the x86 root's /opt without the latter (FEX's
# rootfs is the x86 root; MEASURED, a Steam-style container launch), a stock
# pressure-vessel would not.
FFX_DIR=/opt/steamarm/wine
FFX_DLLS=amd_fidelityfx_dx12,amd_fidelityfx_vk,amd_fidelityfx_upscaler_dx12
ffx_list="$here/anticheat-appids.txt"
[ -f "$ffx_list" ] || ffx_list="$here/../ffx-metalfx/anticheat-appids.txt"   # a checkout
ffx_why="" ffx_found="" ffx_dirs=()
ffx_add_dir() {
    local d
    [ -d "$1" ] || return 0
    for d in ${ffx_dirs[@]+"${ffx_dirs[@]}"}; do [ "$d" != "$1" ] || return 0; done
    ffx_dirs+=("$1")
}
ffx_game_dirs() {   # ffx_game_dirs EXE: its directory and the parents up to steamapps/common/<game>
    local p=$1 base rest top
    case "$p" in /*/*) p=${p%/*} ;; *) return 0 ;; esac
    case "$p/" in
        */steamapps/common/?*/*)
            base=${p%%/steamapps/common/*}
            rest=${p#"$base/steamapps/common/"}
            top="$base/steamapps/common/${rest%%/*}"
            while :; do
                ffx_add_dir "$p"
                [ "$p" != "$top" ] && [ "${p%/*}" != "$p" ] || break
                p=${p%/*}
            done ;;
        *) ffx_add_dir "$p" ;;
    esac
}
ffx_anticheat() {   # ffx_anticheat DIR: ffx_found = its anti-cheat's file (nocasematch on)
    local f
    for f in "$1"/*; do
        case "${f##*/}" in
            easyanticheat|battleye) [ -d "$f" ] || continue ;;
            easyanticheat_eos*|beservice*.exe|start_protected_game.exe) ;;
            *) continue ;;
        esac
        ffx_found=$f
        return 0
    done
    return 1
}
ffx_denied() {   # ffx_denied APPID: the app id is in the deny list
    local line
    [ -n "$1" ] && [ -f "$ffx_list" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line//[[:space:]]/}
        [ "$line" != "$1" ] || return 0
    done < "$ffx_list"
    return 1
}
ffx_decide() {   # ffx_decide EXE: ffx_why = why the game is left out, "" if it is not
    local d appid=${STEAM_COMPAT_APP_ID:-${SteamAppId:-${SteamGameId:-}}}
    ffx_why="" ffx_dirs=()
    ffx_game_dirs "$1"
    case "${STEAM_COMPAT_INSTALL_PATH:-}" in /?*) ffx_add_dir "${STEAM_COMPAT_INSTALL_PATH%/}" ;; esac
    shopt -s nocasematch
    for d in ${ffx_dirs[@]+"${ffx_dirs[@]}"}; do
        if ffx_anticheat "$d"; then ffx_why="anti-cheat: $ffx_found"; break; fi
    done
    shopt -u nocasematch
    if [ -z "$ffx_why" ] && ffx_denied "$appid"; then
        ffx_why="app $appid is in $ffx_list"
    fi
}
ffx_apply() {   # ffx_apply DIR: Wine takes the DLLs in DIR (a path in the x86 root)
    case ":${WINEDLLPATH:-}:" in *":$1:"*) ;; *) export WINEDLLPATH="${WINEDLLPATH:+$WINEDLLPATH:}$1" ;; esac
    case "${WINEDLLOVERRIDES:-}" in
        "$FFX_DLLS=b,n"|"$FFX_DLLS=b,n;"*) ;;
        *) export WINEDLLOVERRIDES="$FFX_DLLS=b,n${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}" ;;
    esac
    case ":${PRESSURE_VESSEL_FILESYSTEMS_RO:-}:" in
        *":$1:"*) ;;
        *) export PRESSURE_VESSEL_FILESYSTEMS_RO="${PRESSURE_VESSEL_FILESYSTEMS_RO:+$PRESSURE_VESSEL_FILESYSTEMS_RO:}$1" ;;
    esac
}
ffx_say() {   # the one line, either way
    if [ -z "$ffx_why" ]; then
        say "FSR 3.1/4 -> MetalFX: SteamARM's FidelityFX DLLs from $1 ($FFX_DLLS=b,n)"
    else
        say "FSR 3.1/4 -> MetalFX off for this game ($ffx_why): its own FidelityFX DLLs load untouched"
    fi
}
show_ffx_env() {   # for the dry run
    local v
    for v in WINEDLLPATH WINEDLLOVERRIDES PRESSURE_VESSEL_FILESYSTEMS_RO; do
        [ -z "${!v+x}" ] || echo "env: $v=${!v}"
    done
}

# steamarm-ffx: the x86 client's launch-option wrapper, run in the x86 root
# from this script's copy in FFX_DIR (scripts/install-ffx-metalfx.sh). The
# game is the program after Proton's verb in Steam's command
# (.../proton waitforexitandrun <game.exe>), else its first *.exe.
if [ "$ffx_only" = 1 ]; then
    case "${1:-}" in
        ''|-h|--help) die 2 "usage: $me <command...>  (a game's launch options in SteamARM's x86 Steam client: $FFX_DIR/$me %command%)" ;;
    esac
    if [ "${STEAMARM_WIN_UPSCALER:-}" = metalfx ]; then
        exe="" p1="" p2=""
        for a in "$@"; do
            case "$p2" in */proton) exe=$a; break ;; esac
            p2=$p1 p1=$a
        done
        if [ -z "$exe" ]; then
            for a in "$@"; do case "$a" in *.[eE][xX][eE]) exe=$a; break ;; esac; done
        fi
        dir=$(cd "$here" && pwd -P) || die 3 "cannot resolve $here"
        ffx_decide "$exe"
        if [ -z "$ffx_why" ]; then
            for n in ${FFX_DLLS//,/ }; do
                [ -f "$dir/x86_64-windows/$n.dll" ] || { ffx_why="no $dir/x86_64-windows/$n.dll (scripts/install-ffx-metalfx.sh)"; break; }
            done
        fi
        [ -n "$ffx_why" ] || ffx_apply "$dir"
        ffx_say "$dir"
    fi
    if [ "${STEAMARM_FEX_PROTON_DRYRUN:-}" = 1 ]; then
        show_ffx_env
        printf 'exec:'; printf ' [%s]' "$@"; echo
        exit 0
    fi
    exec "$@"
fi

case "${1:-}" in
    ''|-h|--help) die 2 "usage: $me <verb> [command...]  (run by Steam: toolmanifest.vdf \"%verb%\")" ;;
esac
verb=$1; shift
case "$verb" in
    *[!a-z_]*) die 2 "refusing verb '$verb' (Steam's verbs are lower-case words)" ;;
esac

# --------------------------------------------------------------- settings
X86_ROOT=/tmp/lxrt-steamroot
X86_HOME=/tmp/fexhome
X86_STEAM=/tmp/fexhome/.local/share/Steam
PROTON="Proton - Experimental"
RUNTIME=SteamLinuxRuntime_4
[ "$linux" = 0 ] || { PROTON=""; RUNTIME=SteamLinuxRuntime_sniper; }
FEXDIR=/tmp/lxrt-root/usr/bin
FEXBIN=FEX-gb
conf="$here/$me.conf"
if [ -f "$conf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key=${line%%=*} value=${line#*=}
        [ "$key" != "$line" ] || die 3 "$conf: not KEY=VALUE: $line"
        case "$key" in
            X86_ROOT|X86_HOME|X86_STEAM|PROTON|RUNTIME|FEXDIR|FEXBIN) eval "$key=\$value" ;;
            *) die 3 "$conf: unknown key $key" ;;
        esac
    done < "$conf"
fi
for p in "$X86_ROOT" "$X86_HOME" "$X86_STEAM" "$FEXDIR"; do
    case "$p" in /*) ;; *) die 3 "$conf: '$p' is not an absolute path" ;; esac
done
case "$PROTON$RUNTIME$FEXBIN" in */*) die 3 "$conf: PROTON, RUNTIME and FEXBIN are names, not paths" ;; esac
case "$PROTON" in *ARM64*|*arm64*) die 6 "refusing $PROTON: Proton ARM64 cannot run on macOS (benchmarks/stage18)" ;; esac
[ "$linux" = 1 ] || [ -n "$PROTON" ] || die 3 "$conf: PROTON is empty"

# ------------------------------------------ where this ARM64 root lives
# The runtime hands every guest its root (LXRT_ROOT) in the environment.
arm_root=${LXRT_ROOT:-}
case "$arm_root" in
    /*) ;;
    *) die 6 "LXRT_ROOT is not set: $me runs inside SteamARM's runtime (lxrun), in an ARM64 root" ;;
esac
[ "${arm_root%/}" != "${X86_ROOT%/}" ] || die 6 "called from the x86 root itself ($arm_root): this tool is for the ARM64 client"
if [ -n "${LXRT_MOUNTS:-}" ]; then
    # A bwrap sandbox on the ARM64 side: its binds are not carried over.
    say "note: ignoring this process's own bind table (LXRT_MOUNTS)"
fi

# ------------------------------------------------ the client's paths
# Guest paths of the ARM64 client that must mean the same thing in the x86
# root: bound to <ARM64 root><path>. A path under one already bound is
# covered by it. System paths and the x86 side's own home are never bound:
# they would hide the x86 root's /usr, /tmp, FEX's config...
binds=()
mounts=""
RS=$'\x1e' US=$'\x1f'
show_table() { local t=${1//$RS/|}; echo "${t//$US/;}"; }   # for the dry run
add_bind() {   # add_bind WHY PATH
    local why=$1 p=$2 b
    case "$p" in /*) ;; *) return 0 ;; esac
    while [ "$p" != / ] && [ "${p%/}" != "$p" ]; do p=${p%/}; done
    case "/$p/" in */../*|*/./*) say "not binding $why '$p': not a plain path"; return 0 ;; esac
    case "$p" in
        /|/tmp|/usr|/usr/*|/lib|/lib/*|/lib64|/lib64/*|/lib32|/lib32/*|/bin|/bin/*|/sbin|/sbin/*|\
        /etc|/etc/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/var|/var/*|/opt|/home|/root)
            say "not binding $why '$p': a system path of the x86 root"; return 0 ;;
    esac
    case "$p/" in "${X86_HOME%/}/"*|"${X86_ROOT%/}/"*) say "not binding $why '$p': the x86 side's own"; return 0 ;; esac
    case "${X86_HOME%/}/" in "$p/"*) say "not binding $why '$p': it holds the x86 home"; return 0 ;; esac
    for b in ${binds[@]+"${binds[@]}"}; do
        case "$p/" in "$b/"*) return 0 ;; esac
    done
    binds+=("$p")
    mounts="$mounts$p$RS${arm_root%/}$p${RS}0$US"
}
add_bind HOME "${HOME:-}"
add_bind STEAM_COMPAT_CLIENT_INSTALL_PATH "${STEAM_COMPAT_CLIENT_INSTALL_PATH:-}"
IFS=: read -r -a libs <<< "${STEAM_COMPAT_LIBRARY_PATHS:-}"
for l in ${libs[@]+"${libs[@]}"}; do add_bind STEAM_COMPAT_LIBRARY_PATHS "$l"; done
add_bind STEAM_COMPAT_INSTALL_PATH "${STEAM_COMPAT_INSTALL_PATH:-}"
add_bind STEAM_COMPAT_DATA_PATH "${STEAM_COMPAT_DATA_PATH:-}"
add_bind STEAM_COMPAT_SHADER_PATH "${STEAM_COMPAT_SHADER_PATH:-}"
add_bind "the working directory" "$PWD"

# ------------------------------------------------ the x86 world
proton_dir="$X86_STEAM/steamapps/common/$PROTON"
slr_dir="$X86_STEAM/steamapps/common/$RUNTIME"
uid=$(id -u 2>/dev/null) || uid=""
x86=/run/steamarm-x86 fex=/run/steamarm-fex sock=/run/steamarm-fexserver
check_mounts="$x86$RS${X86_ROOT}${RS}1$US$fex$RS${FEXDIR}${RS}1$US$sock$RS/tmp/lxrt-abstract-$uid${RS}1$US"
# The ARM64 root cannot see those host directories; a child can, through a
# bind table of its own (runtime/mounts.c reads LXRT_MOUNTS at start-up).
check_script='
m=""
if [ -n "$7" ]; then
[ -f "$1$3/proton" ]             || m="$m proton:$3"
[ -f "$1$3/files/bin/wine" ]     || m="$m wine:$3/files/bin/wine"
[ ! -d "$1$3/files/bin-arm64" ]  || m="$m arm64:$3"
fi
[ -f "$1$4/_v2-entry-point" ]    || m="$m runtime:$4"
[ -f "$2/$5" ]                   || m="$m fex:$5"
[ -S "$6" ]                      || m="$m fexserver"
if [ -n "$8" ]; then
for n in amd_fidelityfx_dx12 amd_fidelityfx_vk amd_fidelityfx_upscaler_dx12; do
[ -f "$1$8/x86_64-windows/$n.dll" ] || { m="$m noffx"; break; }
done
fi
echo "missing:$m"'
# FSR 3.1 / FSR 4 (above): decided for a Windows game; its DLLs are checked
# with the rest of the x86 side.
ffx_check=""
if [ "$linux" = 0 ] && [ "${STEAMARM_WIN_UPSCALER:-}" = metalfx ]; then
    ffx_decide "${1:-}"
    [ -n "$ffx_why" ] || ffx_check=$FFX_DIR
fi
if [ "${STEAMARM_FEX_PROTON_DRYRUN:-}" = 1 ]; then
    echo "check: LXRT_MOUNTS=$(show_table "$check_mounts") [x86 root $X86_ROOT: $proton_dir/proton, $slr_dir/_v2-entry-point; $FEXDIR/$FEXBIN; FEXServer socket /tmp/lxrt-abstract-$uid/$uid.FEXServer.Socket${ffx_check:+; FidelityFX DLLs $ffx_check/x86_64-windows}]"
    missing=""
else
    out=$(LXRT_MOUNTS="$check_mounts" /bin/bash -c "$check_script" check "$x86" "$fex" \
          "$proton_dir" "$slr_dir" "$FEXBIN" "$sock/$uid.FEXServer.Socket" "$PROTON" "$ffx_check" 2>/dev/null)
    case "$out" in missing:*) missing=${out#missing:} ;; *) die 4 "could not check the x86 side (output: '$out')" ;; esac
fi
for m in $missing; do
    case "$m" in
        proton:*|wine:*) die 4 "x86 $PROTON is not installed in the x86 Steam root ($X86_ROOT: ${m#*:}); install it from the x86 Steam client's library" ;;
        arm64:*) die 6 "$PROTON in the x86 root is an ARM64 build: Proton ARM64 cannot run on macOS (benchmarks/stage18)" ;;
        runtime:*) die 4 "$RUNTIME is not installed in the x86 Steam root ($X86_ROOT: ${m#*:}); ${PROTON:-a native Linux game} requires it" ;;
        fex:*) die 4 "no FEX at $FEXDIR/$FEXBIN (scripts/setup.sh builds it)" ;;
        noffx) ffx_why="SteamARM's FidelityFX DLLs are not in the x86 root ($X86_ROOT$FFX_DIR: scripts/install-ffx-metalfx.sh)" ;;
        fexserver) die 5 "FEXServer is not running (no /tmp/lxrt-abstract-$uid/$uid.FEXServer.Socket): start SteamARM's x86 side first (scripts/run-fex.sh /bin/true, or the launcher's Steam entry). Not starting one from here: a FEXServer started with a game's environment serves the wrong x86 root to every later FEX program (scripts/run-fex.sh)" ;;
    esac
done

# ------------------------------------------------ the environment
# The launcher's Processor (FEX) settings: scripts/run-app.sh hands them to
# an ARM64 client as STEAMARM_FEXOPT_* (FEX_* would mean nothing to it);
# they are FEX's again here, below the boundary. Set first, so that what
# this tool needs (FEX_ROOTFS, FEX_GUESTBASE...) wins.
fexopts=()
for v in $(compgen -e); do
    case "$v" in STEAMARM_FEXOPT_*) export "FEX_${v#STEAMARM_FEXOPT_}=${!v}"; unset "$v"; fexopts+=("FEX_${v#STEAMARM_FEXOPT_}") ;; esac
done
# What scripts/run-fex.sh gives a Steam-root program, plus the binds.
export LXRT_ROOT="$X86_ROOT" LXRT_MOUNTS="$mounts"
export FEX_ROOTFS=/ TMPDIR=/tmp
if [ "$linux" = 1 ]; then
    # HOME stays the client's (bound above); FEX's own files are the x86 home's.
    export FEX_APP_CONFIG_LOCATION="$X86_HOME/.fex-emu/" FEX_APP_DATA_LOCATION="$X86_HOME/.fex-emu/"
    # A fullscreen SDL window that starts without the focus minimizes itself,
    # and the game then draws ten frames a second for nobody (Counter-Strike
    # 2: iconic, 100 ms in SDL_WaitEventTimeout per frame; MEASURED,
    # benchmarks/stage51). It stays mapped.
    export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS="${SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS:-0}"
else
    export HOME="$X86_HOME"
fi
# The render scale (scripts/settings-env.py, launcher "Escala de render"):
# for the game only, not for Steam's own windows; the Vulkan shim applies it
# to a game window that covers the screen and enlarges the picture with the
# scaling filter (MetalFX where the driver can; shim/wsi.c render_scale).
# MetalFX temporal at the native size (antialiasing, scale 100 %): for the
# game's window only, as the render scale (Steam's windows stay untouched).
if [ -n "${STEAMARM_MFX_NATIVE:-}" ] && [ -z "${LXRT_VK_SCALER_NATIVE:-}" ]; then
    export LXRT_VK_SCALER_NATIVE="$STEAMARM_MFX_NATIVE"
fi
if [ -n "${STEAMARM_RENDER_SCALE:-}" ] && [ -z "${LXRT_VK_RENDER_SCALE:-}" ]; then
    export LXRT_VK_RENDER_SCALE="$STEAMARM_RENDER_SCALE"
fi
# The frame limit, anisotropic filtering and the Metal HUD: for the game, not
# for Steam's windows (scripts/run-app.sh hands them to the client under
# these names).
if [ -n "${STEAMARM_VK_FPS_LIMIT:-}" ] && [ -z "${LXRT_VK_FPS_LIMIT:-}" ]; then
    export LXRT_VK_FPS_LIMIT="$STEAMARM_VK_FPS_LIMIT"
fi
if [ -n "${STEAMARM_VK_ANISOTROPY:-}" ] && [ -z "${LXRT_VK_ANISOTROPY:-}" ]; then
    export LXRT_VK_ANISOTROPY="$STEAMARM_VK_ANISOTROPY"
fi
if [ "${STEAMARM_METAL_HUD:-}" = 1 ]; then
    export MTL_HUD_ENABLED=1
fi
# Xalia, Proton's gamepad navigation of launchers (a Steam Deck feature),
# stayed at 100 % CPU under the runtime and kept sessions alive after the game
# (docs/FEX_GAME_BOUNDARY.md); it held wineserver busy for the game too.
# PROTON_USE_XALIA=1 in the game's launch options turns it back on.
export PROTON_USE_XALIA="${PROTON_USE_XALIA:-0}"
# Direct3D 12 at feature level 12_0: KosmicKrisp has no tiled resources of
# tier 2, vkd3d-proton reported 11_1, and games that ask for 12_0 refused to
# start (FINAL FANTASY VII REMAKE). The tiers are still reported as they are.
export VKD3D_FEATURE_LEVEL="${VKD3D_FEATURE_LEVEL:-12_0}"
export FEX_GUESTBASE=1 FEX_SMCCHECKS="${FEX_SMCCHECKS:-mtrack}" FEX_SILENTLOG=0 FEX_OUTPUTLOG=stderr
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DISPLAY="${DISPLAY:-:2}"
# SteamARM's PulseAudio socket lives in the x86 Steam root (scripts/audio.sh).
export PULSE_SERVER="${PULSE_SERVER:-unix:/tmp/pulse/native}"
# The tools of this chain, as the x86 client names them for pressure-vessel.
if [ "$linux" = 1 ]; then export STEAM_COMPAT_TOOL_PATHS="$slr_dir"; else export STEAM_COMPAT_TOOL_PATHS="$proton_dir:$slr_dir"; fi
# The ARM64 client's own settings for itself (4 KiB guest pages, libcef's
# x18 pass, its aarch64 libraries) mean nothing to FEX and x86 programs, and
# an emulator or machine architecture from an arm64 client would send
# pressure-vessel to Valve's FEX instead of SteamARM's.
# The runtime's two are set EMPTY, not unset: at execve the runtime carries
# over every LXRT_* variable the new environment lacks (runtime/process.c,
# for programs that exec with an environment of their own), so an unset one
# came back and FEX started with 4 KiB guest pages: "Couldn't allocate page
# after SBRK." (MEASURED, benchmarks/stage50). Empty reads as unset there.
export LXRT_GUEST_PAGE= LXRT_X18_ALL_TEXT=
unset LD_LIBRARY_PATH STEAM_RUNTIME_LIBRARY_PATH
unset STEAM_COMPAT_EMULATOR PRESSURE_VESSEL_EMULATOR STEAM_COMPAT_MACHINE_ARCHITECTURE STEAM_COMPAT_GRAPHICS_PROVIDER
[ "${STEAMARM_FEX_KEEP_LD_PRELOAD:-}" = 1 ] || unset LD_PRELOAD
# The environment the ARM64 root names for its own guests (the Steam Frame
# root's indirect GLX, scripts/mkframeroot.sh; scripts/guest-env.sh exports
# it for the client) is that root's, not the x86 root's.
root_env=${STEAMARM_FEX_PROTON_ROOT_ENV:-/.lxrt-guest-env}   # a guest path; tests override it
dropped=()
if [ -f "$root_env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        key=${line%%=*}
        case "$key" in ''|'#'*|*[!A-Za-z0-9_]*|[0-9]*) continue ;; esac
        [ "$key" != "$line" ] || continue
        [ -z "${!key+x}" ] || { unset "$key"; dropped+=("$key"); }
    done < "$root_env"
fi
[ -z "${dropped[*]-}" ] || say "not passing on the ARM64 root's own guest environment: ${dropped[*]}"
# FSR 3.1 / FSR 4 -> MetalFX (above), after the drops: what it sets stays.
if [ "$linux" = 0 ] && [ "${STEAMARM_WIN_UPSCALER:-}" = metalfx ]; then
    [ -n "$ffx_why" ] || ffx_apply "$FFX_DIR"
    ffx_say "$FFX_DIR in the x86 root"
fi

first=${1:-}
say "$verb ${first##*/} (app ${SteamAppId:-${STEAM_COMPAT_APP_ID:-?}}) via x86 ${PROTON:+$PROTON + }$RUNTIME under FEX (root $X86_ROOT); client paths bound from $arm_root: ${binds[*]-none}"
if [ "$linux" = 1 ]; then
    cmd=("$FEXDIR/$FEXBIN" /bin/bash "$slr_dir/_v2-entry-point" "--verb=$verb" -- "$@")
else
    cmd=("$FEXDIR/$FEXBIN" /bin/bash "$slr_dir/_v2-entry-point" "--verb=$verb" -- "$proton_dir/proton" "$verb" "$@")
fi
if [ "${STEAMARM_FEX_PROTON_DRYRUN:-}" = 1 ]; then
    for v in LXRT_ROOT FEX_ROOTFS HOME TMPDIR FEX_GUESTBASE DISPLAY PULSE_SERVER STEAM_COMPAT_TOOL_PATHS ${fexopts[@]+"${fexopts[@]}"}; do
        echo "env: $v=${!v}"
    done
    echo "env: LXRT_MOUNTS=$(show_table "$LXRT_MOUNTS")"
    show_ffx_env
    for v in LXRT_GUEST_PAGE LXRT_X18_ALL_TEXT LD_LIBRARY_PATH LD_PRELOAD STEAM_COMPAT_EMULATOR ${dropped[@]+"${dropped[@]}"}; do
        [ -z "${!v:-}" ] || echo "env: $v still set"
    done
    echo "dropped from the ARM64 root's guest environment: ${dropped[*]-none}"
    printf 'exec:'; printf ' [%s]' "${cmd[@]}"; echo
    exit 0
fi
exec "${cmd[@]}"
