; AMD's export table for amd_fidelityfx_dx12.dll (FidelityFX SDK 1.1.x):
; names and ordinals 1-5, as objdump -p shows them in AMD's signed DLL.
LIBRARY amd_fidelityfx_dx12.dll
EXPORTS
    ffxConfigure      @1
    ffxCreateContext  @2
    ffxDestroyContext @3
    ffxDispatch       @4
    ffxQuery          @5
