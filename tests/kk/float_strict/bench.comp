#version 460
#extension GL_EXT_spirv_intrinsics : require
#extension GL_EXT_buffer_reference : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
layout(local_size_x = 256) in;
layout(buffer_reference, std430) writeonly buffer Out { vec4 v[]; };
layout(push_constant) uniform PC { Out res; vec4 k; uint iterations; } pc;

// The arithmetic of a lighting loop: normalisation (rsqrt), dot products,
// a specular pow, clamps, a compare, multiply-adds.
void main()
{
    uint i = gl_GlobalInvocationID.x;
    vec4 a = vec4(float(i & 1023u) * 0.001) + pc.k;
    vec4 acc = vec4(0.0);
    for (uint n = 0u; n < pc.iterations; n++) {
        vec3 l = normalize(a.xyz - vec3(0.5, 0.25, 0.125));
        float ndl = max(dot(l, vec3(0.267, 0.534, 0.801)), 0.0);
        float spec = pow(max(dot(l, a.yzw), 0.0) + 0.001, 16.0);
        acc += vec4(ndl, spec, sqrt(abs(a.x)), a.y < a.z ? 1.0 : 0.0);
        a = fma(a, vec4(0.97), acc * 0.01);
        a = min(max(a, vec4(-4.0)), vec4(4.0));
    }
    pc.res.v[i] = acc;
}
