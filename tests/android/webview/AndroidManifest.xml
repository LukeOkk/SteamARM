<?xml version="1.0" encoding="utf-8"?>
<!-- A WebView in an app, no Google software: tests/android/run.sh builds it
     (Android SDK platform 30, aapt2, d8, apksigner), installs it in the
     session and reads what it logs under the tag WebViewProbe. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.steamarm.webviewprobe" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30" />
    <application android:label="WebView probe">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
